# APKForge local config template (safe defaults; no secrets here).
# ./apkforge generates .env from this on first run (mode 600).
APKFORGE_ENV=local
APKFORGE_PORT=8000
APKFORGE_WEB_PORT=3000
APKFORGE_DATA=data
APKFORGE_CORS=*
# APKFORGE_KEY is generated automatically (>=32 chars, never committed).
# Optional real-tool overrides (else PATH is used):
# APKFORGE_APKTOOL=/opt/apktool/apktool.jar
# APKFORGE_JADX=/opt/jadx/bin/jadx
