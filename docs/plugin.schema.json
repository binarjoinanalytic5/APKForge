{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apkforge.local/schemas/plugin-1.0.0.json",
  "title": "APKForge plugin manifest",
  "type": "object",
  "required": ["name", "version", "sdk_version", "tool", "runtime", "license"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "sdk_version": {
      "const": "1.0.0"
    },
    "description": {"type": "string"},
    "license": {"type": "string", "minLength": 1},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["command", "timeout_s", "memory_mb", "cpu", "network"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600},
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 16384},
        "cpu": {"type": "number", "minimum": 0.1, "maximum": 8.0},
        "network": {"type": "string", "enum": ["none", "loopback", "full"]}
      }
    },
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
