<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ffffefee"
                android:endColor="#00281a0a"
                android:angle="270"
                android:type="linear"
                android:centerY="0.05"
                android:centerColor="#33fff7ee"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ff2e1303"
                android:endColor="#ff1b120c"
                android:angle="270"
                android:type="linear"
                android:centerY="0.2"
                android:centerColor="#ff1b120c"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>
</layer-list>
