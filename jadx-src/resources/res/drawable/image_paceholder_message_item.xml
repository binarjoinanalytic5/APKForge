<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:height="90dp"
                android:width="67dp"/>
            <solid android:color="@color/backgrounds_background_4"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="48dp"
        android:width="48dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/icon_transparent_square_placeholder"/>
    </item>
</layer-list>
