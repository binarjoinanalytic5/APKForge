<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/view_small_level_bg"
            android:visibility="visible"
            android:layout_width="289dp"
            android:layout_height="62dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/iv_image"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/view_small_level_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"/>
        <Constraint
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_promotion_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_image"
            app:layout_constraintRight_toLeftOf="@+id/tv_promotion_action"
            app:layout_constraintTop_toTopOf="@+id/iv_image"/>
        <Constraint
            android:id="@+id/tv_promotion_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="@+id/tv_promotion_title"
            app:layout_constraintRight_toRightOf="@+id/tv_promotion_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_promotion_title"
            app:setAnimDuration="1000"
            app:setDirection="bottom_to_top"
            app:setGravity="left"
            app:setInterval="1000"
            app:setMaxLine="2"
            app:setTextColor="@color/color_e7e7e7"
            app:setTextSize="12sp"/>
        <Constraint
            android:id="@+id/action_bg1"
            android:layout_width="85dp"
            android:layout_height="34dp"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_small_level_bg"
            app:layout_constraintRight_toRightOf="@+id/view_small_level_bg"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"/>
        <Constraint
            android:id="@+id/action_bg2"
            android:layout_width="85dp"
            android:layout_height="34dp"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_small_level_bg"
            app:layout_constraintRight_toRightOf="@+id/view_small_level_bg"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"/>
        <Constraint
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_promotion_action"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="85dp"
            android:layout_height="34dp"
            android:layout_marginRight="8dp"
            android:text="Hol&apos;s dir"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_small_level_bg"
            app:layout_constraintRight_toRightOf="@+id/view_small_level_bg"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"/>
        <Constraint
            android:id="@+id/iv_promotion_pop1_close"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_promotion_close_icon_layer"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/view_small_level_bg"
            android:layout_width="262dp"
            android:layout_height="136dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <Constraint
            android:id="@+id/iv_image"
            android:layout_width="77dp"
            android:layout_height="77dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"/>
        <Constraint
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_promotion_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:maxLines="2"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_image"
            app:layout_constraintRight_toLeftOf="@+id/iv_promotion_pop1_close"
            app:layout_constraintTop_toTopOf="@+id/iv_image"/>
        <Constraint
            android:id="@+id/tv_promotion_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:layout_constraintLeft_toLeftOf="@+id/tv_promotion_title"
            app:layout_constraintRight_toRightOf="@+id/tv_promotion_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_promotion_title"
            app:setAnimDuration="1000"
            app:setDirection="bottom_to_top"
            app:setGravity="left"
            app:setInterval="1000"
            app:setMaxLine="3"
            app:setTextColor="@color/color_e7e7e7"
            app:setTextSize="12sp"/>
        <Constraint
            android:id="@+id/action_bg1"
            android:layout_width="246dp"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="9dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_image"/>
        <Constraint
            android:id="@+id/action_bg2"
            android:layout_width="246dp"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="9dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_image"/>
        <Constraint
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_promotion_action"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="246dp"
            android:layout_height="34dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="9dp"
            android:text="Hol&apos;s dir"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_image"/>
        <Constraint
            android:id="@+id/iv_promotion_pop1_close"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_promotion_close_icon_layer"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"/>
    </ConstraintSet>
    <Transition
        app:constraintSetEnd="@+id/end"
        app:constraintSetStart="@+id/start"
        app:duration="300"/>
</MotionScene>
