<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout-land/dialog_recharge_method_v2_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end"
        android:id="@+id/recharge_panel"
        android:background="@color/backgrounds_background_2"
        android:layout_width="375dp"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_payment_protection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/icon_payment_protection_12"/>
            <TextView
                android:textColor="@color/green_green_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_protection"
                android:layout_marginStart="4dp"
                style="@style/footnote_regular"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_right_green_16"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/icon_close_gray_bg"
            android:scaleType="center"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/texticon_primary"
            android:gravity="center"
            android:id="@+id/tv_select_method"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/select_payment_method"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/nsv_pay_method"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_payment_protection"
            style="@style/title3_bold"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_pay_method"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="false"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@+id/btn_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_select_method">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_order_detail_iap"
                    android:background="@drawable/bg_background3_corner4"
                    android:padding="16dp"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ll_iap_coins"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_price"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/iv_coin"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_coins_24"
                            android:scaleType="center"/>
                        <TextView
                            android:textColor="@color/texticon_primary"
                            android:id="@+id/tv_coins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            style="@style/body_regular"/>
                        <TextView
                            android:textColor="@color/texticon_tertiary"
                            android:id="@+id/tv_plus_sign"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:layout_marginStart="4dp"
                            style="@style/body_bold"/>
                        <ImageView
                            android:id="@+id/iv_bonus"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_bonus_16"
                            android:layout_marginStart="4dp"/>
                        <TextView
                            android:textColor="@color/texticon_primary"
                            android:id="@+id/tv_bonus"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            style="@style/body_regular"/>
                    </LinearLayout>
                    <TextView
                        android:textColor="@color/texticon_primary"
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/body_bold"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_order_detail_sub"
                    android:background="@drawable/bg_background3_corner4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_detail_sub"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/iv_vip_coin"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icon_vip_crown"
                            android:scaleType="center"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textColor="@color/texticon_primary"
                            android:id="@+id/tv_vip_type"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Weekly VIP"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tv_vip_price"
                            app:layout_constraintStart_toEndOf="@+id/iv_vip_coin"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/body_regular"/>
                        <TextView
                            android:textColor="@color/texticon_primary"
                            android:id="@+id/tv_vip_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toTopOf="@+id/tv_vip_original_price"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/iv_vip_coin"
                            app:layout_constraintVertical_chainStyle="packed"
                            style="@style/body_bold"/>
                        <com.newleaf.app.android.victor.view.ObliqueLineTextView
                            android:textColor="@color/texticon_tertiary"
                            android:id="@+id/tv_vip_original_price"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_vip_coin"
                            app:layout_constraintEnd_toEndOf="@+id/tv_vip_price"
                            app:layout_constraintTop_toBottomOf="@+id/tv_vip_price"
                            app:lineStyle="styleHorizontalCenter"
                            style="@style/caption_regular"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:id="@+id/view_line"
                        android:background="@color/line_divider"
                        android:layout_width="0dp"
                        android:layout_height="0.5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cl_detail_sub"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/texticon_tertiary"
                        android:id="@+id/tv_vip_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:maxLines="3"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view_line"
                        style="@style/footnote_regular"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/group_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="cl_order_detail_iap,cl_order_detail_sub"/>
                <TextView
                    android:textColor="@color/texticon_tertiary"
                    android:id="@+id/tv_pay_method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/choose_payment_method"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/group_divider"
                    style="@style/footnote_regular"/>
                <com.newleaf.app.android.victor.view.MaxHeightRecyclerView
                    android:id="@+id/rv_pay_method"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:nestedScrollingEnabled="false"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_pay_method"/>
                <TextView
                    android:textColor="@color/texticon_tertiary"
                    android:id="@+id/tv_show_more"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/more_pay_method"
                    android:drawablePadding="4dp"
                    android:drawableEnd="@drawable/icon_arrow_down_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rv_pay_method"
                    style="@style/footnote_regular"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/btn_bar"
            android:background="@color/backgrounds_background_2"
            android:layout_width="match_parent"
            android:layout_height="64.5dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <View
                android:background="@color/line_outline"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_pay_button"
                android:background="@drawable/bg_e52e2e_corner_4"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_continue_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textColor="@color/texticon_primary"
                        android:id="@+id/tv_continue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/body_bold"/>
                    <ImageView
                        android:id="@+id/iv_continue_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_pay_card_20"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
