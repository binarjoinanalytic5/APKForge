<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout-land/dialog_choose_pay_method_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/bg_backgrounds_background_2_r16"
        android:layout_width="375dp"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_select_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/select_payment_method"
                android:layout_marginStart="16dp"
                style="@style/title3_bold"/>
            <ImageView
                android:id="@+id/iv_close"
                android:background="@drawable/icon_close_gray_bg"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="375dp"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_order_detail_iap"
                    android:background="@drawable/bg_background3_corner4"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_select_method">
                    <ImageView
                        android:id="@+id/iv_coin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/icon_coins_24"
                        android:scaleType="center"
                        android:layout_marginStart="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="@color/texticon_tertiary"
                        android:id="@+id/tv_coins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_coin"
                        app:layout_constraintStart_toEndOf="@+id/iv_coin"
                        app:layout_constraintTop_toTopOf="@+id/iv_coin"
                        style="@style/body_regular"/>
                    <TextView
                        android:textColor="@color/texticon_tertiary"
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/body_regular"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_order_detail_sub"
                    android:background="@drawable/bg_background3_corner4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:id="@+id/iv_vip_coin"
                        android:background="@drawable/bg_tag_quaternary_normal_4r"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/icon_vip_crown"
                        android:scaleType="center"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="@color/texticon_tertiary"
                        android:id="@+id/tv_vip_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_vip_coin"
                        app:layout_constraintStart_toEndOf="@+id/iv_vip_coin"
                        app:layout_constraintTop_toTopOf="@+id/iv_vip_coin"
                        style="@style/body_regular"/>
                    <TextView
                        android:textColor="@color/texticon_tertiary"
                        android:id="@+id/tv_vip_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_vip_original_price"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/body_regular"/>
                    <com.newleaf.app.android.victor.view.ObliqueLineTextView
                        android:textColor="@color/texticon_tertiary"
                        android:id="@+id/tv_vip_original_price"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:layout_marginStart="2dp"
                        app:layout_constraintBottom_toBottomOf="@+id/view_barrier"
                        app:layout_constraintEnd_toEndOf="@+id/tv_vip_price"
                        app:layout_constraintTop_toBottomOf="@+id/tv_vip_price"
                        app:lineStyle="styleHorizontalCenter"
                        style="@style/caption_regular"/>
                    <View
                        android:id="@+id/view_line"
                        android:background="@color/line_divider"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_margin="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_vip_coin"/>
                    <View
                        android:id="@+id/view_barrier"
                        android:layout_width="wrap_content"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_vip_coin"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/texticon_tertiary"
                        android:id="@+id/tv_vip_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:maxLines="3"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:autoSizeMaxTextSize="12sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view_line"
                        style="@style/footnote_regular"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textColor="@color/texticon_tertiary"
                    android:id="@+id/tv_pay_method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/choose_payment_method"
                    android:layout_marginStart="16dp"
                    style="@style/footnote_regular"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_pay_method"
                    android:background="@drawable/bg_background3_corner4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:nestedScrollingEnabled="false"/>
                <TextView
                    android:textColor="@color/texticon_secondary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_show_more"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/more_pay_method"
                    android:drawablePadding="4dp"
                    android:drawableEnd="@drawable/icon_arrow_down_16"
                    style="@style/footnote_medium"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
