<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout-land/player_charge_new_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end"
        android:id="@+id/cl_unlock_layout"
        android:background="@color/color_141414_alpha_95"
        android:layout_width="375dp"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_title,img_subtitle_icon,tv_subtitle"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_white90"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/price"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.95"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/img_subtitle_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_coins_16"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title"
                app:layout_constraintStart_toEndOf="@+id/tv_title"
                app:layout_constraintTop_toTopOf="@+id/tv_title"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_white90"
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.95"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_subtitle_icon"
                app:layout_constraintStart_toEndOf="@+id/img_subtitle_icon"
                app:layout_constraintTop_toTopOf="@+id/img_subtitle_icon"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_paywall"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_paywall_title,img_paywall_subtitle_icon,             tv_paywall_subtitle,line,balance_group"/>
            <TextView
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_paywall_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/price"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/footnote_regular"/>
            <ImageView
                android:id="@+id/img_paywall_subtitle_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/icon_coins_16"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_paywall_title"
                app:layout_constraintStart_toEndOf="@+id/tv_paywall_title"
                app:layout_constraintTop_toTopOf="@+id/tv_paywall_title"/>
            <TextView
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_paywall_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_paywall_subtitle_icon"
                app:layout_constraintStart_toEndOf="@+id/img_paywall_subtitle_icon"
                app:layout_constraintTop_toTopOf="@+id/img_paywall_subtitle_icon"
                style="@style/footnote_regular"/>
            <View
                android:id="@+id/line"
                android:background="@drawable/bg_ffffff_a15_corner_4"
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_paywall_subtitle_icon"
                app:layout_constraintStart_toEndOf="@+id/tv_paywall_subtitle"
                app:layout_constraintTop_toTopOf="@+id/img_paywall_subtitle_icon"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/balance_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_paywall_title"
                app:layout_constraintStart_toEndOf="@+id/line"
                app:layout_constraintTop_toTopOf="@+id/tv_paywall_title">
                <TextView
                    android:textColor="@color/texticon_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_balance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/balance_text_"
                    android:maxLines="1"
                    style="@style/footnote_regular"/>
                <ImageView
                    android:id="@+id/iv_balance_coins_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/icon_coins_16"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textColor="@color/texticon_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_balance_coins_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="2dp"
                    app:layout_goneMarginEnd="16dp"
                    style="@style/footnote_regular"/>
                <ImageView
                    android:id="@+id/iv_balance_bonus_icon"
                    android:visibility="gone"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/icon_bonus_12"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textColor="@color/texticon_primary"
                    android:ellipsize="end"
                    android:id="@+id/tv_balance_bonus_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="2dp"
                    style="@style/footnote_regular"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/explain_layout_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="iv_explain_coins_icon,tv_explain_coins_text,                 tv_explain_equal,iv_explain_bonus_icon,tv_explain_bonus_text"/>
            <ImageView
                android:id="@+id/iv_explain_coins_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/icon_coins_16"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_explain_coins_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_explain_coins_text"/>
            <TextView
                android:textColor="@color/texticon_tertiary"
                android:ellipsize="end"
                android:id="@+id/tv_explain_coins_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:layout_marginStart="2dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toEndOf="@+id/iv_explain_coins_icon"
                app:layout_constraintTop_toBottomOf="@+id/tv_paywall_title"
                app:layout_goneMarginStart="16dp"
                style="@style/caption_regular"/>
            <TextView
                android:textColor="@color/texticon_tertiary"
                android:ellipsize="end"
                android:id="@+id/tv_explain_equal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="="
                android:maxLines="1"
                android:layout_marginStart="2dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/tv_explain_coins_text"
                app:layout_constraintStart_toEndOf="@+id/tv_explain_coins_text"
                app:layout_constraintTop_toTopOf="@+id/tv_explain_coins_text"
                style="@style/caption_regular"/>
            <ImageView
                android:id="@+id/iv_explain_bonus_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/icon_bonus_12"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_explain_coins_text"
                app:layout_constraintStart_toEndOf="@+id/tv_explain_equal"
                app:layout_constraintTop_toTopOf="@+id/tv_explain_coins_text"/>
            <TextView
                android:textColor="@color/texticon_tertiary"
                android:ellipsize="end"
                android:id="@+id/tv_explain_bonus_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="2dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/tv_explain_coins_text"
                app:layout_constraintStart_toEndOf="@+id/iv_explain_bonus_icon"
                app:layout_constraintTop_toTopOf="@+id/tv_explain_coins_text"
                style="@style/caption_regular"/>
            <ImageView
                android:id="@+id/iv_close"
                android:paddingLeft="8dp"
                android:paddingTop="8dp"
                android:paddingRight="8dp"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/icon_close_gray_bg"
                android:contentDescription="@string/close"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.newleaf.app.android.victor.view.MaxHeightRecyclerView
            android:id="@+id/rlv_coin"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
        <com.newleaf.app.android.victor.view.LoadFailView
            android:id="@+id/failView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="312dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
