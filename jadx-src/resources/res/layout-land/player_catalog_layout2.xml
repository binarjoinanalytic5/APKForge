<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout-land/player_catalog_layout2_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end"
        android:id="@+id/container_layout"
        android:tag="binding_1"
        android:background="@color/backgrounds_background_2"
        android:paddingTop="16dp"
        android:clipChildren="false"
        android:layout_width="306dp"
        android:layout_height="match_parent">
        <include
            android:id="@+id/book_info_layout"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/layout_player_catalog_book_info"/>
        <com.newleaf.app.android.victor.view.XSlidingTabLayout2
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/book_info_layout"
            app:tl_indicator_color="@color/texticon_primary"
            app:tl_indicator_corner_radius="2dp"
            app:tl_indicator_gravity="BOTTOM"
            app:tl_indicator_height="2dp"
            app:tl_indicator_margin_bottom="0dp"
            app:tl_indicator_margin_top="0dp"
            app:tl_indicator_style="NORMAL"
            app:tl_indicator_width="24dp"
            app:tl_tab_gravity="TOP"
            app:tl_tab_padding="12dp"
            app:tl_textBold="BOTH"
            app:tl_textSelectColor="@color/texticon_primary"
            app:tl_textUnselectColor="@color/texticon_tertiary"
            app:tl_text_select_size="14sp"
            app:tl_textsize="14sp"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_close_play_catalog"
            android:contentDescription="@string/description_close"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/v_line_divider"
            android:background="@color/line_divider"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/tab_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_page2"
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
