<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout-land/dialog_subscribe_success_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end"
        android:id="@+id/view_content"
        android:layout_width="375dp"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="top"
            android:id="@+id/iv_top_light_spot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp"
            android:src="@drawable/icon_reward_coins_top_light_spot"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="-48dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@+id/cl_bottom"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/iv_vip_crown"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="12dp"
                    android:src="@drawable/icon_vip_crown_120"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:maxLines="1"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_vip_crown"
                    style="@style/footnote_medium"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/group_reward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="iv_gold_wheat_ears_left,cl_amount,iv_gold_wheat_ears_right"/>
                <ImageView
                    android:id="@+id/iv_gold_wheat_ears_left"
                    android:layout_width="16dp"
                    android:layout_height="30dp"
                    android:src="@drawable/gold_wheat_ears_left"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/cl_amount"
                    app:layout_constraintEnd_toStartOf="@+id/cl_amount"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/cl_amount"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginHorizontal="12dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/iv_gold_wheat_ears_right"
                    app:layout_constraintStart_toEndOf="@+id/iv_gold_wheat_ears_left"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title">
                    <ImageView
                        android:id="@+id/iv_reward_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/icon_coins_24"
                        android:layout_marginEnd="2dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_reward_num"
                        app:layout_constraintEnd_toStartOf="@+id/tv_reward_num"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_reward_num"/>
                    <TextView
                        android:textColor="#ffffebca"
                        android:ellipsize="end"
                        android:id="@+id/tv_reward_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toTopOf="@+id/tv_reward_des"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_reward_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/title2_bold"/>
                    <TextView
                        android:textColor="#b2fae7bf"
                        android:ellipsize="end"
                        android:id="@+id/tv_reward_des"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_reward_num"
                        style="@style/caption_regular"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageView
                    android:id="@+id/iv_gold_wheat_ears_right"
                    android:layout_width="16dp"
                    android:layout_height="30dp"
                    android:src="@drawable/gold_wheat_ears_right"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/cl_amount"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cl_amount"
                    app:layout_constraintTop_toTopOf="@+id/cl_amount"/>
                <ImageView
                    android:id="@+id/iv_vip_interests_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="14.5dp"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/icon_vip_interests_line"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_amount"
                    app:layout_goneMarginTop="20dp"/>
                <com.newleaf.app.android.victor.view.AutoPollRecyclerView
                    android:id="@+id/rlv_interests"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_vip_interests_line"/>
                <androidx.legacy.widget.Space
                    android:id="@+id/space_list_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    app:layout_constraintTop_toBottomOf="@+id/rlv_interests"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/cl_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <View
                android:id="@+id/v_top"
                android:background="@drawable/bg_subscribe_success_bottom_button_cover"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/v_bottom"
                android:background="@drawable/bg_1b100d_left_bottom_corner16"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_top"/>
            <TextView
                android:textColor="#ff3e2a25"
                android:gravity="center"
                android:id="@+id/tv_affirm"
                android:background="@drawable/bg_reward_coins_second_issue"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="16dp"
                android:text="@string/confirm"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/footnote_medium"/>
            <TextView
                android:textColor="#e5ffebca"
                android:gravity="center"
                android:id="@+id/tv_jump"
                android:background="@color/white_white_7"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_affirm"
                style="@style/footnote_medium"/>
            <androidx.legacy.widget.Space
                android:layout_width="match_parent"
                android:layout_height="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_jump"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/iv_close"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_close_play_catalog"
            android:contentDescription="@string/description_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
