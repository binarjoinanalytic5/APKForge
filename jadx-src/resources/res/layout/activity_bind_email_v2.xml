<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/activity_bind_email_v2_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/space"
        layout="@layout/include_statusbar_space"/>
    <View
        android:id="@+id/bg_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_exit"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/icon_return"
        android:contentDescription="@string/description_back"
        android:layout_marginStart="6dp"
        android:paddingVertical="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/bind_email_text"
        android:maxLines="1"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_exit"
        style="@style/largetitle_bold"/>
    <TextView
        android:textColor="@color/texticon_secondary"
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:text="@string/bind_email_sub_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/body_regular"/>
    <TextView
        android:textColor="@color/texticon_secondary"
        android:id="@+id/tv_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="36dp"
        android:layout_marginRight="16dp"
        android:text="@string/email_address_text"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
        style="@style/footnote_regular"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textColor="@color/texticon_primary"
        android:textColorHint="@color/texticon_quaternary"
        android:id="@+id/et_input_email"
        android:background="@drawable/bind_email_edittext_bg_selector"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:hint="@string/enter_email_text"
        android:inputType="textEmailAddress"
        android:textCursorDrawable="@drawable/search_edit_cursor"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="16dp"
        android:importantForAutofill="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_email"
        style="@style/body_regular"/>
    <TextView
        android:textColor="@color/texticon_brand_normal"
        android:id="@+id/tv_email_error_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:text="@string/bind_email_input_valid_email"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_input_email"
        style="@style/footnote_regular"/>
    <TextView
        android:enabled="false"
        android:textColor="@drawable/email_code_button_text_selector"
        android:gravity="center"
        android:id="@+id/tv_sign_up_action"
        android:background="@drawable/email_code_button_bg_selector"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="16dp"
        android:text="@string/next"
        android:contentDescription="@string/next"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_input_email"
        style="@style/title3_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
