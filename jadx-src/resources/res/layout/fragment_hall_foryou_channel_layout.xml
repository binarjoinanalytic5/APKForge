<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_hall_foryou_channel_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/title_view"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_page2"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <com.newleaf.app.android.victor.view.XSlidingTabLayout2
        android:id="@+id/tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/table"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/table"
        app:tl_indicator_color="@color/color_white"
        app:tl_indicator_corner_radius="2dp"
        app:tl_indicator_gravity="BOTTOM"
        app:tl_indicator_height="2dp"
        app:tl_indicator_margin_left="20dp"
        app:tl_indicator_margin_right="20dp"
        app:tl_indicator_style="NORMAL"
        app:tl_tab_padding="16sp"
        app:tl_textSelectColor="@color/color_ffffff_alpha_90"
        app:tl_textUnselectColor="@color/color_ffffff_alpha_50"
        app:tl_text_select_size="16sp"
        app:tl_textsize="16sp"/>
    <View
        android:id="@+id/table"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_view"/>
    <ImageView
        android:id="@+id/iv_search"
        android:padding="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/icon_foryou_search"
        android:contentDescription="@string/search_hint"
        android:layout_marginEnd="-4dp"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/table"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/table"
        app:layout_goneMarginEnd="0dp"/>
    <com.newleaf.app.android.victor.hall.foryou.view.ContinueWatchCardView
        android:id="@+id/v_continue_watch"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:elevation="2dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/title_view"/>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:tag="binding_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
