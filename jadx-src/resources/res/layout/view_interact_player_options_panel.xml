<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:id="@+id/tv_title"
        android:tag="layout/view_interact_player_options_panel_0"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:shadowColor="@color/color_black40"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="2"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/recycle_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycle_view"
        android:tag="layout/view_interact_player_options_panel_1"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="114dp"
        android:overScrollMode="never"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_option_card_view"
        android:tag="layout/view_interact_player_options_panel_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/recycle_view">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remaining_cards"
            app:layout_constraintEnd_toStartOf="@+id/iv_icon_card"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_icon_card"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_interact_potion_card"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_desc"
            app:layout_constraintEnd_toStartOf="@+id/tv_card_num"
            app:layout_constraintStart_toEndOf="@+id/tv_desc"
            app:layout_constraintTop_toTopOf="@+id/tv_desc"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_card_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_card"
            app:layout_constraintTop_toTopOf="@+id/tv_desc"
            style="@style/body_medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/guidelines"
        android:tag="layout/view_interact_player_options_panel_3"
        android:background="@color/color_black70"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="3dp">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/guidelines_lottile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="interact_player_guidelines.json"
                app:lottie_loop="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/interact_touch_to_continue"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/guidelines_option"
        android:tag="layout/view_interact_player_options_panel_4"
        android:background="@color/color_black70"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="1dp">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/img_close_guidelines"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/interact_guide_close_icon"
            android:contentDescription="@string/description_close"
            android:layout_marginEnd="18dp"/>
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/tv_options_guidelines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="266dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"/>
    </FrameLayout>
</merge>
