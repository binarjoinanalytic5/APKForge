<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/activity_bind_email_code_0"
    android:background="@color/profile_common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/space"
        layout="@layout/include_statusbar_space"/>
    <View
        android:id="@+id/bg_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_exit"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/icon_return"
        android:contentDescription="@string/description_back"
        android:layout_marginStart="6dp"
        android:paddingVertical="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/verification_text"
        android:maxLines="1"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_exit"
        style="@style/largetitle_bold"/>
    <TextView
        android:textColor="@color/texticon_secondary"
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:text="@string/bind_email_code_desc"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/body_regular"/>
    <com.newleaf.app.android.victor.view.VerifyCodeView
        android:id="@+id/input_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"
        app:vcv_borderColorError="@color/texticon_brand_normal"
        app:vcv_borderColorNormal="@color/line_outline"
        app:vcv_borderColorSelected="@color/texticon_primary"
        app:vcv_borderWidth="1dp"
        app:vcv_boxHeight="64dp"
        app:vcv_boxRadius="8dp"
        app:vcv_boxSpace="24dp"
        app:vcv_boxWidth="64dp"
        app:vcv_codeLength="4"
        app:vcv_codeTextColor="@color/texticon_primary"
        app:vcv_codeTextSize="24sp"
        app:vcv_cursorColor="@color/white"
        app:vcv_cursorHeight="24dp"
        app:vcv_cursorWidth="1dp"
        app:vcv_showCursor="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_e52e2e"
        android:id="@+id/tv_code_error_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/email_input_code_err_tips"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="@+id/input_code"
        app:layout_constraintTop_toBottomOf="@+id/input_code"/>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:id="@+id/tv_code_countdown"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_code"
        style="@style/body_regular"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_code_resend"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="@string/bind_email_code_did_not_receive"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_code"
        style="@style/body_regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
