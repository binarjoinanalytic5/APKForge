<?xml version="1.0" encoding="utf-8"?>
<com.newleaf.app.android.victor.view.refresh.VictorRefreshLayoutV4 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout/fragment_discover_filter_ranking_0"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/space"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/include_statusbar_space"/>
        <ImageView
            android:id="@+id/img_bg"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.newleaf.app.android.victor.view.LinearLayoutAtViewPager2
            android:orientation="vertical"
            android:id="@+id/ll_page"
            android:background="@drawable/bg_color_141414_left_top_right_top_r16"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space">
            <com.newleaf.app.android.victor.view.XSlidingTabLayout2
                android:id="@+id/tab_layout"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginLeft="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="1dp"
                android:layout_marginBottom="2dp"
                android:layout_marginHorizontal="1dp"
                app:layout_constrainedWidth="true"
                app:tl_indicator_color="@android:color/transparent"
                app:tl_indicator_corner_radius="4dp"
                app:tl_indicator_gravity="BOTTOM"
                app:tl_indicator_height="28dp"
                app:tl_indicator_style="TRIANGLE"
                app:tl_tab_padding="16sp"
                app:tl_textSelectColor="@color/texticon_primary"
                app:tl_textUnselectColor="@color/texticon_tertiary"
                app:tl_text_select_size="14sp"
                app:tl_textsize="14sp"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"/>
        </com.newleaf.app.android.victor.view.LinearLayoutAtViewPager2>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:load_fail_view_bg_color="@color/black"/>
</com.newleaf.app.android.victor.view.refresh.VictorRefreshLayoutV4>
