<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents.Light"
    android:id="@+id/adjoeNotificationCard"
    android:background="@drawable/shape_notification_shadow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:elevation="4dp"
    app:cardCornerRadius="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/shape_notification_border"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">
        <ImageView
            android:id="@+id/notification_image"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="24dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginVertical="24dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="24dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22sp"
                android:textColor="@color/gray_900"
                android:id="@+id/notification_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="@font/bold"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/gray_900"
                android:id="@+id/notification_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/regular"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/notification_close_container"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginVertical="16dp">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/notification_close_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-4dp"
                app:indicatorColor="@color/white"
                app:indicatorSize="28dp"
                app:theme="@style/Theme.MaterialComponents"
                app:trackColor="@color/gray_500"
                app:trackThickness="2dp"/>
            <ImageView
                android:id="@+id/notification_close"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="9dp"
                android:src="@drawable/notification_close_icon"
                android:backgroundTint="@color/gray_500"
                app:tint="@color/gray_500"/>
        </FrameLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
