<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_vote_entrance_0"
    android:paddingLeft="0.5dp"
    android:paddingTop="0.5dp"
    android:paddingRight="0.5dp"
    android:paddingBottom="0.5dp"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:paddingHorizontal="0.5dp"
    android:paddingVertical="0.5dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_cover"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:src="@drawable/img_vote_enter_logo"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_cover_mask"
            android:background="@drawable/bg_mask_mask_vote_entrance_right_fade"
            android:layout_width="126dp"
            android:layout_height="80dp"
            android:layout_marginStart="41dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_yellow_normal"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="8dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="7sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/ll_vote_group"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/body_medium"/>
    <com.newleaf.app.android.victor.common.vote.VoteCountDownText
        android:textColor="#80ffd8b5"
        android:ellipsize="end"
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="8dp"
        app:autoSizeMaxTextSize="10sp"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll_vote_group"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/caption_regular"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_vote_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_vote_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/icon_vote_no_space"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#ffffd8b5"
                android:id="@+id/tv_vote_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                style="@style/title2_bold"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_vote_right_arrow_16"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
