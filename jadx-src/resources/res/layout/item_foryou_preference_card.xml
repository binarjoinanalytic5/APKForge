<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_foryou_preference_card_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_preference_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/cl_content"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/space"
            layout="@layout/include_statusbar_space"/>
        <com.newleaf.app.android.victor.view.AutoSizeWrapContentTextView
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:awcMaxTextSize="20sp"
            app:awcMinTextSize="12sp"
            app:awcStepGranularity="0.5sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space"
            style="@style/title1_bold"/>
        <com.newleaf.app.android.victor.view.AutoSizeWrapContentTextView
            android:textColor="@color/texticon_tertiary"
            android:ellipsize="end"
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:awcMaxTextSize="14sp"
            app:awcMinTextSize="12sp"
            app:awcStepGranularity="0.5sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/body_regular"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_tags"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:overScrollMode="never"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintBottom_toTopOf="@+id/tv_save"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:enabled="false"
            android:textColor="@color/preference_save_button_text_selector"
            android:gravity="center"
            android:id="@+id/tv_save"
            android:background="@drawable/email_code_button_bg_selector"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginBottom="34dp"
            android:text="@string/preference_save"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_swipe_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/body_bold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_swipe_hint_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_gery_up_arrow"
            android:contentDescription="@null"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_swipe_hint"
            app:layout_constraintEnd_toStartOf="@+id/tv_swipe_hint"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_swipe_hint"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_secondary"
            android:ellipsize="end"
            android:id="@+id/tv_swipe_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="@string/foryou_preference_swipe_hint"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginEnd="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_swipe_hint_arrow"
            style="@style/footnote_regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
