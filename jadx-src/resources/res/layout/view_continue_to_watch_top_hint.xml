<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_continue_to_watch_top_hint_0"
    android:background="@drawable/bg_ffffff_corner_8"
    android:layout_width="343dp"
    android:layout_height="64dp">
    <View
        android:id="@+id/view_touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/img_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_continue_to_watch_top_hint"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/color_292929"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeStepGranularity="0.1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_button"
        app:layout_constraintStart_toEndOf="@+id/img_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/color_white90"
        android:gravity="center"
        android:id="@+id/tv_button"
        android:background="@drawable/bg_e52e2e_corner_4"
        android:padding="2dp"
        android:layout_width="76dp"
        android:layout_height="32dp"
        android:text="@string/earn_watch"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeStepGranularity="0.1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
