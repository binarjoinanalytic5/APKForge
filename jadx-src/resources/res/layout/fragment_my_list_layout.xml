<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_my_list_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/status_bar_space"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rl_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_space">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="12dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon_back_white"
            android:layout_centerVertical="true"
            android:contentDescription="@string/description_back"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textColor="@color/color_ffffff_alpha_90"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/table_library"
            android:layout_centerInParent="true"
            style="@style/headline_medium"/>
    </RelativeLayout>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smart_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_title"
        app:layout_goneMarginTop="0dp">
        <com.newleaf.app.android.victor.view.LibraryNestedScrollView
            android:id="@+id/scrollView"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/status_bar_space">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_vip_sub"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintTop_toTopOf="parent">
                    <View
                        android:id="@+id/view_vip_bg"
                        android:background="@drawable/bg_library_item_vip_sub_shape"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/iv_vip_img"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_vip_membership"
                        android:layout_marginStart="12dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_vip_sub"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_vip_sub"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textColor="@color/color_401906"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_vip_sub"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:minHeight="40dp"
                        android:maxLines="2"
                        android:layout_marginHorizontal="4dp"
                        android:paddingVertical="8dp"
                        app:autoSizeMaxTextSize="14sp"
                        app:autoSizeMinTextSize="8sp"
                        app:autoSizeStepGranularity="0.5sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/iv_right_arrow"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/iv_vip_img"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/iv_right_arrow"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/icon_right_arrow_brown"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_vip_sub"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_vip_sub"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.newleaf.app.android.victor.common.vote.VoteEntranceView
                    android:id="@+id/view_vote_enter"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_history"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textColor="@color/texticon_primary"
                        android:id="@+id/tv_module_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/table_history"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/title3_bold"/>
                    <TextView
                        android:textColor="@color/texticon_primary"
                        android:id="@+id/tv_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_all"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/body_medium"/>
                    <ImageView
                        android:id="@+id/iv_view_all"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/icon_arrow_right_alpha50"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_view_all"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_view_all"/>
                    <com.newleaf.app.android.victor.view.LibraryHistoryRecyclerView
                        android:id="@+id/rlv_history"
                        android:scrollbars="none"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:overScrollMode="never"
                        android:paddingStart="16dp"
                        android:nestedScrollingEnabled="false"
                        app:layout_constraintTop_toBottomOf="@+id/tv_module_name"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_ffffff_alpha_50"
                        android:gravity="center"
                        android:id="@+id/tv_history_empty_view"
                        android:background="@drawable/border_ffffff_alpha10_corner_4"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginRight="16dp"
                        android:minHeight="120dp"
                        android:text="@string/my_history_empty_data_desc"
                        android:layout_marginHorizontal="16dp"
                        android:paddingHorizontal="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_module_name"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:gravity="center"
                        android:id="@+id/cl_close_browsing_history"
                        android:background="@drawable/border_ffffff_alpha10_corner_4"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_module_name">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textColor="@color/texticon_secondary"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/tv_close_browsing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/history_list_disabled_empty_text"
                            android:maxLines="2"
                            android:includeFontPadding="false"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintBottom_toTopOf="@+id/tv_turn_on_button"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"
                            style="@style/body_regular"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textColor="@color/texticon_primary"
                            android:gravity="center"
                            android:id="@+id/tv_turn_on_button"
                            android:background="@drawable/bg_button_secondary_normal_r4"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/history_list_disabled_turn_on_btn"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHeight_min="32dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_close_browsing"
                            app:layout_constraintWidth_min="120dp"
                            style="@style/footnote_medium"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_library"
                    android:tag="binding_2"
                    android:paddingTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <include
                        android:id="@+id/cl_title_view"
                        app:layout_constraintTop_toTopOf="parent"
                        layout="@layout/item_my_list_title_layout"/>
                    <com.newleaf.app.android.victor.view.MaxHeightRecyclerView
                        android:id="@+id/rlv_library"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:overScrollMode="never"
                        app:layout_constraintTop_toBottomOf="@+id/cl_title_view"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </com.newleaf.app.android.victor.view.LibraryNestedScrollView>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <com.newleaf.app.android.victor.library.widget.MyListEditView
        android:id="@+id/view_edit_mylist"
        android:background="@color/black"
        android:focusableInTouchMode="true"
        android:visibility="invisible"
        android:scrollbars="none"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_title"/>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:tag="binding_3"
        android:background="@color/color_black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
