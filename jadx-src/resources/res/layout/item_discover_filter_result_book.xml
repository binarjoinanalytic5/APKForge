<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="match_parent"
        android:layout_height="224dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/v_book_poster_image_style"/>
    <com.newleaf.app.android.victor.view.BookMarkView
        android:id="@+id/bookMarkView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
        style="@style/v_book_mark_style"/>
    <View
        android:id="@+id/play_count_background"
        android:layout_width="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        style="@style/v_bg_hall_item_bottom_mask"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:id="@+id/tv_play_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:drawablePadding="1dp"
        android:drawableStart="@drawable/icon_play_count"
        android:layout_marginEnd="4dp"
        android:elevation="0.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_count_background"
        app:layout_constraintEnd_toEndOf="@+id/play_count_background"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toBottomOf="@+id/iv_book_poster"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffffff_alpha_50"
        android:ellipsize="end"
        android:id="@+id/tv_book_theme"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
