<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_btn1"
        android:background="@drawable/bg_notification_full_intent_button_b"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        style="@style/v_notification_button1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_btn2"
        android:background="@drawable/bg_ffffff_stroke_ff3050_corner_10"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        style="@style/v_notification_button2"/>
</LinearLayout>
