<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_completed_play_feedback_layout_0"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_sub_view"
        android:layout_width="297dp"
        android:layout_height="415dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/view_bottom_bg2"
            android:background="@drawable/gradient_bg1_completed_play_feedback_shape"
            android:layout_width="match_parent"
            android:layout_height="111dp"
            android:layout_marginBottom="60dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/iv_coupon_cover"
            android:layout_width="276dp"
            android:layout_height="368dp"
            android:scaleType="centerCrop"
            app:borderColor="@color/color_ffffff_alpha_15"
            app:borderWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:radius="6dp"/>
        <View
            android:id="@+id/view_cover_mask"
            android:background="@drawable/gradient_bg2_completed_play_feedback_shape"
            android:layout_width="match_parent"
            android:layout_height="165dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="176dp"
            android:layout_marginRight="10dp"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_bottom_bg"
            android:background="@drawable/bottom_bg_completed_play_feedback_dialog"
            android:layout_width="match_parent"
            android:layout_height="87dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/tv_enjoyed_episode_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_marginRight="13dp"
            android:layout_marginBottom="15dp"
            android:layout_marginHorizontal="13dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_feedback_episode_desc"
            app:layout_constraintEnd_toEndOf="@+id/iv_coupon_cover"
            app:layout_constraintStart_toStartOf="@+id/iv_coupon_cover"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff_alpha_60"
            android:id="@+id/tv_feedback_episode_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_marginRight="13dp"
            android:layout_marginBottom="13dp"
            android:text="@string/enjoyed_this_episode_questionnaire"
            android:layout_marginHorizontal="13dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_cover_mask"
            app:layout_constraintEnd_toEndOf="@+id/iv_coupon_cover"
            app:layout_constraintStart_toStartOf="@+id/iv_coupon_cover"/>
        <FrameLayout
            android:id="@+id/fl_enjoyed_no_view"
            android:background="@drawable/bg_stroke_color707070_corner6_shape"
            android:layout_width="117dp"
            android:layout_height="35dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/fl_enjoyed_yes_view"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/color_a70000"
                android:layout_gravity="center"
                android:id="@+id/tv_enjoyed_yes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/icon_enjoyed_no"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_enjoyed_yes_view"
            android:background="@drawable/bg_stroke_color707070_corner6_shape"
            android:layout_width="117dp"
            android:layout_height="35dp"
            android:layout_marginStart="25dp"
            app:layout_constraintBottom_toBottomOf="@+id/fl_enjoyed_no_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/fl_enjoyed_no_view">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/color_2dab00"
                android:layout_gravity="center"
                android:id="@+id/tv_enjoyed_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/complete_play_feedback_yes_text"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/icon_enjoyed_yes"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_close"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:src="@drawable/icon_dialog_close_32"
        android:contentDescription="@string/description_close"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="@+id/cl_sub_view"
        app:layout_constraintStart_toStartOf="@+id/cl_sub_view"
        app:layout_constraintTop_toBottomOf="@+id/cl_sub_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
