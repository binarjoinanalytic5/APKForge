<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_my_props_manage_layout_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/title_view"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@+id/title_view">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_back_white"
            android:layout_centerVertical="true"
            android:contentDescription="@string/description_back"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/texticon_primary"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/my_props"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/headline_medium"/>
        <TextView
            android:textColor="@color/texticon_secondary_active"
            android:gravity="center_vertical"
            android:id="@+id/tv_history"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/table_history"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/body_medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.newleaf.app.android.victor.view.XSlidingTabLayout2
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_title"
        app:tl_indicator_color="@color/color_white"
        app:tl_indicator_corner_radius="2dp"
        app:tl_indicator_gravity="BOTTOM"
        app:tl_indicator_height="2dp"
        app:tl_indicator_margin_bottom="9dp"
        app:tl_indicator_style="NORMAL"
        app:tl_indicator_width="16dp"
        app:tl_tab_padding="12sp"
        app:tl_textSelectColor="@color/texticon_primary"
        app:tl_textUnselectColor="@color/texticon_tertiary"
        app:tl_text_select_size="14sp"
        app:tl_textsize="14sp"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_page2"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
