<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ad_backup_play_0"
    android:background="@color/backgrounds_background_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title_bar"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_statusbar_space"/>
    <FrameLayout
        android:id="@+id/fl_play"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_bg"
        android:background="@drawable/bg_ff000000_90_00000000"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="@+id/fl_play"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_buttons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_play"
            android:background="@drawable/bg_button_secondary_normal_r4"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_play_16"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_fixed_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/play"
                android:maxLines="1"
                android:layout_marginStart="4dp"
                style="@style/title3_bold"/>
        </LinearLayout>
        <Space
            android:layout_width="8dp"
            android:layout_height="0dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_collect"
            android:background="@drawable/bg_button_white_fixed_normal_r4"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/img_collect"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_collect_none_16"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_black_normal"
                android:id="@+id/tv_collect_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/banner_button_add"
                android:maxLines="1"
                android:layout_marginStart="4dp"
                style="@style/title3_bold"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_secondary"
        android:ellipsize="end"
        android:id="@+id/tv_content_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:maxLines="2"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="12dp"
        style="@style/body_regular"/>
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/img_poster"
        android:layout_width="33dp"
        android:layout_height="44dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_content_desc"
        app:layout_constraintStart_toStartOf="@+id/tv_content_desc"
        app:radius="2dp"
        style="@style/v_book_poster_image_style"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/img_poster"
        app:layout_constraintTop_toTopOf="@+id/img_poster"
        style="@style/headline_medium"/>
    <com.newleaf.app.android.victor.view.ItemFilterTagLayout
        android:orientation="horizontal"
        android:id="@+id/ll_tag"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_poster">
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_tag1"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/text_style_player_item_tag"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_tag2"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/text_style_player_item_tag"/>
    </com.newleaf.app.android.victor.view.ItemFilterTagLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_skip"
        android:background="@drawable/bg_mask_r2"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:drawablePadding="4dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        style="@style/body_regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
