<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_container"
    android:tag="layout/dialog_compesation_layout_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_content"
        android:background="@drawable/bg_363636_corner_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="360dp"
        app:layout_constraintWidth_min="250dp">
        <TextView
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="15dp"
            android:layout_marginHorizontal="15dp"/>
        <ImageView
            android:id="@+id/iv_compensation"
            android:background="@drawable/icon_compensation_bonus"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/tv_title"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/color_white"
            android:id="@+id/tv_bonus"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="127dp"
            android:layout_below="@+id/tv_title"
            android:layout_centerHorizontal="true"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_specify_coupon_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="111dp"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="18dp"
            android:layout_below="@+id/tv_title"
            android:layout_marginHorizontal="18dp">
            <View
                android:background="@drawable/bg_compensate_dialog_specify_coupons"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.newleaf.app.android.victor.view.RoundImageView
                android:id="@+id/iv_poster"
                android:layout_width="75dp"
                android:layout_height="100dp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                app:borderColor="#24707070"
                app:borderWidth="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:radius="6dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_white80"
                android:ellipsize="end"
                android:id="@+id/tv_book_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="2"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_poster"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_e2e2e2_alpha61"
                android:ellipsize="end"
                android:id="@+id/tv_coupons_valid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="@+id/tv_book_name"
                app:layout_constraintStart_toStartOf="@+id/tv_book_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_book_name"/>
            <ImageView
                android:id="@+id/iv_icon_coupon"
                android:layout_width="27dp"
                android:layout_height="18dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/icon_coupon"
                app:layout_constraintStart_toStartOf="@+id/tv_book_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_coupons_valid"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_coupons_num"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_icon_coupon"
                app:layout_constraintEnd_toEndOf="@+id/tv_book_name"
                app:layout_constraintStart_toEndOf="@+id/iv_icon_coupon"
                app:layout_constraintTop_toTopOf="@+id/iv_icon_coupon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ScrollView
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb_bg_shape"
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="150dp"
            android:layout_marginRight="14dp"
            android:layout_below="@+id/tv_title"
            android:fadeScrollbars="false"
            android:layout_marginHorizontal="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:id="@+id/tv_content"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="5dp"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:id="@+id/content_gradient_bg"
            android:layout_width="match_parent"
            android:layout_height="113dp"
            android:layout_marginTop="-23dp"
            android:layout_below="@+id/scroll_content"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_claim"
            android:background="@drawable/bg_e83a57_corner_4"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="30dp"
            android:text="@string/claim"
            android:maxLines="1"
            android:layout_below="@+id/scroll_content"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:src="@drawable/icon_dialog_close_32"
        android:contentDescription="@string/description_close"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="@+id/rl_content"
        app:layout_constraintStart_toStartOf="@+id/rl_content"
        app:layout_constraintTop_toBottomOf="@+id/rl_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
