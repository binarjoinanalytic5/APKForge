<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/view_my_vip_subscribe_vip_holder_layout_0"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginHorizontal="16dp">
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tv_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:maxLines="2"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/title3_bold"/>
    <com.newleaf.app.android.victor.vip.v2.VipListViewV4
        android:id="@+id/rv_sub"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_sub_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_sub"
        android:background="@drawable/btn_new_vip_sub"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/rv_sub">
        <ImageView
            android:id="@+id/iv_crown"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/icon_crown_20"
            app:layout_constraintBottom_toBottomOf="@+id/tv_sub"
            app:layout_constraintEnd_toStartOf="@+id/tv_sub"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textColor="#ff3e2a25"
            android:id="@+id/tv_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vip_list_title"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_crown"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/body_bold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:gravity="center"
        android:id="@+id/tv_promotion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:maxLines="2"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_sub"
        style="@style/caption_regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
