<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_my_props_layout_0"
    android:background="@drawable/bg_background3_corner4"
    android:layout_width="match_parent"
    android:layout_height="122dp">
    <ImageView
        android:id="@+id/iv_poster"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:layout_toEndOf="@+id/iv_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_poster"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body_medium"/>
    <TextView
        android:textColor="@color/texticon_secondary_active"
        android:ellipsize="end"
        android:id="@+id/tv_expires"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/footnote_regular"/>
    <ImageView
        android:id="@+id/iv_coupon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_props_count"
        app:layout_constraintStart_toEndOf="@+id/iv_poster"
        app:layout_constraintTop_toTopOf="@+id/tv_props_count"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_props_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/tv_expires"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/iv_coupon"
        app:layout_constraintBottom_toBottomOf="@+id/tv_btn"
        app:layout_constraintStart_toEndOf="@+id/iv_coupon"
        app:layout_constraintTop_toTopOf="@+id/tv_btn"
        style="@style/body_bold"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:gravity="center"
        android:id="@+id/tv_btn"
        android:background="@drawable/bg_ffffff_alpha_10_corner2"
        android:layout_width="128dp"
        android:layout_height="32dp"
        android:layout_marginBottom="12dp"
        android:text="@string/use_now"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/body_medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
