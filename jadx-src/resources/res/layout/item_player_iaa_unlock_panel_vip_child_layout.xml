<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_root"
    android:tag="layout/item_player_iaa_unlock_panel_vip_child_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_content_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_bg_icon"
            android:layout_width="172dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_content_bg"
            app:layout_constraintEnd_toEndOf="@+id/v_content_bg"
            app:layout_constraintTop_toTopOf="@+id/v_content_bg"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="#e5401a06"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="12dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            android:layout_marginHorizontal="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/body_regular"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="#ff401a06"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_vip_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:priceAniDuration="1000"
            style="@style/title1_bold"/>
        <com.newleaf.app.android.victor.view.ObliqueLineTextView
            android:textColor="#80401a06"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_underline_price"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_vip_price"
            app:layout_constraintStart_toEndOf="@+id/tv_vip_price"
            app:lineColor="#80401a06"
            app:lineStyle="styleHorizontalCenter"
            app:lineWidth="1dp"
            style="@style/footnote_regular"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="#b2401a06"
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="12dp"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            android:layout_marginHorizontal="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_vip_price"
            style="@style/caption_regular"/>
        <androidx.legacy.widget.Space
            android:id="@+id/bottom_space"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_mark"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_primary"
                android:gravity="center_vertical"
                android:id="@+id/tv_text_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.95"
                style="@style/caption_medium"/>
            <View
                android:id="@+id/v_dividing_line"
                android:background="@color/texticon_quaternary"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"/>
            <com.newleaf.app.android.victor.view.CountDownText
                android:textColor="@color/texticon_primary"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_count_down_mark"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.95"
                style="@style/caption_medium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/cl_benefits"
        android:background="#fffdecd3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/v_content_bg">
        <com.newleaf.app.android.victor.view.NoTouchRecyclerView
            android:id="@+id/rv_benefits_list"
            android:paddingTop="8dp"
            android:paddingBottom="3dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"/>
    </FrameLayout>
</LinearLayout>
