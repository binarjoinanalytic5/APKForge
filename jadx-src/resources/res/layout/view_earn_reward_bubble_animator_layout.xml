<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffc786"
        android:gravity="center"
        android:id="@+id/tv_coins"
        android:tag="layout/view_earn_reward_bubble_animator_layout_0"
        android:background="@drawable/icon_reward_bubble_down_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:paddingHorizontal="6dp"/>
    <View
        android:id="@+id/view_arrow"
        android:tag="layout/view_earn_reward_bubble_animator_layout_1"
        android:background="@drawable/icon_reward_bubble_down_arrow"
        android:layout_width="8dp"
        android:layout_height="4dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_coins"
        app:layout_constraintStart_toStartOf="@+id/tv_coins"
        app:layout_constraintTop_toBottomOf="@+id/tv_coins"/>
    <com.newleaf.app.android.victor.rewards.widget.EarnRewardBubbleShimmerView
        android:id="@+id/shimmer_view"
        android:tag="layout/view_earn_reward_bubble_animator_layout_2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:csAnimMode="manual"
        app:csColors="#00FFFAF0,#80FFFAF0,#FFFAF0,#80FFFAF0,#00FFFAF0"
        app:csDuration="2000"
        app:csInterval="0"
        app:csPositions="0,0.5,0.3,0.5,1"
        app:csRadius="4dp"
        app:csShimmerWidth="32dp"
        app:csSlope="0.5"
        app:layout_constraintBottom_toBottomOf="@+id/view_arrow"
        app:layout_constraintEnd_toEndOf="@+id/tv_coins"
        app:layout_constraintStart_toStartOf="@+id/tv_coins"
        app:layout_constraintTop_toTopOf="@+id/tv_coins"/>
</merge>
