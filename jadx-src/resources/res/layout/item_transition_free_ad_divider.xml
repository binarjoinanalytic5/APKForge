<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_transition_free_ad_divider_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_line_start"
        android:background="@color/color_ffffff_alpha_20"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_divider"
        app:layout_constraintEnd_toStartOf="@+id/tv_divider"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_divider"
        app:layout_constraintWidth_min="32dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:gravity="center"
        android:id="@+id/tv_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="16dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_line_end"
        app:layout_constraintStart_toEndOf="@+id/v_line_start"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body_medium"/>
    <View
        android:id="@+id/v_line_end"
        android:background="@color/color_ffffff_alpha_20"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_divider"
        app:layout_constraintTop_toTopOf="@+id/tv_divider"
        app:layout_constraintWidth_min="32dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
