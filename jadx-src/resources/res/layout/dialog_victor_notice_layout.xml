<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_victor_notice_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_container"
        android:background="@drawable/bg_backgrounds_background_4_r4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:minHeight="64dp"
        android:layout_marginHorizontal="8dp">
        <FrameLayout
            android:id="@+id/fl_poster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_msg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_msg">
            <com.newleaf.app.android.victor.view.RoundImageView
                android:id="@+id/img_poster"
                android:visibility="visible"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="8dp"
                app:radius="2.4dp"/>
            <com.newleaf.app.android.victor.view.ActorOverlapView
                android:id="@+id/aol_actor_list"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                app:aol_avatar_background="@drawable/bg_background4_oval"
                app:aol_border_width="1.5dp"
                app:aol_child_size="40dp"
                app:aol_max_size="3"
                app:aol_overlap_width="26dp"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_primary"
            android:id="@+id/tv_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="13dp"
            android:maxLines="2"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="13dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_arrow_right"
            app:layout_constraintStart_toEndOf="@+id/fl_poster"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="12dp"
            style="@style/body_regular"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_arrow_right"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_arrow_right_16"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
