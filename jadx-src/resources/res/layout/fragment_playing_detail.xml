<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_playing_detail_0"
    android:background="@color/color_141414"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_mask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_bg_pic"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"/>
        <View
            android:background="@drawable/bg_playing_detail_mask"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>
    </FrameLayout>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smart_layout"
        android:paddingTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_playing_detail_tab_bar"
        app:layout_constraintTop_toBottomOf="@+id/include_title">
        <com.newleaf.app.android.victor.view.RecyclerViewAtViewPager2
            android:id="@+id/rv_list"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_playing_detail_tab_bar"
        android:background="@color/backgrounds_background_2"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout
            android:id="@+id/ll_detail_collect"
            android:background="@drawable/bg_button_secondary_normal_r4"
            android:layout_width="48dp"
            android:layout_height="48dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_detail_collect"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/icon_item_video_collect_empty"/>
        </FrameLayout>
        <Space
            android:layout_width="8dp"
            android:layout_height="0dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_continue_watch"
            android:background="@drawable/bg_button_brand_normal_r4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_play_16"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_fixed_primary"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/continue_watch"
                android:maxLines="1"
                android:layout_marginStart="4dp"
                style="@style/body_bold"/>
        </LinearLayout>
    </LinearLayout>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:tag="binding_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/include_title"
        layout="@layout/include_title_playing_detail"/>
</androidx.constraintlayout.widget.ConstraintLayout>
