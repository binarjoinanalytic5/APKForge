<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/item_vote_recommend_layout_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginLeft="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginRight="10dp"
    android:layout_marginHorizontal="10dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shimmer_parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/view_shimmer"
            android:background="@drawable/vote_like_shimmer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar_stroke"
        app:layout_constraintEnd_toEndOf="@+id/iv_avatar_stroke"
        app:layout_constraintStart_toStartOf="@+id/iv_avatar_stroke"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar_stroke"/>
    <ImageView
        android:id="@+id/iv_avatar_stroke"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/icon_vote_avatar_stroke"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_avatar,iv_avatar_stroke"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="#ffffd8b5"
        android:ellipsize="end"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:maxLines="2"
        android:layout_marginHorizontal="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_heat_value"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/footnote_regular"/>
    <TextView
        android:textColor="#ffffc794"
        android:id="@+id/tv_heat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cl_hot_parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/footnote_medium"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_hot_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/alpha_hot"
            android:background="@drawable/icon_vote_btn_hot"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@+id/iv_heat"
            app:layout_constraintEnd_toEndOf="@+id/iv_heat"
            app:layout_constraintStart_toStartOf="@+id/iv_heat"
            app:layout_constraintTop_toTopOf="@+id/iv_heat"/>
        <ImageView
            android:id="@+id/iv_heat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_vote_heat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_like_pop_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="96dp"
        android:layout_height="52dp"
        android:layout_marginBottom="11dp"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
