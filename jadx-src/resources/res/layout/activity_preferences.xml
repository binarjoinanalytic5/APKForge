<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:tag="layout/activity_preferences_0"
    android:background="@color/backgrounds_background_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_top_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/nav_container"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/include_statusbar_space"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/nav_content"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingHorizontal="6dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_back"
                android:padding="10dp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/icon_back_white"
                android:contentDescription="@string/description_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_primary"
                android:gravity="center_vertical"
                android:id="@+id/tv_reset"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/preference_reset"
                android:includeFontPadding="false"
                android:paddingHorizontal="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/body_medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_preference"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/footer_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nav_container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/footer_container"
        android:background="@color/backgrounds_background_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/v_footer_divider"
            android:background="@color/line_outline"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:enabled="false"
            android:textColor="@color/preference_save_button_text_selector"
            android:gravity="center"
            android:id="@+id/tv_save"
            android:background="@drawable/email_code_button_bg_selector"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/preference_save"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/body_bold"/>
    </LinearLayout>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:load_fail_view_bg_color="@color/black"/>
</androidx.constraintlayout.widget.ConstraintLayout>
