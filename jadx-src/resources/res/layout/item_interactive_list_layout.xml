<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_interactive_list_layout_0"
    android:layout_width="match_parent"
    android:layout_height="120dp">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/img_poster"
        android:layout_width="90dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/v_book_poster_image_style"/>
    <com.newleaf.app.android.victor.view.BookMarkView
        android:id="@+id/bookMarkView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/img_poster"
        app:layout_constraintTop_toTopOf="@+id/img_poster"
        style="@style/v_book_mark_style"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_play_count_view"
        android:layout_width="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_poster"
        app:layout_constraintEnd_toEndOf="@+id/img_poster"
        app:layout_constraintStart_toStartOf="@+id/img_poster"
        style="@style/v_bg_hall_item_bottom_mask">
        <TextView
            android:textColor="@color/texticon_primary"
            android:gravity="center_vertical"
            android:id="@+id/tv_play_count"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:drawablePadding="1dp"
            android:drawableStart="@drawable/icon_play_count"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/caption_medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/img_collect_icon"
        app:layout_constraintStart_toEndOf="@+id/img_poster"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/headline_medium"/>
    <com.newleaf.app.android.victor.view.ItemFilterTagLayout
        android:orientation="horizontal"
        android:id="@+id/ll_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/img_collect_icon"
        app:layout_constraintStart_toStartOf="@+id/tv_book_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name">
        <TextView
            android:textColor="@color/texticon_secondary"
            android:ellipsize="end"
            android:id="@+id/tv_tag1"
            android:background="@drawable/bg_white15_r4"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            style="@style/caption_medium"/>
        <TextView
            android:textColor="@color/texticon_secondary"
            android:ellipsize="end"
            android:id="@+id/tv_tag2"
            android:background="@drawable/bg_white15_r4"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            style="@style/caption_medium"/>
    </com.newleaf.app.android.victor.view.ItemFilterTagLayout>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/img_collect_icon"
        app:layout_constraintStart_toStartOf="@+id/tv_book_name"
        app:layout_constraintTop_toBottomOf="@+id/ll_tag"
        style="@style/footnote_regular"/>
    <ImageView
        android:id="@+id/img_collect_icon"
        android:padding="6dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
