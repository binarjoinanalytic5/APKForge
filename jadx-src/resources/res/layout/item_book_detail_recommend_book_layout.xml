<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item_root"
    android:tag="layout/item_book_detail_recommend_book_layout_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="111dp"
        android:layout_height="148dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/v_book_poster_image_style"/>
    <com.newleaf.app.android.victor.view.BookMarkView
        android:id="@+id/bookMarkView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
        style="@style/v_book_mark_style"/>
    <View
        android:id="@+id/v_play_count_cover"
        android:layout_width="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        style="@style/v_bg_hall_item_bottom_mask"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_play_count"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:drawablePadding="1dp"
        android:drawableStart="@drawable/icon_play_count"
        android:layout_marginEnd="4dp"
        android:elevation="0.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_play_count_cover"
        app:layout_constraintEnd_toEndOf="@+id/v_play_count_cover"
        style="@style/caption_medium"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:lines="2"
        android:lineSpacingMultiplier="0.88"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toBottomOf="@+id/iv_book_poster"
        style="@style/body_medium"/>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_book_theme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name"
        style="@style/footnote_regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
