<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:layout_width="247dp"
    android:layout_height="330dp"
    android:alpha="0.3">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="8dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_book_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textColor="#ff714f24"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_share"
        android:paddingBottom="2dp"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        style="@style/footnote_regular"/>
    <com.newleaf.app.android.victor.view.BookMarkView
        android:textSize="10sp"
        android:textColor="@color/color_white"
        android:gravity="center_vertical"
        android:id="@+id/bookMarkView"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="0dp"
        app:autoSizeMaxTextSize="10sp"
        app:autoSizeMinTextSize="6sp"
        app:autoSizeStepGranularity="0.1sp"
        app:autoSizeTextType="uniform"
        app:bmv_radius="2dp"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"/>
</androidx.constraintlayout.widget.ConstraintLayout>
