<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/cl_root"
    android:tag="layout/dialog_completed_play_feedback_sub_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.view.MaxDialogHeightNestedScrollView
        android:id="@+id/nsv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tv_watch_now">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_img_cover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/gradient_bg_feedback_obtain_coupon_dialog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="96dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@drawable/bg_gradient_complete_play_dialog_content_shape"
                android:layout_width="match_parent"
                android:layout_height="165dp"
                app:layout_constraintBottom_toTopOf="@+id/cl_coupon_view"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/tv_content_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="25dp"
                android:text="@string/text_enjoyed_feedback_content"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintBottom_toTopOf="@+id/cl_coupon_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_coupon_view"
                android:background="@color/black"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:layout_width="match_parent"
                android:layout_height="123dp"
                android:layout_marginBottom="25dp"
                android:paddingHorizontal="18dp"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:background="@drawable/bg_coupon_feedback_dialog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.newleaf.app.android.victor.view.RoundImageView
                    android:id="@+id/iv_coupon_img"
                    android:layout_width="75dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="12dp"
                    app:borderColor="@color/color_707070_alpha14"
                    app:borderWidth="1dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:radius="6dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_ffffff_alpha_80"
                    android:ellipsize="end"
                    android:id="@+id/tv_coupon_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:maxLines="2"
                    android:layout_marginStart="39dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_coupon_img"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_e2e2e2_alpha61"
                    android:ellipsize="end"
                    android:id="@+id/tv_coupon_expired_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tv_coupon_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_coupon_name"/>
                <ImageView
                    android:id="@+id/iv_icon_coupon"
                    android:layout_width="27dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="9dp"
                    android:src="@drawable/icon_coupon"
                    app:layout_constraintStart_toStartOf="@+id/tv_coupon_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_coupon_expired_time"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/tv_coupon_num"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="7dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_icon_coupon"
                    app:layout_constraintTop_toTopOf="@+id/iv_icon_coupon"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.newleaf.app.android.victor.view.MaxDialogHeightNestedScrollView>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/icon_white_close"
        android:contentDescription="@string/description_close"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toEndOf="@+id/nsv_content"
        app:layout_constraintTop_toTopOf="@+id/nsv_content"/>
    <TextView
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nsv_content"/>
    <View
        android:id="@+id/v_bottom_divider"
        android:background="@drawable/bg_gradient_complete_play_dialog_content_shape"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_watch_now"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_watch_now"
        android:background="@drawable/bg_e83a57_corner_6"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="13dp"
        android:text="@string/watch_now"
        android:layout_marginHorizontal="18dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_feedback"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_feedback"
        android:background="@drawable/bg_stroke_color707070_corner6_shape"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="27dp"
        android:text="@string/rate_us"
        android:layout_marginHorizontal="18dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
