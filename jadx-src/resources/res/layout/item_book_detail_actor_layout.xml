<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_book_detail_actor_layout_0"
    android:layout_width="76dp"
    android:layout_height="match_parent">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_actor_avatar"
        android:layout_width="75dp"
        android:layout_height="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="6dp"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_white80"
        android:ellipsize="end"
        android:id="@+id/tv_actor_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/iv_actor_avatar"
        app:layout_constraintStart_toStartOf="@+id/iv_actor_avatar"
        app:layout_constraintTop_toBottomOf="@+id/iv_actor_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
