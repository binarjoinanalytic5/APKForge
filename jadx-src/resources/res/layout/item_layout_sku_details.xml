<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item_bg"
    android:tag="layout/item_layout_sku_details_0"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/img_icon_coins"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="18.5dp"
        android:src="@drawable/icon_coins_16"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:id="@+id/tv_coin_num"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon_coins"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/img_icon_coins"
        app:layout_constraintTop_toTopOf="@+id/img_icon_coins"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff_alpha_60"
        android:id="@+id/tv_bonus"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon_coins"
        app:layout_constraintStart_toEndOf="@+id/tv_coin_num"
        app:layout_constraintTop_toTopOf="@+id/img_icon_coins"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_ffffff_alpha_80"
        android:gravity="center"
        android:id="@+id/tv_price"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_coin_num"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_mark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginStart="13.5dp"
        android:paddingHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_text_mark"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"/>
        <View
            android:id="@+id/v_dividing_line"
            android:background="#fffceaea"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:alpha="0.3"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="4dp"/>
        <com.newleaf.app.android.victor.view.CountDownText
            android:textSize="10sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_count_down_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            app:autoSizeMaxTextSize="10sp"
            app:autoSizeMinTextSize="4sp"
            app:autoSizeStepGranularity="0.1sp"
            app:autoSizeTextType="uniform"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
