<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_content_parent"
    android:tag="layout/view_earn_reward_guide_float_layout_0"
    android:layout_width="72dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_close"
        android:background="@drawable/ic_close_earn_reward_guide_float"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/description_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/description_jump"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_close">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="10sp"
            android:textColor="@color/color_ffc786"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_earn_coins"
            android:background="@drawable/bg_reward_floating_btn"
            android:paddingLeft="2dp"
            android:paddingTop="3dp"
            android:paddingRight="2dp"
            android:paddingBottom="3dp"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:minHeight="24dp"
            android:text="@string/earn_coins"
            android:maxLines="2"
            android:lineSpacingMultiplier="0.88"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            app:autoSizeMaxTextSize="10sp"
            app:autoSizeMinTextSize="6sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_coins"/>
        <ImageView
            android:id="@+id/iv_coins"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon_reward_coins_box"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
