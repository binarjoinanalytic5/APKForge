<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_play_history_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_check"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="5dp"
        android:elevation="1.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/c_poster"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/c_poster"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/c_poster"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintStart_toEndOf="@+id/img_check"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp">
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/img_poster"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:borderColor="@color/color_33888888"
            app:borderWidth="0.5dp"
            style="@style/v_book_poster_image_style"/>
        <com.newleaf.app.android.victor.view.HallWatchHistoryProgress
            android:layout_gravity="bottom"
            android:id="@+id/play_progress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:elevation="3dp"
            app:hp_background_color="@color/color_ffffff_alpha_16"
            app:hp_progress_color="@color/color_fe4167"/>
        <com.newleaf.app.android.victor.view.BookMarkView
            android:layout_gravity="start|top"
            android:id="@+id/bookMarkView"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/v_book_mark_style"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:tag="binding_3"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_history_date"
        app:layout_constraintEnd_toStartOf="@+id/img_collect_icon"
        app:layout_constraintStart_toEndOf="@+id/c_poster"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffffff_alpha_50"
        android:ellipsize="end"
        android:id="@+id/tv_history_date"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_book_name"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/c_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name"/>
    <ImageView
        android:id="@+id/img_collect_icon"
        android:padding="6dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
