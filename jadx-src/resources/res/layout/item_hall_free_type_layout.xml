<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_hall_free_type_layout_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffffff_alpha_70"
        android:id="@+id/tv_online_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="July 6th"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/online_time_line"
        android:background="@color/color_707070"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_online_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_online_time"
        app:layout_constraintTop_toTopOf="@+id/tv_online_time"/>
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_book_poster"
        android:tag="binding_1"
        android:layout_width="108dp"
        android:layout_height="144dp"
        android:layout_marginTop="33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/v_book_poster_image_style"/>
    <com.newleaf.app.android.victor.view.BookMarkView
        android:id="@+id/bookMarkView"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
        style="@style/v_book_mark_style"/>
    <View
        android:id="@+id/view_bottom_gradient"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="75dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"/>
    <ImageView
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:src="@drawable/icon_reelshort_hall"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="2dp"
        android:maxLines="2"
        android:layout_marginHorizontal="2dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toBottomOf="@+id/iv_book_poster"/>
</androidx.constraintlayout.widget.ConstraintLayout>
