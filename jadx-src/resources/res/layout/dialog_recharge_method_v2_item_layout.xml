<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_web_pay"
    android:tag="layout/dialog_recharge_method_v2_item_layout_0"
    android:background="@drawable/bg_recharge_method_v2_item"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="4dp">
    <ImageView
        android:id="@+id/iv_pay_main_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerInside"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_pay_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_pay_desc"
        app:layout_constraintEnd_toStartOf="@+id/ll_bonus"
        app:layout_constraintStart_toEndOf="@+id/iv_pay_main_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginStart="16dp"
        style="@style/body_medium"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_pay_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll_bonus"
        app:layout_constraintStart_toStartOf="@+id/tv_pay_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_name">
        <ImageView
            android:id="@+id/iv_pay_method"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/texticon_tertiary"
            android:ellipsize="end"
            android:id="@+id/tv_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_pay_method"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_pay_method"
            app:layout_constraintTop_toTopOf="@+id/iv_pay_method"
            app:layout_goneMarginStart="0dp"
            style="@style/footnote_regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_bonus"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_bonus_coin"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_coins_24"
            android:scaleType="centerInside"/>
        <TextView
            android:textColor="@color/texticon_primary"
            android:id="@+id/tv_bonus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            style="@style/body_bold"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_count_down_mark"
        android:background="@drawable/bg_item_sku_mark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:paddingHorizontal="8dp"
        app:autoSizeMaxTextSize="10sp"
        app:autoSizeMinTextSize="4sp"
        app:autoSizeStepGranularity="0.1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="@+id/cl_web_pay"
        app:layout_constraintTop_toTopOf="@+id/cl_web_pay"
        style="@style/caption_medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
