<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/dialog_bind_email_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/bg_view"
            android:background="@drawable/bg_dialog_bind_email"
            android:layout_width="315dp"
            android:layout_height="209dp"
            android:layout_marginBottom="43dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_pre"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/view_pre"
            android:layout_width="315dp"
            android:layout_height="117dp"
            android:src="@drawable/pre_bg_dialog_bind_email"
            android:elevation="0.2dp"
            app:layout_constraintBottom_toBottomOf="@+id/space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_layout"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/cl_layout"
            android:background="@drawable/bg_dialog_bind_email_letter"
            android:layout_width="279dp"
            android:layout_height="wrap_content"
            android:elevation="0.1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_close">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/color_222222"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:elevation="0.1dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_tips"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/color_222222_alpha_80"
                android:gravity="center"
                android:id="@+id/tv_tips"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/bind_email_dialog_tips"
                android:elevation="0.1dp"
                android:paddingHorizontal="20dp"
                app:layout_constraintBottom_toTopOf="@+id/et_email"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="12sp"
                android:textColorHint="@color/color_222222_alpha_20"
                android:id="@+id/et_email"
                android:background="@drawable/bg_ffffff_alpha_50_stroke_d2c9c3_corner_6"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:hint="@string/bind_email_input_email_hint"
                android:inputType="textEmailAddress"
                android:elevation="0.1dp"
                android:layout_marginHorizontal="20dp"
                android:paddingHorizontal="12dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10sp"
                android:textColor="@color/color_ff3d5d"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_error"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="23dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="11dp"
                android:layout_marginRight="20dp"
                android:text="@string/bind_email_input_email_error_tips"
                android:elevation="0.3dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintBottom_toTopOf="@+id/space2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <View
                android:id="@+id/space2"
                android:layout_width="0dp"
                android:layout_height="93dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/fl_close"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_dialog_close_32"
                android:contentDescription="@string/description_close"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/color_white"
            android:id="@+id/tv_submit"
            android:background="@drawable/bg_ff3d5d_corner_6"
            android:paddingLeft="65dp"
            android:paddingTop="10dp"
            android:paddingRight="65dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="@string/bind_email_submit"
            android:elevation="0.3dp"
            android:paddingHorizontal="65dp"
            android:paddingVertical="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_pre"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/view_submit"
            android:background="@drawable/bg_fffffff_alpha_70_corner_6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="0.5dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_submit"
            app:layout_constraintEnd_toEndOf="@+id/tv_submit"
            app:layout_constraintStart_toStartOf="@+id/tv_submit"
            app:layout_constraintTop_toTopOf="@+id/tv_submit"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
