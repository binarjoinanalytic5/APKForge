<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_search_series_book_0"
    android:clipChildren="false"
    android:layout_width="111dp"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_poster_container"
        android:clipChildren="false"
        android:layout_width="111dp"
        android:layout_height="148dp">
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/iv_book_poster"
            android:layout_width="111dp"
            android:layout_height="148dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/v_book_poster_image_style"/>
        <com.newleaf.app.android.victor.view.BookMarkView
            android:id="@+id/bookMarkView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/v_book_mark_style"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_play_count_view"
            android:layout_width="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
            app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
            app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
            style="@style/v_bg_hall_item_bottom_mask">
            <TextView
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_play_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:includeFontPadding="false"
                android:drawablePadding="1dp"
                android:drawableStart="@drawable/icon_play_count"
                android:layout_marginEnd="4dp"
                android:elevation="0.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/caption_medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="@+id/tv_book_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="2"
        android:includeFontPadding="false"
        style="@style/body_medium"/>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="@+id/tv_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        style="@style/footnote_regular"/>
</LinearLayout>
