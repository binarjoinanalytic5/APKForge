<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_banner_pad_layout3_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/img_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/img_fg_bottom"
        android:background="@drawable/bg_000000_to_00000000"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_decorator"
        android:layout_width="343dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginStart="17dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_title"
            android:visibility="gone"
            android:layout_width="343dp"
            android:layout_height="120dp"
            android:scaleType="fitCenter"/>
        <com.newleaf.app.android.victor.view.ItemFilterTagLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/tag_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layoutDirection="ltr"
            android:layout_marginHorizontal="16dp">
            <com.newleaf.app.android.victor.view.BookMarkView
                android:textSize="12sp"
                android:ellipsize="end"
                android:id="@+id/book_mark"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                app:bmv_radius="4dp"
                style="@style/v_book_mark_style"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_ffffff_alpha_70"
                android:ellipsize="end"
                android:id="@+id/tv_tag1"
                android:background="@drawable/bg_white15_r4"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_ffffff_alpha_70"
                android:ellipsize="end"
                android:id="@+id/tv_tag2"
                android:background="@drawable/bg_white15_r4"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"/>
        </com.newleaf.app.android.victor.view.ItemFilterTagLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/fl_play_view"
            android:background="@drawable/shape_banner_player_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="168dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="8dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_black_normal"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/tv_play_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/play"
                android:maxLines="1"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/icon_banner_player2"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform"
                style="@style/title3_bold"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
