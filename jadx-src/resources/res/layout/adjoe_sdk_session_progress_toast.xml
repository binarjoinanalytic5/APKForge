<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/adjoe_sdk_toast_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="80dp">
        <ImageView
            android:id="@+id/publisher_icon_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#dd000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/seconds_amount_view"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>
    <View
        android:background="@drawable/adjoe_sdk_toast_separator"
        android:layout_width="16dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:background="@drawable/adjoe_sdk_toast_background_right"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/partner_icon_view"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"/>
            <ProgressBar
                android:id="@+id/usage_progress"
                android:background="@drawable/adjoe_sdk_circular_progress_background"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:progressDrawable="@drawable/adjoe_sdk_circular_progress"
                android:layout_centerInParent="true"
                style="?android:attr/progressBarStyleHorizontal"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
