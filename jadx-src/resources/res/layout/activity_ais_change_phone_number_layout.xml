<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_ais_change_phone_number_layout_0"
    android:background="@color/profile_common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title"
        layout="@layout/include_title_bar"/>
    <View
        android:id="@+id/v_content_bg"
        android:background="@drawable/bg_backgrounds_background_2_r4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_phone_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="@+id/v_content_bg"
        app:layout_constraintStart_toStartOf="@+id/v_content_bg"
        app:layout_constraintTop_toTopOf="@+id/v_content_bg"
        style="@style/mediumtitle_bold"/>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:gravity="center_horizontal"
        android:id="@+id/tv_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="@+id/v_content_bg"
        app:layout_constraintStart_toStartOf="@+id/v_content_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_phone_number"
        style="@style/body_regular"/>
    <androidx.legacy.widget.Space
        android:id="@+id/bottom_space"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_des"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:gravity="center"
        android:id="@+id/tv_affirm"
        android:background="@drawable/bg_button_secondary_normal_r4"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:text="@string/change_phone_number"
        android:singleLine="true"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_content_bg"
        style="@style/body_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
