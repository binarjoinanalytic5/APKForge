<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_ad_vip_subscribe_card_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginHorizontal="16dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_lab_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_card"
        android:background="@drawable/bg_292929_corner_4"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_lab_name"/>
    <ImageView
        android:id="@+id/bg_v"
        android:layout_width="172dp"
        android:layout_height="94dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_card"
        app:layout_constraintEnd_toEndOf="@+id/v_card"
        app:layout_constraintTop_toTopOf="@+id/v_card"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="100dp"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
        app:layout_constraintEnd_toEndOf="@+id/v_card"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/v_card"
        app:layout_constraintTop_toTopOf="@+id/v_card"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/texticon_secondary"
        android:ellipsize="end"
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="100dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_card"
        app:layout_constraintEnd_toEndOf="@+id/v_card"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/v_card"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_card"
        app:layout_constraintEnd_toEndOf="@+id/v_card"
        app:layout_constraintTop_toTopOf="@+id/v_card"/>
</androidx.constraintlayout.widget.ConstraintLayout>
