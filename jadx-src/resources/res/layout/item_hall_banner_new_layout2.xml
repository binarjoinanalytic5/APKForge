<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_hall_banner_new_layout2_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.view.BannerRecyclerView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="460dp"
        android:importantForAccessibility="no"
        app:auto_switch_enable="true"
        app:auto_switch_interval_time="10000"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_top_cover"
        android:background="@drawable/bg_discover_banner_covert"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="@+id/banner"/>
    <com.newleaf.app.android.victor.view.HallBannerIndicatorView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:importantForAccessibility="no"
        app:ind_point_background_color="@color/color_95928E"
        app:ind_point_height="3dp"
        app:ind_point_select_color="@color/white"
        app:ind_point_select_height="4dp"
        app:ind_point_select_width="20dp"
        app:ind_point_space="6dp"
        app:ind_point_width="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/banner"/>
</androidx.constraintlayout.widget.ConstraintLayout>
