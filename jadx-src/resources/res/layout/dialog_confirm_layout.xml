<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_confirm_layout_0"
    android:background="@drawable/bg_363636_corner_5"
    android:paddingBottom="30dp"
    android:layout_width="284dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="21sp"
        android:textColor="@color/white"
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22.5dp"
        android:text="@string/notice_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Are you sure you want to delet this story?"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_title"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/color_a7a7a7"
        android:id="@+id/btn_dialog_left"
        android:background="@drawable/bg_dialog_confirm_btn_selector"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginTop="20dp"
        android:text="@string/delete"
        android:textAllCaps="false"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_dialog_right"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_content"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/btn_dialog_right"
        android:background="@drawable/bg_dialog_cancel_btn_selector"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_dialog_left"
        app:layout_constraintTop_toTopOf="@+id/btn_dialog_left"/>
</androidx.constraintlayout.widget.ConstraintLayout>
