<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:tag="layout/dialog_discover_push_permision_layout_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:background="@color/profile_common_bg"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_img"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/img_push_permission"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/texticon_primary"
            android:gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/turn_on_notifications"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/iv_img"
            style="@style/title2_bold"/>
        <TextView
            android:textColor="@color/texticon_secondary"
            android:gravity="center_horizontal"
            android:id="@+id/tv_subtitle"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/push_permission_dialog_subtitle"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/body_regular"/>
        <TextView
            android:textColor="@color/texticon_fixed_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_turn_on"
            android:background="#ffe52e2e"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="16dp"
            android:text="@string/turn_on"
            android:maxLines="1"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
            style="@style/body_bold"/>
        <TextView
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="#1affffff"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:text="@string/maybe_later"
            android:maxLines="1"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_turn_on"
            style="@style/body_bold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
