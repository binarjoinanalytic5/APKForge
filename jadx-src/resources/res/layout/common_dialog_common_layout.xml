<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_bg"
        android:background="@drawable/bg_common_dialog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="21dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="21dp"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintStart_toStartOf="@+id/v_bg"
        app:layout_constraintTop_toTopOf="@+id/v_bg"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="21dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="21dp"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintStart_toStartOf="@+id/v_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_goneMarginTop="23dp"/>
    <View
        android:id="@+id/v_hor_line"
        android:background="#33ffffff"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/tv_left"
        android:paddingTop="15dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/cancel"
        app:layout_constraintBottom_toBottomOf="@+id/v_ver_line"
        app:layout_constraintEnd_toStartOf="@+id/v_ver_line"
        app:layout_constraintStart_toStartOf="@+id/v_bg"
        app:layout_constraintTop_toTopOf="@+id/v_ver_line"/>
    <View
        android:id="@+id/v_ver_line"
        android:background="#33ffffff"
        android:layout_width="0.5dp"
        android:layout_height="52dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_right"
        app:layout_constraintStart_toEndOf="@+id/tv_left"
        app:layout_constraintTop_toBottomOf="@+id/v_hor_line"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffe83a57"
        android:gravity="center"
        android:id="@+id/tv_right"
        android:paddingTop="15dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/clear"
        app:layout_constraintBottom_toBottomOf="@+id/v_ver_line"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintStart_toEndOf="@+id/v_ver_line"
        app:layout_constraintTop_toTopOf="@+id/v_ver_line"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:src="@drawable/icon_gery_close"
        android:contentDescription="@string/description_close"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintStart_toStartOf="@+id/v_bg"
        app:layout_constraintTop_toBottomOf="@+id/v_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
