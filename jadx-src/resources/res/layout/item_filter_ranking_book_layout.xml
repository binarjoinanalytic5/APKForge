<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_filter_ranking_book_layout_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fl_img"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="72dp"
        android:layout_height="96dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/img_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/v_book_poster_image_style"/>
        <com.newleaf.app.android.victor.view.SimpleStrokeTextView
            android:layout_gravity="start|bottom"
            android:id="@+id/tv_ranking"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginBottom="-16dp"
            android:layout_marginStart="-8dp"
            app:st_stroke_color="@color/color_141414"
            app:st_stroke_width="8dp"
            app:st_style="bold"
            app:st_text_color="@color/white"
            app:st_text_size="36sp"/>
    </FrameLayout>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_hot"
        app:layout_constraintStart_toEndOf="@+id/fl_img"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body_medium"/>
    <com.newleaf.app.android.victor.view.ItemFilterTagLayout
        android:orientation="horizontal"
        android:id="@+id/ll_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_hot"
        app:layout_constraintStart_toEndOf="@+id/fl_img"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name">
        <TextView
            android:textColor="@color/color_ffffff_alpha_70"
            android:ellipsize="end"
            android:id="@+id/tv_tag1"
            android:background="@drawable/bg_white15_r4"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Revenge"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            style="@style/caption_regular"/>
        <TextView
            android:textColor="@color/color_ffffff_alpha_70"
            android:ellipsize="end"
            android:id="@+id/tv_tag2"
            android:background="@drawable/bg_white15_r4"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Revenge"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            style="@style/caption_regular"/>
    </com.newleaf.app.android.victor.view.ItemFilterTagLayout>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_collect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/fl_img"
        app:layout_constraintStart_toEndOf="@+id/fl_img"
        style="@style/footnote_regular"/>
    <View
        android:id="@+id/v_divider"
        android:background="@color/line_divider"
        android:layout_width="1dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_collect"
        app:layout_constraintStart_toEndOf="@+id/tv_collect"
        app:layout_constraintTop_toTopOf="@+id/tv_collect"/>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_likes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/fl_img"
        app:layout_constraintStart_toEndOf="@+id/v_divider"
        style="@style/footnote_regular"/>
    <ImageView
        android:id="@+id/iv_hot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_hall_hot"
        app:layout_constraintBottom_toBottomOf="@+id/tv_hot"
        app:layout_constraintEnd_toStartOf="@+id/tv_hot"
        app:layout_constraintTop_toTopOf="@+id/tv_hot"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_hot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
