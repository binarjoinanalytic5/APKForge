<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_vote_head_layout_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/img_head"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:gravity="center_horizontal"
        android:id="@+id/tv_module_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="41dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="41dp"
        android:maxLines="1"
        android:layout_marginHorizontal="41dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="7sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="18sp"
        android:gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="41dp"
        android:layout_marginTop="39dp"
        android:layout_marginRight="41dp"
        android:maxLines="1"
        android:layout_marginHorizontal="41dp"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeMinTextSize="9sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.newleaf.app.android.victor.common.vote.VoteCountDownText
        android:textColor="@color/color_ccffd8b5"
        android:gravity="center_horizontal"
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="-2dp"
        android:layout_marginRight="10dp"
        android:maxLines="1"
        android:layout_marginHorizontal="10dp"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeMinTextSize="6sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/footnote_regular"/>
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_cover"
        android:layout_width="111dp"
        android:layout_height="148dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
        app:layout_goneMarginTop="54dp"
        app:radius="4dp"/>
    <ImageView
        android:id="@+id/iv_icon_play"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="5dp"
        android:src="@drawable/icon_vote_play"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
        app:layout_constraintEnd_toEndOf="@+id/iv_cover"/>
</androidx.constraintlayout.widget.ConstraintLayout>
