<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_content_parent"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_pic"
        android:tag="layout/view_foryou_continue_watch_card_layout_0"
        android:layout_width="48dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="2dp"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:tag="layout/view_foryou_continue_watch_card_layout_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_desc"
        app:layout_constraintEnd_toStartOf="@+id/iv_play"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_pic"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/body_bold"/>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:tag="layout/view_foryou_continue_watch_card_layout_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_play"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_pic"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/footnote_regular"/>
    <ImageView
        android:id="@+id/iv_play"
        android:tag="layout/view_foryou_continue_watch_card_layout_3"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/icon_foryou_continue_watch_card_play"
        android:contentDescription="@string/description_episode_status_play"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
