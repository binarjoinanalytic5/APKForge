<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout/fragment_actor_detail_0"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.newleaf.app.android.victor.view.CustomNestedScrollView
        android:id="@+id/scroll_layout"
        android:background="@color/color_black"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/fl_mask"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_blur_book_poster"
                    android:layout_width="match_parent"
                    android:layout_height="500dp"
                    android:scaleType="centerCrop"/>
                <View
                    android:id="@+id/v_blur_book_cover"
                    android:background="@drawable/bg_000000alpha50_to_000000_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="500dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_blur_book_poster"
                    app:layout_constraintTop_toTopOf="@+id/iv_blur_book_poster"/>
                <View
                    android:id="@+id/v_top_cover"
                    android:layout_width="match_parent"
                    android:layout_height="500dp"
                    app:layout_constraintTop_toTopOf="parent"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_detail"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="200dp"
                app:layout_constraintTop_toTopOf="parent">
                <com.newleaf.app.android.victor.view.UserAvatarView
                    android:id="@+id/iv_head"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="112dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:uaAvatarHeight="80dp"
                    app:uaAvatarWidth="80dp"/>
                <TextView
                    android:textColor="@color/texticon_primary"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:autoSizeMaxTextSize="@dimen/fontSize_2"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1px"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintBottom_toTopOf="@+id/tv_follow_num"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_head"
                    app:layout_constraintTop_toTopOf="@+id/iv_head"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/title1_bold"/>
                <TextView
                    android:textColor="@color/texticon_primary"
                    android:id="@+id/tv_follow_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_head"
                    app:layout_constraintStart_toEndOf="@+id/iv_head"
                    app:layout_constraintTop_toBottomOf="@+id/tv_name"
                    style="@style/footnote_regular"/>
                <TextView
                    android:textColor="@color/texticon_tertiary"
                    android:id="@+id/tv_follow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/actor_profile_header_followers_count"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_follow_num"
                    app:layout_constraintStart_toEndOf="@+id/tv_follow_num"
                    app:layout_constraintTop_toTopOf="@+id/tv_follow_num"
                    style="@style/footnote_regular"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/des_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_head">
                    <com.newleaf.app.android.victor.view.ExpandTextView2
                        android:textColor="@color/texticon_secondary"
                        android:id="@+id/tv_actor_des"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginHorizontal="16dp"
                        app:btnName="@string/more"
                        app:canCloseExpend="true"
                        app:canCollapsedClickable="true"
                        app:collapsedMaxLine="3"
                        app:expendMaxLine="1000"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:moreColor="@color/texticon_primary"
                        app:showMore="true"
                        style="@style/body_regular"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_ffffff_alpha_90"
                        android:id="@+id/tv_collapse"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/collapse"
                        app:layout_constraintEnd_toEndOf="@+id/tv_actor_des"
                        app:layout_constraintTop_toBottomOf="@+id/tv_actor_des"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_follow"
                    android:background="@drawable/bg_ffffff_alpha_90_corner4"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/des_layout">
                    <ImageView
                        android:id="@+id/iv_follow_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon_add"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btn_tv_follow"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="@color/texticon_black_normal"
                        android:gravity="center"
                        android:id="@+id/btn_tv_follow"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:maxLines="1"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_follow_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/body_medium"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_page"
                android:background="@drawable/bg_color_141414_left_top_right_top_r16"
                android:layout_width="match_parent"
                android:layout_height="800dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_detail">
                <TextView
                    android:textColor="@color/texticon_primary"
                    android:id="@+id/tv_episode_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/title3_bold"/>
                <androidx.constraintlayout.widget.Group
                    android:id="@+id/channel_tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="tv_hot,divider_line,tv_new"/>
                <TextView
                    android:textColor="@color/texticon_tertiary"
                    android:id="@+id/tv_hot"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/actor_profile_sort_tab_hottest"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/body_medium"/>
                <View
                    android:id="@+id/divider_line"
                    android:background="@color/texticon_quaternary"
                    android:layout_width="1dp"
                    android:layout_height="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_hot"
                    app:layout_constraintEnd_toStartOf="@+id/tv_hot"
                    app:layout_constraintTop_toTopOf="@+id/tv_hot"/>
                <TextView
                    android:textColor="@color/texticon_primary"
                    android:id="@+id/tv_new"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/actor_profile_sort_tab_newest"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_hot"
                    app:layout_constraintEnd_toStartOf="@+id/divider_line"
                    app:layout_constraintTop_toTopOf="@+id/tv_hot"
                    style="@style/body_medium"/>
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_episode_title"/>
                <com.newleaf.app.android.victor.view.LoadFailView
                    android:id="@+id/series_load_fail_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="500dp"
                    android:elevation="0.5dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_episode_title"
                    app:load_fail_view_bg_color="@color/transparent"
                    app:load_fail_view_can_click="true"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.newleaf.app.android.victor.view.CustomNestedScrollView>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:load_fail_view_bg_color="@color/color_141414"/>
    <include
        android:id="@+id/title_bar"
        layout="@layout/include_title_transparent_background_bar"/>
</FrameLayout>
