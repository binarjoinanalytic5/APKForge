<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_new_bind_email_layout_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_root"
        android:background="@drawable/bg_new_bind_email_dialog"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="315dp"
        android:layout_height="326dp">
        <View
            android:id="@+id/bg_stroke"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_primary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="16dp"
            android:text="@string/new_bind_email_dialog_title"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/title2_bold"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/cl_bind_button"
            android:background="@drawable/bg_e52e2e_corner_4"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="283dp"
            android:layout_height="48dp"
            android:layout_marginBottom="17dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_bind_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_bind_email_dialog_action"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform"
                style="@style/body_bold"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:src="@drawable/icon_dialog_close_32"
        android:contentDescription="@string/description_close"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="@+id/cl_root"
        app:layout_constraintStart_toStartOf="@+id/cl_root"
        app:layout_constraintTop_toBottomOf="@+id/cl_root"/>
</androidx.constraintlayout.widget.ConstraintLayout>
