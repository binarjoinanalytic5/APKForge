<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_saved"
        android:tag="layout/view_preference_saved_tip_0"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_preference_saved"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_message"
        android:tag="layout/view_preference_saved_tip_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/preference_recorded_success_hint"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_setting"
        app:layout_constraintStart_toEndOf="@+id/iv_saved"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/footnote_regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_yellow_normal"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_setting"
        android:tag="layout/view_preference_saved_tip_2"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:maxWidth="74dp"
        android:text="@string/preference_setting"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/footnote_medium"/>
</merge>
