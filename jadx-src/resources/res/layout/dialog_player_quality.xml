<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_player_quality_0"
    android:background="@drawable/bg_141414_top_corner_16"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/quality"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/fl_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/icon_close_more"
        android:contentDescription="@string/description_close"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dialog_quality"
        android:background="@drawable/bg_292929_corner_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_close">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/more_quality_4K"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_4K"
                android:visibility="invisible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_select"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#b2ffffff"
                android:id="@+id/tv_4K"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4K"
                android:layout_marginStart="8dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_vip_mark_4K"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:paddingStart="8dp">
                <TextView
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="#fffde9d2"
                    android:gravity="center"
                    android:id="@+id/tv_Ultra"
                    android:background="@drawable/bg_quality_option_full_mark"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:text="ULTRA HD"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_292929"
                    android:gravity="center"
                    android:id="@+id/tv_vip_text_4K"
                    android:background="@drawable/bg_quality_vip_mark"
                    android:layout_width="25dp"
                    android:layout_height="18dp"
                    android:text="VIP"/>
            </LinearLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/tv_limited4k"
                android:background="@drawable/bg_limited_free"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/limited_free"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/more_quality_2K"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_2K"
                android:visibility="invisible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_select"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#b2ffffff"
                android:id="@+id/tv_2K"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2K"
                android:layout_marginStart="8dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_vip_mark_2K"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:paddingStart="8dp">
                <TextView
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="#fffde9d2"
                    android:gravity="center"
                    android:id="@+id/tv_Quad"
                    android:background="@drawable/bg_quality_option_full_mark"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:text="QUAD HD"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_292929"
                    android:gravity="center"
                    android:id="@+id/tv_vip_text_2K"
                    android:background="@drawable/bg_quality_vip_mark"
                    android:layout_width="25dp"
                    android:layout_height="18dp"
                    android:text="VIP"/>
            </LinearLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/tv_limited2k"
                android:background="@drawable/bg_limited_free"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/limited_free"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/more_quality_1080P"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_1080"
                android:visibility="invisible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_select"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#b2ffffff"
                android:id="@+id/tv_1080"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080P"
                android:layout_marginStart="8dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_vip_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:paddingStart="8dp">
                <TextView
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="#fffde9d2"
                    android:gravity="center"
                    android:id="@+id/tv_full"
                    android:background="@drawable/bg_quality_option_full_mark"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:text="FULL HD"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_292929"
                    android:gravity="center"
                    android:id="@+id/tv_vip"
                    android:background="@drawable/bg_quality_vip_mark"
                    android:layout_width="25dp"
                    android:layout_height="18dp"
                    android:text="VIP"/>
            </LinearLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/tv_limited"
                android:background="@drawable/bg_limited_free"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/limited_free"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/more_quality_720P"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_720"
                android:visibility="invisible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_select"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#b2ffffff"
                android:id="@+id/tv_720"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="720P"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/more_quality_540P"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_540"
                android:visibility="invisible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_select"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#b2ffffff"
                android:id="@+id/tv_540"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="540P"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/more_quality_360P"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_360"
                android:visibility="invisible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_select"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#b2ffffff"
                android:id="@+id/tv_360"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="360P"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/more_quality_auto"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_auto"
                android:visibility="invisible"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_select"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#b2ffffff"
                android:id="@+id/tv_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
