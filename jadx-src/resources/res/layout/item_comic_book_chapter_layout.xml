<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/item_comic_book_chapter_layout_0"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_chapter_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_underline_price"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"
        style="@style/body_regular"/>
    <ImageView
        android:id="@+id/iv_coins"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/icon_reward_floating_coins"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_unlock_amount"
        app:layout_constraintEnd_toStartOf="@+id/tv_unlock_amount"
        app:layout_constraintTop_toTopOf="@+id/tv_unlock_amount"/>
    <com.newleaf.app.android.victor.view.ObliqueLineTextView
        android:textColor="#ff5a5a5a"
        android:ellipsize="end"
        android:id="@+id/tv_underline_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="2dp"
        app:YOffset="-1dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_unlock_amount"
        app:layout_constraintEnd_toStartOf="@+id/iv_coins"
        app:layout_constraintTop_toTopOf="@+id/tv_unlock_amount"
        app:lineColor="#ff5a5a5a"
        app:lineStyle="styleHorizontalCenter"
        app:lineWidth="1dp"
        style="@style/footnote_regular"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_unlock_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/footnote_regular"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_unlock_mark"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_coins,tv_unlock_amount,tv_underline_price"/>
</androidx.constraintlayout.widget.ConstraintLayout>
