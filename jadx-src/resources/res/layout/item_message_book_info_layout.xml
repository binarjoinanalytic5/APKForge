<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_message_book_info_layout_0"
    android:background="@drawable/bg_background3_corner4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/iv_red_point"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="12dp"
        style="@style/body_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_red_point"
        android:background="@drawable/shape_home_tab_red_point"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/line_outline"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="67dp"
        android:layout_height="90dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_line"
        app:radius="2dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_secondary"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/ll_tag"
        app:layout_constraintEnd_toStartOf="@+id/iv_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/body_medium"/>
    <com.newleaf.app.android.victor.view.ItemFilterTagLayout
        android:orientation="horizontal"
        android:id="@+id/ll_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_actor"
        app:layout_constraintEnd_toStartOf="@+id/iv_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_book_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name">
        <TextView
            android:textColor="@color/texticon_secondary"
            android:ellipsize="end"
            android:id="@+id/tv_tag1"
            android:background="@drawable/bg_white15_r4"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            style="@style/caption_medium"/>
        <TextView
            android:textColor="@color/texticon_secondary"
            android:ellipsize="end"
            android:id="@+id/tv_tag2"
            android:background="@drawable/bg_white15_r4"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            style="@style/caption_medium"/>
    </com.newleaf.app.android.victor.view.ItemFilterTagLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_actor"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toStartOf="@+id/iv_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_book_poster"
        app:layout_constraintTop_toBottomOf="@+id/ll_tag">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_actor_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_tertiary"
            android:ellipsize="end"
            android:id="@+id/tv_actor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_actor_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_actor_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_actor_icon"
            app:layout_goneMarginEnd="12dp"
            app:layout_goneMarginStart="8dp"
            style="@style/footnote_regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/icon_white_border_player"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"/>
</androidx.constraintlayout.widget.ConstraintLayout>
