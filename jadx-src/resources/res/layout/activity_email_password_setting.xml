<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/activity_email_password_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/space"
        layout="@layout/include_statusbar_space"/>
    <View
        android:id="@+id/bg_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_exit"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/icon_return"
        android:contentDescription="@string/description_back"
        android:layout_marginStart="6dp"
        android:paddingVertical="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_exit">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/largetitle_bold"/>
            <TextView
                android:textColor="@color/texticon_secondary"
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/body_regular"/>
            <TextView
                android:textColor="@color/texticon_secondary"
                android:id="@+id/tv_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="16dp"
                android:text="@string/password_text"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
                style="@style/footnote_regular"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_input_password_view"
                android:background="@drawable/login_edittext_bg_selector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_password">
                <androidx.appcompat.widget.AppCompatEditText
                    android:textColor="@color/texticon_primary"
                    android:textColorHint="@color/texticon_quaternary"
                    android:id="@+id/et_input_password"
                    android:background="@null"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:hint="@string/enter_password"
                    android:inputType="textPassword"
                    android:textCursorDrawable="@drawable/search_edit_cursor"
                    android:paddingHorizontal="16dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/iv_input_password_eye"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/body_regular"/>
                <ImageView
                    android:id="@+id/iv_input_password_eye"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/password_visible_selector"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textColor="@color/texticon_secondary"
                android:id="@+id/tv_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="16dp"
                android:text="@string/confirm_password"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_input_password_view"
                style="@style/footnote_regular"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_confirm_input_password_view"
                android:background="@drawable/login_edittext_bg_selector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_confirm_password">
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="14sp"
                    android:textColor="@color/texticon_primary"
                    android:textColorHint="@color/texticon_quaternary"
                    android:id="@+id/et_confirm_input_password"
                    android:background="@null"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:hint="@string/enter_password_again"
                    android:inputType="textPassword"
                    android:textCursorDrawable="@drawable/search_edit_cursor"
                    android:paddingHorizontal="16dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/iv_confirm_input_password_eye"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/iv_confirm_input_password_eye"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/password_visible_selector"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textColor="@color/texticon_tertiary"
                android:id="@+id/tv_password_rules_tips"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="16dp"
                android:text="@string/email_password_rules"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_input_password_view"
                style="@style/footnote_regular"/>
            <TextView
                android:textColor="@color/texticon_brand_normal"
                android:id="@+id/tv_confirm_password_error_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="16dp"
                android:text="@string/two_passwords_must_be_the_same"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_confirm_input_password_view"
                style="@style/footnote_medium"/>
            <TextView
                android:enabled="false"
                android:textColor="@drawable/email_code_button_text_selector"
                android:gravity="center"
                android:id="@+id/tv_next"
                android:background="@drawable/email_code_button_bg_selector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="16dp"
                android:text="@string/continue_btn"
                android:contentDescription="@string/continue_btn"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_confirm_input_password_view"
                style="@style/body_bold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
