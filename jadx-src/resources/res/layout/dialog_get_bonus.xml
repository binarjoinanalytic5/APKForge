<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_get_bonus_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:scaleType="center"
        android:minHeight="400dp"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintDimensionRatio="330:440"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="10dp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/icon_dialog_close_32"
        android:contentDescription="@string/cancel"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_img"
        app:layout_constraintTop_toTopOf="@+id/iv_img"/>
    <TextView
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#fffff6d7"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:text="@string/earn_rewards_dialog_title"
        android:maxLines="2"
        android:lines="2"
        app:layout_constraintEnd_toEndOf="@+id/iv_img"
        app:layout_constraintStart_toStartOf="@+id/iv_img"
        app:layout_constraintTop_toTopOf="@+id/iv_img"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/goto_earn"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginLeft="43dp"
        android:layout_marginRight="43dp"
        android:layout_marginBottom="38dp"
        android:text="@string/goto_earn_rewards_page"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="43dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_img"
        app:layout_constraintEnd_toEndOf="@+id/iv_img"
        app:layout_constraintStart_toStartOf="@+id/iv_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
