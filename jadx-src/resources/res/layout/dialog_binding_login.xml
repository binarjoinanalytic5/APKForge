<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_binding_login_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_content"
        android:background="@drawable/bg_222222_corner_15"
        android:paddingBottom="30dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="360dp"
        app:layout_constraintWidth_min="250dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_bind_login_top"/>
        <TextView
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/binding_notice"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="37dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="37dp"
            android:text="@string/binding_tips"
            android:layout_marginHorizontal="37dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/tv_bind"
            android:background="@drawable/bg_fe4167_corner_4"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="58dp"
            android:layout_marginTop="31dp"
            android:layout_marginRight="58dp"
            android:text="@string/binding_account"
            android:layout_marginHorizontal="58dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:src="@drawable/icon_dialog_close_32"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="@+id/ll_content"
        app:layout_constraintStart_toStartOf="@+id/ll_content"
        app:layout_constraintTop_toBottomOf="@+id/ll_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
