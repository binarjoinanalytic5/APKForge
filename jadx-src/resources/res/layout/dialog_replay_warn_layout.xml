<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_replay_warn_layout_0"
    android:background="@drawable/bg_363636_corner_5"
    android:paddingBottom="24dp"
    android:layout_width="345dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/white"
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:text="@string/interact_tips"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="36dp"
        android:text="@string/replay_tips_content"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_title"/>
    <Button
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:id="@+id/btn_dialog_left"
        android:background="@drawable/bg_solid_ffffff_alpha20_corners_6_shape"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:text="@string/yes"
        android:textAllCaps="false"
        android:layout_marginStart="36dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_dialog_right"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_content"/>
    <Button
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/btn_dialog_right"
        android:background="@drawable/bg_solid_ffffff_alpha20_corners_6_shape"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/no"
        android:textAllCaps="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_dialog_left"
        app:layout_constraintTop_toTopOf="@+id/btn_dialog_left"/>
</androidx.constraintlayout.widget.ConstraintLayout>
