<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/main_contain"
    android:tag="layout/layout_exit_recommend_book_0"
    android:background="@drawable/bg_backgrounds_background_2_r12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:gravity="center_vertical"
        android:id="@+id/tv_recommend_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/return_recommendation_title"
        android:maxLines="2"
        android:includeFontPadding="false"
        app:autoSizeMaxTextSize="@dimen/fontSize_4"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/title3_bold"/>
    <com.newleaf.app.android.victor.view.MaxDialogHeightNestedScrollView
        android:id="@+id/nsv_recommend_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_recommend_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rlv_list"
                android:paddingLeft="0.5dp"
                android:paddingRight="0.5dp"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="330dp"
                android:overScrollMode="never"
                android:paddingHorizontal="0.5dp"/>
            <TextView
                android:textColor="@color/texticon_primary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_book_name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:maxLines="2"
                android:lines="2"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rlv_list"
                style="@style/title2_bold"/>
            <com.newleaf.app.android.victor.view.ExpandableFlowLayout
                android:id="@+id/theme_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:childSpacing="4dp"
                app:childSpacingForLastRow="align"
                app:hGravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_min="22dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_book_name"
                app:maxRows="1"
                app:supportExpand="false"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.newleaf.app.android.victor.view.MaxDialogHeightNestedScrollView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:gravity="center"
        android:id="@+id/exit_btn"
        android:background="@drawable/bg_button_secondary_normal_r4"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="21dp"
        android:text="@string/exit"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:paddingHorizontal="10dp"
        app:autoSizeMaxTextSize="@dimen/fontSize_7"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fl_play_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nsv_recommend_list"
        style="@style/body_bold"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/fl_play_btn"
        android:background="@drawable/bg_button_brand_normal_r4"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="21dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/exit_btn">
        <ImageView
            android:id="@+id/iv_watch"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_book_16"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_primary"
            android:gravity="center_vertical"
            android:id="@+id/tv_watch_tips"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/read_now"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            app:autoSizeMaxTextSize="@dimen/fontSize_7"
            app:autoSizeMinTextSize="1sp"
            app:autoSizeStepGranularity="1px"
            app:autoSizeTextType="uniform"
            style="@style/body_bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
