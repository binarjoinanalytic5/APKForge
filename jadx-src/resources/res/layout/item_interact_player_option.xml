<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_interact_player_option_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.interackPlayer.view.InteractOptionLayout
        android:layout_gravity="center"
        android:id="@+id/fl_option"
        android:layout_width="330dp"
        android:layout_height="50dp">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/img_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_loop="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="start|center_vertical"
            android:tag="binding_1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:elevation="0.5dp"
            android:paddingHorizontal="16dp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="1sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ll_coins"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_coins"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_coins"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_new_coin_24"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/color_white50"
                android:id="@+id/tv_coins_org"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_white"
            android:id="@+id/tv_coins"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/ll_coins"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_coins"/>
        <View
            android:id="@+id/view_line"
            android:background="@color/color_white"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:rotation="4"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/ll_coins"
            app:layout_constraintEnd_toEndOf="@+id/ll_coins"
            app:layout_constraintStart_toStartOf="@+id/ll_coins"
            app:layout_constraintTop_toTopOf="@+id/ll_coins"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_card_view"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_icon_card"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_interact_potion_card"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_card_num"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/white"
                android:id="@+id/tv_card_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/body_medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.newleaf.app.android.victor.interackPlayer.view.InteractOptionLayout>
</FrameLayout>
