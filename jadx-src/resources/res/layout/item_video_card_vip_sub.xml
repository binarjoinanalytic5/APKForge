<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_video_card_vip_sub_0"
    android:background="@color/backgrounds_background_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_head"
        android:clipChildren="false"
        android:layout_width="375dp"
        android:layout_height="375dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_head_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_video_card_vip_sub_head"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <View
        android:id="@+id/view_top_mask"
        android:layout_width="match_parent"
        android:layout_height="375dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_text_mask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <View
        android:id="@+id/view_content_bg"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        app:layout_constraintBottom_toTopOf="@+id/include_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="#ffffe5c0"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="340dp"
        android:layout_marginRight="16dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/mediumtitle_bold"/>
    <ImageView
        android:id="@+id/iv_line"
        android:layout_width="329dp"
        android:layout_height="10dp"
        android:layout_marginTop="17dp"
        android:src="@drawable/icon_vip_interests_line"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.newleaf.app.android.victor.view.AutoPollRecyclerView
        android:id="@+id/rv_interests"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="519dp"
        android:layout_height="140dp"
        android:layout_marginTop="24dp"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_line"/>
    <View
        android:id="@+id/view_left_wide_mask"
        android:visibility="gone"
        android:layout_width="180dp"
        android:layout_height="296dp"
        android:layout_marginTop="520dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_right_wide_mask"
        android:visibility="gone"
        android:layout_width="180dp"
        android:layout_height="296dp"
        android:layout_marginTop="520dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_btn_bg"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:scaleType="fitXY"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_content_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_content_bg"
        app:layout_constraintStart_toStartOf="@+id/view_content_bg"/>
    <TextView
        android:textColor="#ff401a06"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_btn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_content_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_content_bg"
        app:layout_constraintStart_toStartOf="@+id/view_content_bg"
        style="@style/body_bold"/>
    <FrameLayout
        android:id="@+id/load_layout"
        android:background="@color/backgrounds_background_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/load_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:lottie_autoPlay="false"
            app:lottie_fileName="novel_loading_night.json"
            app:lottie_loop="true"/>
    </FrameLayout>
    <include
        android:id="@+id/include_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/include_layout_video_card_bottom_view"/>
    <include
        android:id="@+id/title_bar"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_title_transparent_background_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
