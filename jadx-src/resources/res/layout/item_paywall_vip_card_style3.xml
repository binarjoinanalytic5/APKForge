<?xml version="1.0" encoding="utf-8"?>
<com.newleaf.app.android.victor.view.roundview.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:tag="layout/item_paywall_vip_card_style3_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rRadius="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="77dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_crown_20"
            app:layout_constraintBottom_toBottomOf="@+id/text_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/text_container"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/ll_price"
            app:layout_constraintStart_toEndOf="@+id/iv_icon"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/color_401a06"
                android:ellipsize="end"
                android:id="@+id/tv_vip_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                style="@style/body_bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="#b3401a06"
                android:id="@+id/tv_vip_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:includeFontPadding="false"
                style="@style/footnote_regular"/>
        </LinearLayout>
        <android.widget.LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_price"
            android:layout_width="84dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.newleaf.app.android.victor.view.PriceAnimTextView
                android:textColor="@color/color_401a06"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_vip_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:autoSizeMaxTextSize="@dimen/fontSize_4"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1px"
                app:autoSizeTextType="uniform"
                app:priceAniDuration="1000"
                style="@style/headline_medium"/>
            <com.newleaf.app.android.victor.view.ObliqueLineTextView
                android:textColor="#80401a06"
                android:id="@+id/tv_vip_underline_price"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:autoSizeMaxTextSize="@dimen/fontSize_11"
                app:autoSizeMinTextSize="5sp"
                app:autoSizeStepGranularity="1px"
                app:autoSizeTextType="uniform"
                app:lineColor="#80401a06"
                app:lineStyle="styleHorizontalCenter"
                app:lineWidth="1dp"
                style="@style/caption_regular"/>
        </android.widget.LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_mark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.newleaf.app.android.victor.view.CountDownText
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_vip_count_down_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            app:autoSizeMaxTextSize="10sp"
            app:autoSizeMinTextSize="4sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            style="@style/caption_medium"/>
        <View
            android:id="@+id/v_dividing_line"
            android:background="@color/texticon_quaternary"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"/>
        <TextView
            android:textColor="@color/texticon_primary"
            android:gravity="center_vertical"
            android:id="@+id/tv_vip_text_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            style="@style/caption_medium"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/footer_container"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_container">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="#80401a06"
            android:gravity="center_vertical"
            android:id="@+id/tv_vip_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            style="@style/caption_regular"/>
    </FrameLayout>
    <View
        android:id="@+id/view_shimmer"
        android:background="@drawable/img_vip_shimmer"
        android:visibility="gone"
        android:layout_width="236dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.newleaf.app.android.victor.view.roundview.RoundConstraintLayout>
