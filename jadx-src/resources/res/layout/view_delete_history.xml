<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/title_view"
        android:tag="layout/view_delete_history_0"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_title"
        android:tag="layout/view_delete_history_1"
        android:background="@color/color_000000"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@+id/title_view">
        <TextView
            android:textColor="@color/texticon_primary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/table_history"
            android:paddingHorizontal="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/title3_bold"/>
        <TextView
            android:textColor="@color/texticon_primary"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/body_medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_delete"
        android:tag="layout/view_delete_history_2"
        android:background="@color/color_000000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_bottom_navigation_height"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout
            android:id="@+id/fl_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_select_all"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_select_all">
            <CheckBox
                android:layout_gravity="center"
                android:id="@+id/cb_check_all"
                android:background="@drawable/check_delete_all2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:button="@null"/>
        </FrameLayout>
        <TextView
            android:textColor="@color/color_ffffff_alpha_90"
            android:gravity="center_vertical"
            android:id="@+id/tv_select_all"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/select_all"
            app:layout_constraintStart_toEndOf="@+id/fl_select_all"
            style="@style/headline_medium"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_delete"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="5dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:id="@+id/img_icon_delete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/icon_dialog_delete_none"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textColor="@color/color_ffffff_alpha_30"
                android:id="@+id/tv_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                style="@style/headline_medium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
