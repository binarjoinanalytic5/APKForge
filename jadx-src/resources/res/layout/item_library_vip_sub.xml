<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_vip_sub"
    android:tag="layout/item_library_vip_sub_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent">
    <View
        android:id="@+id/view_vip_bg"
        android:background="@drawable/bg_library_item_vip_sub_shape"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_vip_sub"
        app:layout_constraintTop_toTopOf="@+id/tv_vip_sub"/>
    <ImageView
        android:id="@+id/iv_vip_img"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icon_vip_membership"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_vip_sub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_vip_sub"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/color_401906"
        android:gravity="center_vertical"
        android:id="@+id/tv_vip_sub"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:minHeight="40dp"
        android:maxLines="2"
        android:layout_marginHorizontal="4dp"
        android:paddingVertical="8dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/iv_right_arrow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_vip_img"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_right_arrow"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/icon_right_arrow_brown"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_vip_sub"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_vip_sub"/>
    <View
        android:id="@+id/view_place2"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_vip_sub"/>
</androidx.constraintlayout.widget.ConstraintLayout>
