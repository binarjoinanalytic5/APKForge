<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_container"
    android:tag="layout/view_new_player_panel_0"
    android:background="@color/color_black65"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_title"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/title_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/fl_back"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:layout_width="56dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/icon_return"
            android:contentDescription="@string/description_back"
            android:paddingHorizontal="18dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/unlock_container_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_white90"
            android:gravity="center"
            android:id="@+id/tv_unlock_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:maxLines="3"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            android:layout_marginHorizontal="32dp"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="1sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@+id/tv_sub_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/title1_bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_tertiary"
            android:gravity="center"
            android:id="@+id/tv_sub_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="32dp"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.88"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintBottom_toBottomOf="@+id/rv_unlock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_unlock_title"
            style="@style/footnote_regular"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sub_title"
            app:layout_goneMarginTop="24dp"/>
        <CheckBox
            android:textSize="12sp"
            android:textColor="@color/color_ffffff_alpha_50"
            android:id="@+id/checkbox"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="108dp"
            android:checked="false"
            android:button="@null"
            android:text="@string/auto_unlock"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:lineSpacingMultiplier="0.95"
            android:drawableStart="@drawable/checkbox_selector_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ViewStub
            android:id="@+id/vs_balance_panel"
            android:layout="@layout/view_unlock_panel_balance_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
