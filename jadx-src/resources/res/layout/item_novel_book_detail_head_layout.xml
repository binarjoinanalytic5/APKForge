<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_novel_book_detail_head_layout_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/top_space"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_statusbar_space"/>
    <ImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_marginTop="60dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_space"
        app:radius="4dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:gravity="center"
        android:id="@+id/tv_book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/title1_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_tertiary"
        android:gravity="center"
        android:id="@+id/tv_author_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/footnote_regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_tertiary"
        android:gravity="center"
        android:id="@+id/tv_publisher_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_author_name"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/footnote_regular"/>
    <View
        android:id="@+id/v_watch_top_divider"
        android:background="@color/line_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_publisher_name"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_watched"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/ll_collect"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_watch_top_divider">
        <TextView
            android:textColor="@color/texticon_primary"
            android:id="@+id/tv_watched_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/title3_bold"/>
        <TextView
            android:textColor="@color/texticon_tertiary"
            android:id="@+id/tv_watched_lab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manga_detailed_views"
            style="@style/caption_regular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_collect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/ll_watched"
        app:layout_constraintEnd_toStartOf="@+id/ll_words"
        app:layout_constraintStart_toEndOf="@+id/ll_watched"
        app:layout_constraintTop_toTopOf="@+id/ll_watched">
        <TextView
            android:textColor="@color/texticon_primary"
            android:id="@+id/tv_collect_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/title3_bold"/>
        <TextView
            android:textColor="@color/texticon_tertiary"
            android:id="@+id/tv_collect_lab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manga_detailed_favorites"
            style="@style/caption_regular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_words"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_watched"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll_collect"
        app:layout_constraintTop_toTopOf="@+id/ll_watched">
        <TextView
            android:textColor="@color/texticon_primary"
            android:id="@+id/tv_words_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/title3_bold"/>
        <TextView
            android:textColor="@color/texticon_tertiary"
            android:id="@+id/tv_words_lab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/content_detailed_words"
            style="@style/caption_regular"/>
    </LinearLayout>
    <View
        android:id="@+id/v_watch_bottom_divider"
        android:background="@color/line_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_watched"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_tag_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:text="@string/introduction"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_watch_bottom_divider"
        style="@style/title3_bold"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rlv_tags"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_tag_title"/>
    <com.newleaf.app.android.victor.view.ExpandTextView2
        android:textColor="@color/texticon_secondary"
        android:id="@+id/tv_book_des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:btnName="@string/more"
        app:canCloseExpend="true"
        app:canCollapsedClickable="true"
        app:collapsedMaxLine="3"
        app:expendMaxLine="1000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rlv_tags"
        app:moreColor="@color/texticon_primary"
        app:showMore="true"
        style="@style/body_regular"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_collapse"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/collapse"
        app:layout_constraintEnd_toEndOf="@+id/tv_book_des"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_des"
        style="@style/body_medium"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_book_update_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_collapse"
        app:layout_goneMarginTop="24dp"
        style="@style/title3_bold"/>
    <TextView
        android:textColor="@color/texticon_secondary"
        android:id="@+id/tv_book_update_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_update_status"
        style="@style/footnote_regular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rlv_episode"
        android:background="@color/button_secondary_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_update_time"/>
    <androidx.legacy.widget.Space
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@+id/rlv_episode"/>
</androidx.constraintlayout.widget.ConstraintLayout>
