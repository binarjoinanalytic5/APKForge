<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:tag="layout/activity_notification_string_progress_bar_b_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/v_notification_card_view">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_content"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"
                android:layout_width="355dp"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_logo"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@mipmap/ic_launcher_round"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_logo_text"
                        app:tint="@color/color_000000_to_ffffff"
                        style="@style/v_notification_logo_image_word_art"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_gravity="center"
                                android:id="@+id/tv_tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                style="@style/v_notification_tag"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_222222_to_ffffff"
                                android:ellipsize="end"
                                android:id="@+id/tv_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"/>
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14sp"
                            android:textColor="@color/color_333333_to_ccffffff"
                            android:ellipsize="end"
                            android:id="@+id/tv_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="3"/>
                    </LinearLayout>
                    <com.newleaf.app.android.victor.view.RoundImageView
                        android:id="@+id/iv_big_image"
                        android:layout_width="56dp"
                        android:layout_height="75dp"
                        android:scaleType="centerCrop"
                        android:layout_marginStart="8dp"
                        app:radius="6dp"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/determinateBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:contentDescription="@string/description_episode_progress_bar"
                    style="@style/v_notification_full_intent_seek_view"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:layout_width="170dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/icon_remote_views_otification_play"/>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="end"
                android:id="@+id/fl_close"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_close_full_intent"
                    android:contentDescription="@string/description_close"
                    app:tint="@color/color_000000_to_ffffff"/>
            </FrameLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
