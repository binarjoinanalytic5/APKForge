<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:tag="layout/activity_notification_top_image_bottom_string_b_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/v_notification_card_view">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_width="355dp"
                    android:layout_height="200dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_big_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                    <LinearLayout
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_logo"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@mipmap/ic_launcher_round"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_logo_text"
                            android:src="@drawable/icon_logo_reelshort"
                            style="@style/v_notification_logo_image_word_art"/>
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp"
                    android:layout_width="355dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_gravity="center"
                            android:id="@+id/tv_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            style="@style/v_notification_tag"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_222222_to_ffffff"
                            android:ellipsize="end"
                            android:id="@+id/tv_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textColor="@color/color_333333_to_ccffffff"
                        android:ellipsize="end"
                        android:id="@+id/tv_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.5dp"
                        android:maxLines="2"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="end"
                android:id="@+id/fl_close"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_close_full_intent"
                    android:contentDescription="@string/description_close"/>
            </FrameLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
    <include
        android:id="@+id/included_button"
        android:layout_width="355dp"
        android:layout_height="wrap_content"
        layout="@layout/include_remote_views_notification_activity_button_b"/>
</LinearLayout>
