<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_search_history_0"
    android:paddingTop="18dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/texticon_secondary_active"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_history"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/headline_regular"/>
    <ImageView
        android:id="@+id/delete_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/story_delete_icon"
        android:contentDescription="@string/description_delete_search_history"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_white"
        android:id="@+id/cancel_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_text"
        app:layout_constraintEnd_toStartOf="@+id/line"
        app:layout_constraintTop_toTopOf="@+id/title_text"/>
    <View
        android:id="@+id/line"
        android:background="@color/color_white30"
        android:visibility="gone"
        android:layout_width="0.5dp"
        android:layout_height="16dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_text"
        app:layout_constraintEnd_toStartOf="@+id/delete_all_btn"
        app:layout_constraintTop_toTopOf="@+id/title_text"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_e83a57"
        android:id="@+id/delete_all_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/delete_all"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_text"/>
    <com.newleaf.app.android.victor.search.view.SearchHistoryFlowLayout
        android:id="@+id/history_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:default_expand_status="false"
        app:default_show_row="2"
        app:element_divider_horizontal="12dp"
        app:element_divider_vertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
