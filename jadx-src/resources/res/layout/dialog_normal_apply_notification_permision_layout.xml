<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_normal_apply_notification_permision_layout_0"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_sub_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="360dp"
        app:layout_constraintWidth_min="250dp">
        <View
            android:id="@+id/view_backgroud"
            android:background="@drawable/gradient_222222_to_363636_corners_15_bg_shape"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_place"
            app:layout_constraintTop_toTopOf="@+id/iv_head_img"/>
        <ImageView
            android:id="@+id/iv_head_img"
            android:layout_width="217dp"
            android:layout_height="165dp"
            android:src="@drawable/icon_push_permission_bonus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_decoration_img"
            android:layout_width="74dp"
            android:layout_height="125dp"
            android:src="@drawable/icon_push_permission_decoration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_head_img"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_desc1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:text="@string/normal_apply_notification_desc1"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintEnd_toEndOf="@+id/view_backgroud"
            app:layout_constraintStart_toStartOf="@+id/view_backgroud"
            app:layout_constraintTop_toBottomOf="@+id/iv_head_img"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_desc2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="17dp"
            android:layout_marginRight="15dp"
            android:text="@string/normal_apply_notification_desc2"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintEnd_toEndOf="@+id/view_backgroud"
            app:layout_constraintStart_toStartOf="@+id/view_backgroud"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc1"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_turn_on"
            android:background="@drawable/bg_e83a57_corner_4"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_marginTop="25dp"
            android:text="@string/turn_on"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc2"/>
        <View
            android:id="@+id/view_place"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_turn_on"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:src="@drawable/icon_dialog_close_32"
        android:contentDescription="@string/description_close"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="@+id/cl_sub_view"
        app:layout_constraintStart_toStartOf="@+id/cl_sub_view"
        app:layout_constraintTop_toBottomOf="@+id/cl_sub_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
