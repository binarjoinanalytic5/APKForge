<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item_root"
    android:tag="layout/item_playing_detail_series_book_0"
    android:background="@drawable/bg_backgrounds_background_3_r4"
    android:layout_width="300dp"
    android:layout_height="96dp"
    android:paddingEnd="8dp">
    <com.newleaf.app.android.victor.view.roundview.RoundFrameLayout
        android:id="@+id/fl_poster"
        android:layout_width="72dp"
        android:layout_height="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rLeftRadius="4dp">
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/iv_book_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <View
            android:id="@+id/v_playing_mask"
            android:background="@drawable/bg_mask_mask_left_corner4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.newleaf.app.android.victor.view.SLoadingIndicatorView2
            android:layout_gravity="center"
            android:id="@+id/iv_play"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/play"
            app:s_indicator="LineScalePulseOutWave"
            app:s_indicator_color="@color/color_white"/>
    </com.newleaf.app.android.victor.view.roundview.RoundFrameLayout>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fl_poster"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body_medium"/>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_book_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fl_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name"
        style="@style/footnote_regular"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/fl_poster"
        style="@style/footnote_regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
