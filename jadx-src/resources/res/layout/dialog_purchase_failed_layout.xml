<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_purchase_failed_layout_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="360dp"
        app:layout_constraintWidth_min="250dp">
        <View
            android:id="@+id/v_bg"
            android:background="@drawable/bg_dialog_background_3_corner16"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="60dp"
            android:minWidth="300dp"
            app:layout_constraintBottom_toBottomOf="@+id/space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/texticon_primary"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="128dp"
            android:text="@string/purchase_failed_title"
            app:layout_constraintEnd_toEndOf="@+id/v_bg"
            app:layout_constraintStart_toStartOf="@+id/v_bg"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/texticon_secondary"
            android:gravity="center_horizontal"
            android:id="@+id/tv_des"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/purchase_fail_des"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="@+id/v_bg"
            app:layout_constraintStart_toStartOf="@+id/v_bg"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/texticon_primary"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_fb"
            android:background="@drawable/bg_e52e2e_corner_4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/feedback"
            android:singleLine="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="@+id/v_bg"
            app:layout_constraintStart_toStartOf="@+id/v_bg"
            app:layout_constraintTop_toBottomOf="@+id/tv_des"/>
        <Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_fb"/>
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/icon_purchase_fail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_close"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:src="@drawable/icon_dialog_close_32"
        android:contentDescription="@string/description_close"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="@+id/cl_content"
        app:layout_constraintStart_toStartOf="@+id/cl_content"
        app:layout_constraintTop_toBottomOf="@+id/cl_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
