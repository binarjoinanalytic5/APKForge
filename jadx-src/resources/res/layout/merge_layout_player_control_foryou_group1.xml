<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_ad_measurement"
        android:tag="layout/merge_layout_player_control_foryou_group1_0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_details"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_details"
        android:tag="layout/merge_layout_player_control_foryou_group1_1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_detaile_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="0dp">
        <com.newleaf.app.android.victor.view.BookMarkView
            android:textSize="12sp"
            android:id="@+id/book_mark_view"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:lineSpacingMultiplier="0.88"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:bmv_radius="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginTop="12dp"
            style="@style/v_book_mark_style"/>
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/img_details_poster"
            android:visibility="gone"
            android:layout_width="33dp"
            android:layout_height="44dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/book_mark_view"
            app:layout_goneMarginTop="0dp"
            style="@style/v_book_poster_image_style"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_detail"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_details_poster"
            app:layout_constraintTop_toTopOf="@+id/img_details_poster"
            app:layout_goneMarginStart="0dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_white90"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:drawablePadding="4dp"
                android:lineSpacingMultiplier="0.88"
                android:drawableEnd="@drawable/icon_player_bottom_arrow"
                app:layout_constraintBottom_toTopOf="@+id/ll_tag"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.newleaf.app.android.victor.view.ItemFilterTagLayout
                android:orientation="horizontal"
                android:id="@+id/ll_tag"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_tag1"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    style="@style/text_style_player_item_tag"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_tag2"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    style="@style/text_style_player_item_tag"/>
            </com.newleaf.app.android.victor.view.ItemFilterTagLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.newleaf.app.android.victor.view.ExpandTextView
        android:textSize="14sp"
        android:textColor="@color/color_white70"
        android:ellipsize="end"
        android:id="@+id/tv_detaile_content"
        android:tag="layout/merge_layout_player_control_foryou_group1_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.88"
        app:btnName="@string/more"
        app:canCloseExpend="false"
        app:canCollapsedClickable="false"
        app:collapsedMaxLine="2"
        app:expendMaxLine="3"
        app:layout_constraintBottom_toTopOf="@+id/tv_watch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="0dp"
        app:moreColor="@color/color_white90"
        app:showMore="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:gravity="center"
        android:id="@+id/tv_watch"
        android:tag="layout/merge_layout_player_control_foryou_group1_3"
        android:background="@drawable/bg_ffffff_alpha_15_corner4"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
