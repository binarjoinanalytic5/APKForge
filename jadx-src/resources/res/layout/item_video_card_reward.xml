<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_video_card_reward_0"
    android:background="@color/backgrounds_background_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_top_mask"
        android:layout_width="match_parent"
        android:layout_height="375dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_bg2"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:src="@drawable/bg_item_video_card_reward"
        app:layout_constraintBottom_toTopOf="@+id/include_bottom"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="343dp"
        android:layout_height="0dp"
        android:layout_marginTop="208dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/include_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="#ffffeac8"
            android:id="@+id/tv_title"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="Get up to"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/title2_bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="44sp"
            android:textColor="#ffffeac8"
            android:id="@+id/tv_title_coins"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="77dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingHorizontal="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/title2_bold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/line"
            android:layout_width="311dp"
            android:layout_height="10dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/icon_video_card_reward_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_coins"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="#b2ffeac8"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Various tasks, plenty of coin rewards"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:paddingHorizontal="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"
            style="@style/body_regular"/>
        <com.newleaf.app.android.victor.player.ad.view.RewardVideoCardSlideItemView
            android:id="@+id/slide_view"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="35dp"
            app:layout_constraintBottom_toTopOf="@+id/fl_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_button_bg"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:scaleType="fitXY"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="#ff531f13"
            android:gravity="center"
            android:id="@+id/fl_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/body_bold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_head_of_content"
        android:layout_width="240dp"
        android:layout_height="140dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_content"/>
    <FrameLayout
        android:id="@+id/load_layout"
        android:background="@color/backgrounds_background_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/load_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:lottie_autoPlay="false"
            app:lottie_fileName="novel_loading_night.json"
            app:lottie_loop="true"/>
    </FrameLayout>
    <include
        android:id="@+id/include_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/include_layout_video_card_bottom_view"/>
    <include
        android:id="@+id/title_bar"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_title_transparent_background_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
