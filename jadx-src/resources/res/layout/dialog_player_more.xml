<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_player_more_0"
    android:background="@drawable/bg_141414_top_corner_16"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/more"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/fl_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/icon_close_more"
        android:contentDescription="@string/description_close"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.newleaf.app.android.victor.view.MaxDialogHeightNestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_close">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dialog_more0"
                android:background="@drawable/bg_292929_corner_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/more_audio"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_more_subtitle"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white"
                        android:id="@+id/tv_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio"
                        android:layout_marginStart="8dp"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white50"
                        android:gravity="end"
                        android:id="@+id/audio_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English"
                        android:maxLines="1"/>
                    <ImageView
                        android:id="@+id/arrow_view0"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/icon_more_arrow_right"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/more_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_more_subtitle"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white"
                        android:id="@+id/tv_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitles"
                        android:layout_marginStart="8dp"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white50"
                        android:gravity="end"
                        android:id="@+id/subtitle_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English"
                        android:maxLines="1"/>
                    <ImageView
                        android:id="@+id/arrow_view1"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/icon_more_arrow_right"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dialog_more1"
                android:background="@drawable/bg_292929_corner_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/dialog_more0">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/more_speed"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_speed"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white"
                        android:id="@+id/tv_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/speed"
                        android:layout_marginStart="8dp"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white50"
                        android:gravity="end"
                        android:id="@+id/speed_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0x"
                        android:maxLines="1"/>
                    <ImageView
                        android:id="@+id/arrow_view2"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/icon_more_arrow_right"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <View
                    android:id="@+id/v_line"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    style="@style/setting_vertical_line"/>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/more_quality"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_quality"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white"
                        android:id="@+id/tv_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quality"
                        android:layout_marginStart="8dp"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white50"
                        android:gravity="end"
                        android:id="@+id/quality_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="720p"/>
                    <ImageView
                        android:id="@+id/arrow_view3"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/icon_more_arrow_right"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dialog_more2"
                android:background="@drawable/bg_292929_corner_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/dialog_more1">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/more_pip"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_more_pip"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white"
                        android:id="@+id/tv_pip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/v_pip_switch"
                        android:layout_marginStart="8dp"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <com.newleaf.app.android.victor.view.SwitchButton
                        android:gravity="end"
                        android:id="@+id/switch_auto"
                        android:layout_width="36dp"
                        android:layout_height="20dp"
                        app:check_color="#ffe52e2e"
                        app:switchColor="@color/color_white90"
                        app:uncheck_color="#ff3d3d3d"/>
                </LinearLayout>
                <View
                    android:id="@+id/v_line2"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    style="@style/setting_vertical_line"/>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/more_share"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_more_share"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white"
                        android:id="@+id/tv_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/description_episode_share"
                        android:layout_marginStart="8dp"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/arrow_view4"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/icon_more_arrow_right"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <View
                    android:id="@+id/v_line3"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    style="@style/setting_vertical_line"/>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_negative_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_more_negative_feed_back"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_white"
                        android:id="@+id/tv_feed_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feedback"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                    <ImageView
                        android:id="@+id/arrow_view5"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/icon_more_arrow_right"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.newleaf.app.android.victor.view.MaxDialogHeightNestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
