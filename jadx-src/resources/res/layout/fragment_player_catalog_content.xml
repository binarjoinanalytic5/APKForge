<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_player_catalog_content_0"
    android:background="@color/backgrounds_background_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/early_access_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_early_access_tips"/>
    <com.newleaf.app.android.victor.player.view.CatalogView
        android:orientation="vertical"
        android:id="@+id/catalog_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/early_access_layout"
        app:layout_goneMarginTop="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
