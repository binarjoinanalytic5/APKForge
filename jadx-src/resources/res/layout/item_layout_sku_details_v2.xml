<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item_bg"
    android:tag="layout/item_layout_sku_details_v2_0"
    android:background="@drawable/bg_backgrounds_background_3_r4"
    android:layout_width="136dp"
    android:layout_height="160dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/img_icon_coins"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_coin_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="12dp"
        app:autoSizeMaxTextSize="@dimen/fontSize_3"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/img_icon_coins"
        app:layout_constraintTop_toBottomOf="@+id/img_icon_coins"
        style="@style/title2_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_tertiary"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_coins_org"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:autoSizeMaxTextSize="@dimen/fontSize_12"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/img_icon_coins"
        app:layout_constraintTop_toBottomOf="@+id/tv_coin_num"
        style="@style/caption_regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_tertiary"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_bonus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:autoSizeMaxTextSize="@dimen/fontSize_12"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/img_icon_coins"
        app:layout_constraintTop_toBottomOf="@+id/tv_coins_org"
        style="@style/caption_regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:gravity="end|center_vertical"
        android:id="@+id/tv_price"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="12dp"
        app:autoSizeMaxTextSize="@dimen/fontSize_7"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/img_icon_coins"
        style="@style/body_medium"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_mark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginStart="13.5dp"
        android:paddingHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_text_mark"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/caption_medium"/>
        <View
            android:id="@+id/v_dividing_line"
            android:background="@color/texticon_quaternary"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"/>
        <com.newleaf.app.android.victor.view.CountDownText
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_count_down_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:autoSizeMaxTextSize="@dimen/fontSize_12"
            app:autoSizeMinTextSize="4sp"
            app:autoSizeStepGranularity="1px"
            app:autoSizeTextType="uniform"
            style="@style/caption_medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
