<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_292929_to_000000"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fl_left_option"
        android:tag="layout/view_vip_container_layout_0"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toStartOf="@+id/fl_right_option"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/iv_left_option_bg"
            android:background="@drawable/bg_vip_center_left"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="-8dp"
            android:layout_marginEnd="-8dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fff2ca91"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_left_option"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/standard_vip"
            android:maxLines="1"
            android:layout_marginHorizontal="8dp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="0.5dp"
            app:autoSizeTextType="uniform"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_right_option"
        android:tag="layout/view_vip_container_layout_1"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fl_left_option"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/iv_right_option_bg"
            android:background="@drawable/bg_vip_center_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="-8dp"
            android:layout_marginStart="-8dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_ffffff_alpha_50"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_right_option"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/basic_vip"
            android:maxLines="1"
            android:layout_marginHorizontal="8dp"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="0.5dp"
            app:autoSizeTextType="uniform"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_left"
        android:tag="layout/view_vip_container_layout_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_vip_common_wheat_left"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toStartOf="@+id/tv_title"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="#fff2ca91"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:tag="layout/view_vip_container_layout_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="64dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="16dp"
        android:maxLines="2"
        android:layout_marginHorizontal="2dp"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="0.5dp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_right"
        app:layout_constraintStart_toEndOf="@+id/iv_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_right"
        android:tag="layout/view_vip_container_layout_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_vip_common_wheat_right"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
</merge>
