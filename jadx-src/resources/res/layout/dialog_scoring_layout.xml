<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_scoring_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_background3_corner16"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        app:layout_constraintTop_toTopOf="@+id/fm_icon">
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/icon_close_play_catalog"
            android:contentDescription="@string/description_close"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/texticon_primary"
            android:gravity="center_horizontal"
            android:id="@+id/tv_scoring_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="74dp"
            android:text="@string/app_scoring_title"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/title3_bold"/>
        <TextView
            android:textColor="@color/texticon_secondary_active"
            android:gravity="center_horizontal"
            android:id="@+id/tv_scoring_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_scoring_desc"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_scoring_title"
            style="@style/body_regular"/>
        <RadioGroup
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/rg_scoring_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layoutDirection="ltr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_scoring_desc">
            <CheckBox
                android:id="@+id/rb_scoring_level1"
                android:focusable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:checked="true"
                android:button="@drawable/application_scoring_selector"/>
            <CheckBox
                android:id="@+id/rb_scoring_level2"
                android:focusable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:checked="true"
                android:button="@drawable/application_scoring_selector"
                android:layout_marginStart="12dp"/>
            <CheckBox
                android:id="@+id/rb_scoring_level3"
                android:focusable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:checked="true"
                android:button="@drawable/application_scoring_selector"
                android:layout_marginStart="12dp"/>
            <CheckBox
                android:id="@+id/rb_scoring_level4"
                android:focusable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:checked="true"
                android:button="@drawable/application_scoring_selector"
                android:layout_marginStart="12dp"/>
            <CheckBox
                android:id="@+id/rb_scoring_level5"
                android:focusable="true"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:checked="true"
                android:button="@drawable/application_scoring_selector"
                android:layout_marginStart="12dp"/>
        </RadioGroup>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_edit"
            android:background="@drawable/bg_scoring_input_content_bg_shape"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rg_scoring_group">
            <EditText
                android:scrollbarThumbVertical="@drawable/scroing_input_content_scrollbars"
                android:textColor="@color/texticon_primary"
                android:textColorHint="@color/texticon_quaternary"
                android:gravity="start"
                android:id="@+id/et_scoring_input_content"
                android:background="@drawable/bg_scoring_input_content_bg_shape"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="@string/app_scoring_hint_desc"
                android:maxLength="1000"
                android:textCursorDrawable="@drawable/scoring_edit_cursor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/body_regular"/>
            <TextView
                android:id="@+id/et_scoring_input_num"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_scoring_input_content"
                style="@style/footnote_regular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_send"
            android:background="@drawable/bg_scoring_send_content_shape"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_edit">
            <TextView
                android:textColor="@color/texticon_fixed_primary"
                android:gravity="center"
                android:id="@+id/tv_scoring_send"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/rate_popup_five_stars_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/headline_medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ProgressBar
            android:id="@+id/pb_loading"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:indeterminateTint="#ffe83a57"
            android:indeterminateTintMode="screen"
            app:layout_constraintBottom_toBottomOf="@+id/cl_send"
            app:layout_constraintEnd_toEndOf="@+id/cl_send"
            app:layout_constraintStart_toStartOf="@+id/cl_send"
            app:layout_constraintTop_toTopOf="@+id/cl_send"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fm_icon"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_scoring_emoji"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:src="@drawable/scoring_dialog_emoji_like"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
