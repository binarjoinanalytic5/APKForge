<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_category_filter_0"
    android:background="@color/color_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.newleaf.app.android.victor.view.CustomNestedScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/v_top_bg"
                android:layout_width="match_parent"
                android:layout_height="375dp"
                android:layout_alignParentTop="true"
                android:elevation="-1dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/filter_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.newleaf.app.android.victor.hall.category.CategoryFilterView
                        android:id="@+id/filter_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragment_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </FrameLayout>
    </com.newleaf.app.android.victor.view.CustomNestedScrollView>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:tag="binding_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:elevation="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:load_fail_view_bg_color="@color/transparent"/>
    <include
        android:id="@+id/title_bar"
        android:elevation="1dp"
        layout="@layout/include_title_transparent_background_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/filter_bar_layout"
        android:background="@color/backgrounds_background_1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:id="@+id/tv_filter_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/icon_arrow_filter_bar"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/footnote_regular"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_arrow_filter_bar"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_arrow_up_16"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_filter_bar"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/filter_bar_container"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
