<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/img_poster"
        android:layout_width="45dp"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/v_book_poster_image_style"/>
    <com.newleaf.app.android.victor.view.SimpleStrokeTextView
        android:id="@+id/tv_ranking"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="-10dp"
        android:layout_marginStart="-4dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_poster"
        app:layout_constraintStart_toStartOf="@+id/img_poster"
        app:st_stroke_color="@color/color_292929"
        app:st_stroke_width="4dp"
        app:st_style="bold"
        app:st_text_color="@color/white"
        app:st_text_size="22sp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_e52e2e"
        android:ellipsize="end"
        android:id="@+id/tv_hot"
        android:padding="0dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawablePadding="2dp"
        android:lineSpacingMultiplier="0.88"
        android:drawableStart="@drawable/icon_hall_hot"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_poster"
        app:layout_constraintTop_toTopOf="@+id/img_poster"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:padding="0dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_hot"/>
</androidx.constraintlayout.widget.ConstraintLayout>
