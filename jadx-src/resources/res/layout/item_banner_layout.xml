<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_banner_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/img_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.newleaf.app.android.victor.player.media.ExoTextureView
        android:layout_gravity="center"
        android:id="@+id/video"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/img_fg_bottom"
        android:background="@drawable/bg_ff000000_90_00000000"
        android:layout_width="match_parent"
        android:layout_height="120dp"/>
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/img_fg_top"
        android:background="@drawable/bg_00000000_90_cc000000"
        android:layout_width="match_parent"
        android:layout_height="147dp"/>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_decorator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_title"
            android:visibility="gone"
            android:layout_width="343dp"
            android:layout_height="120dp"
            android:scaleType="fitCenter"/>
        <com.newleaf.app.android.victor.view.ItemFilterTagLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp">
            <com.newleaf.app.android.victor.view.BookMarkView
                android:textSize="12sp"
                android:ellipsize="end"
                android:id="@+id/book_mark"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                app:bmv_radius="4dp"
                style="@style/v_book_mark_style"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_ffffff_alpha_70"
                android:ellipsize="end"
                android:id="@+id/tv_tag1"
                android:background="@drawable/bg_white15_r4"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_ffffff_alpha_70"
                android:ellipsize="end"
                android:id="@+id/tv_tag2"
                android:background="@drawable/bg_white15_r4"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"/>
        </com.newleaf.app.android.victor.view.ItemFilterTagLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_banner_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/fl_play_view"
                android:background="@drawable/shape_banner_player_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                android:layout_width="168dp"
                android:layout_height="40dp"
                android:paddingHorizontal="8dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/tv_play_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play"
                    android:maxLines="1"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/icon_banner_player2"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/ll_collect_view"
                android:background="@drawable/bg_ffffff_a15_corner_4"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                android:layout_width="168dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="8dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_collect_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/icon_item_video_collect_empty"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_ffffff_alpha_90"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_collect_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/banner_button_add"
                    android:maxLines="1"
                    android:layout_marginStart="4dp"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
