<?xml version="1.0" encoding="utf-8"?>
<com.newleaf.app.android.victor.view.refresh.VictorRefreshLayoutV4 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:tag="layout/fragment_episode_vote_channel_layout_0"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.newleaf.app.android.victor.view.CustomNestedScrollView
        android:id="@+id/scroll_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_content"
            android:tag="binding_1"
            android:background="#ff110b0c"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/space"
                layout="@layout/include_statusbar_space"/>
            <ImageView
                android:id="@+id/iv_head"
                android:layout_width="match_parent"
                android:layout_height="310dp"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:gravity="center_horizontal"
                android:id="@+id/tv_module_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="41dp"
                android:layout_marginTop="34dp"
                android:layout_marginRight="41dp"
                android:maxLines="1"
                android:layout_marginHorizontal="41dp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintTop_toBottomOf="@+id/space"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="22sp"
                android:gravity="center_horizontal"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="41dp"
                android:layout_marginTop="49dp"
                android:layout_marginRight="41dp"
                android:maxLines="1"
                android:layout_marginHorizontal="41dp"
                app:autoSizeMaxTextSize="22sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintTop_toBottomOf="@+id/space"/>
            <com.newleaf.app.android.victor.common.vote.VoteCountDownText
                android:textColor="@color/color_ccffd8b5"
                android:gravity="center_horizontal"
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="-2dp"
                android:layout_marginRight="10dp"
                android:maxLines="1"
                android:layout_marginHorizontal="10dp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="6sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/footnote_regular"/>
            <com.newleaf.app.android.victor.common.vote.CurVoteCountView
                android:id="@+id/view_vote_count"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:layout_marginTop="-20dp"
                android:layout_marginRight="17dp"
                android:layout_marginHorizontal="17dp"
                app:layout_constraintTop_toBottomOf="@+id/iv_head"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_normal_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="iv_head,tv_module_name,tv_title,tv_subtitle"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_previous_wins_header"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="505dp"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_previous_wins_head"
                    android:layout_width="match_parent"
                    android:layout_height="310dp"
                    android:layout_marginTop="162dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/view_previous_wins_head_mask"
                    android:background="@drawable/bg_110b0c_00110b0c"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    app:layout_constraintTop_toTopOf="@+id/iv_previous_wins_head"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14sp"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_previous_wins_module_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="88dp"
                    android:layout_marginRight="16dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginHorizontal="16dp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="24sp"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_previous_wins_round_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="105dp"
                    android:layout_marginRight="16dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/noto_sans_0"
                    android:layout_marginHorizontal="16dp"
                    app:autoSizeMaxTextSize="24sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.newleaf.app.android.victor.view.RoundImageView
                    android:id="@+id/iv_previous_wins_cover"
                    android:layout_width="111dp"
                    android:layout_height="148dp"
                    android:layout_marginTop="162dp"
                    android:src="@drawable/icon_poster_default"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:radius="4dp"/>
                <View
                    android:id="@+id/bg_cover"
                    android:layout_width="111dp"
                    android:layout_height="148dp"
                    app:layout_constraintStart_toStartOf="@+id/iv_previous_wins_cover"
                    app:layout_constraintTop_toTopOf="@+id/iv_previous_wins_cover"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/color_ffd8b5"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_previous_wins_book_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="16dp"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_marginHorizontal="16dp"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_previous_wins_cover"
                    style="@style/title1_bold"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/color_b3ffd8b5"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_previous_wins_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="20dp"
                    android:maxLines="3"
                    android:includeFontPadding="false"
                    android:layout_marginHorizontal="20dp"
                    app:autoSizeMaxTextSize="10sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_previous_wins_book_title"
                    style="@style/caption_regular"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="@color/texticon_primary"
                    android:gravity="center"
                    android:id="@+id/tv_watch_season"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="457dp"
                    android:layout_marginRight="16dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_marginHorizontal="16dp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="7sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/body_bold"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.newleaf.app.android.victor.view.XSlidingTabLayout2
                android:id="@+id/tab_layout"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="5dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_vote_count"
                app:layout_goneMarginTop="0dp"
                app:tl_indicator_color="@color/transparent"
                app:tl_indicator_corner_radius="2dp"
                app:tl_indicator_end_color="@color/color_fff1d9"
                app:tl_indicator_gravity="BOTTOM"
                app:tl_indicator_height="0dp"
                app:tl_indicator_margin_left="20dp"
                app:tl_indicator_margin_right="20dp"
                app:tl_indicator_start_color="@color/color_ff9350"
                app:tl_indicator_style="NORMAL"
                app:tl_tab_padding="12dp"
                app:tl_textBold="SELECT"
                app:tl_textSelectColor="@color/color_fff1d9"
                app:tl_textUnselectColor="@color/color_80ffd8b5"
                app:tl_text_select_gradient="true"
                app:tl_text_select_gradient_orientation="VERTICAL"
                app:tl_text_select_size="14sp"
                app:tl_textsize="14sp"/>
            <com.newleaf.app.android.victor.view.LinearLayoutAtViewPager2
                android:orientation="vertical"
                android:id="@+id/ll_page"
                android:layout_width="match_parent"
                android:layout_height="600dp"
                app:layout_constraintTop_toBottomOf="@+id/tab_layout">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/view_page2"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
            </com.newleaf.app.android.victor.view.LinearLayoutAtViewPager2>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.newleaf.app.android.victor.view.CustomNestedScrollView>
    <View
        android:id="@+id/view_title_mask"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:tag="binding_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/title"
        layout="@layout/include_title_vote_ranking"/>
</com.newleaf.app.android.victor.view.refresh.VictorRefreshLayoutV4>
