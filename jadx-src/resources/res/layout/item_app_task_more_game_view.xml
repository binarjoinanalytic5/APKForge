<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item_content"
    android:tag="layout/item_app_task_more_game_view_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_more_game_app_logo"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_more_game_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/iv_more_game_app_logo"
        app:layout_constraintStart_toStartOf="@+id/iv_more_game_app_logo"
        app:layout_constraintTop_toBottomOf="@+id/iv_more_game_app_logo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
