<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item_bg"
    android:tag="layout/item_layout_sku_details_v3_0"
    android:background="@drawable/bg_backgrounds_background_3_r4"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/img_icon_coins"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_coins_16"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_coin_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_plus_sign"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/img_icon_coins"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/body_medium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_tertiary"
        android:id="@+id/tv_plus_sign"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_coin_num"
        app:layout_constraintEnd_toStartOf="@+id/img_icon_bonus"
        app:layout_constraintStart_toEndOf="@+id/tv_coin_num"
        app:layout_constraintTop_toTopOf="@+id/tv_coin_num"
        style="@style/body_bold"/>
    <ImageView
        android:id="@+id/img_icon_bonus"
        android:visibility="visible"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_bonus_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_coin_num"
        app:layout_constraintEnd_toStartOf="@+id/tv_bonus"
        app:layout_constraintStart_toEndOf="@+id/tv_plus_sign"
        app:layout_constraintTop_toTopOf="@+id/tv_coin_num"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_bonus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_coin_num"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_icon_bonus"
        app:layout_constraintTop_toTopOf="@+id/tv_coin_num"
        app:layout_goneMarginStart="0dp"
        style="@style/body_medium"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:gravity="center"
        android:id="@+id/tv_price"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body_regular"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_mark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginStart="13.5dp"
        android:paddingHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_text_mark"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/caption_medium"/>
        <View
            android:id="@+id/v_dividing_line"
            android:background="@color/texticon_quaternary"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="4dp"/>
        <com.newleaf.app.android.victor.view.CountDownText
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_count_down_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:autoSizeMaxTextSize="10sp"
            app:autoSizeMinTextSize="4sp"
            app:autoSizeStepGranularity="0.1sp"
            app:autoSizeTextType="uniform"
            style="@style/caption_medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
