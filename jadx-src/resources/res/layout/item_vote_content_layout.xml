<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/item_vote_content_layout_0"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="-44dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_ranking_group"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_number_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/rank_line1"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/color_80ffd8b5"
                android:gravity="center_horizontal"
                android:id="@+id/tv_ranking_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="6sp"
                app:autoSizeStepGranularity="0.1sp"
                app:autoSizeTextType="uniform"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/footnote_regular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_ranking_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:maxLines="1"
                android:layout_marginHorizontal="10dp"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="0.1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="@+id/tv_ranking_text"
                app:layout_constraintStart_toStartOf="@+id/tv_ranking_text"
                app:layout_constraintTop_toBottomOf="@+id/tv_ranking_text"
                style="@style/title1_bold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/rank_line1"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/cl_vote_rank_group"
            app:layout_constraintStart_toEndOf="@+id/cl_number_group"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_vote_rank_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/rank_line2"
            app:layout_constraintStart_toEndOf="@+id/rank_line1">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/color_80ffd8b5"
                android:id="@+id/tv_votes_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="6sp"
                app:autoSizeStepGranularity="0.1sp"
                app:autoSizeTextType="uniform"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/footnote_regular"/>
            <com.newleaf.app.android.victor.view.ScrollTextView
                android:id="@+id/tv_votes_value"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_votes_text"
                app:stvColors="#FF9350,#FFF1D9"
                app:stvDuration="200"
                app:stvTextSize="20sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/rank_line2"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/cl_vote_lead_group"
            app:layout_constraintStart_toEndOf="@+id/cl_vote_rank_group"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_vote_lead_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/rank_line2">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/color_80ffd8b5"
                android:gravity="center_horizontal"
                android:id="@+id/tv_votes_lead_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="6sp"
                app:autoSizeStepGranularity="0.1sp"
                app:autoSizeTextType="uniform"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/footnote_regular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_votes_lead_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:maxLines="1"
                android:layout_marginHorizontal="10dp"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="0.1sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toEndOf="@+id/tv_votes_lead_text"
                app:layout_constraintStart_toStartOf="@+id/tv_votes_lead_text"
                app:layout_constraintTop_toBottomOf="@+id/tv_votes_lead_text"
                style="@style/title1_bold"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_vote_pop"
        android:background="@drawable/vote_animat_mask"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-5dp"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@+id/cl_vote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/iv_vote1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/img_vote"
            app:layout_constraintEnd_toStartOf="@+id/tv_vote_num_pop"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="28sp"
            android:textColor="#ffffe9d6"
            android:id="@+id/tv_vote_num_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_sans_3"
            app:layout_constraintBottom_toBottomOf="@+id/iv_vote1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_vote1"
            app:layout_constraintTop_toTopOf="@+id/iv_vote1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_vote"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_ranking_group">
        <View
            android:id="@+id/view_vote_bg1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_vote_bg2"
            android:background="@drawable/btn_vote_alpha_light"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="-6dp"
            android:layout_marginRight="-6dp"
            android:alpha="0"
            android:layout_marginHorizontal="-6dp"/>
        <TextView
            android:textColor="@color/color_ffe9d6"
            android:id="@+id/tv_vote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/text_vote"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/body_bold"/>
        <TextView
            android:textColor="@color/color_ffe9d6"
            android:id="@+id/tv_vote_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:text="@string/daily_vote_available"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_vote"
            style="@style/footnote_regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/color_ffe9d6"
        android:gravity="center"
        android:id="@+id/tv_campaign"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="22dp"
        android:text="@string/get_more_votes"
        android:maxLines="1"
        android:layout_marginHorizontal="22dp"
        android:paddingHorizontal="10dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="6sp"
        app:autoSizeStepGranularity="0.1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintTop_toBottomOf="@+id/cl_vote"
        style="@style/body_bold"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/more_vote_click_guide"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="-32dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_campaign"
        app:layout_constraintTop_toTopOf="@+id/tv_campaign"
        app:lottie_fileName="item_click_guide.json"
        app:lottie_repeatCount="3"/>
    <View
        android:id="@+id/view_light_shadow"
        android:background="@drawable/icon_vote_light_shadow"
        android:layout_width="272dp"
        android:layout_height="17dp"
        android:layout_marginTop="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_campaign"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_vote_recommend"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintTop_toBottomOf="@+id/view_light_shadow"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/color_ffe9d6"
        android:id="@+id/tv_full_ranking"
        android:paddingTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/view_full_rankings"
        android:maxLines="1"
        android:layout_marginStart="22dp"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeMinTextSize="6sp"
        app:autoSizeStepGranularity="0.1sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_vote_recommend"
        style="@style/footnote_regular"/>
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/icon_arrow_right_12"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_full_ranking"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_full_ranking"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_view_full_ranking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_full_ranking,iv_arrow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
