<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/view_discover_second_layout_0"
    android:layout_width="match_parent"
    android:layout_height="31dp">
    <com.newleaf.app.android.victor.view.HorizontalScrollTabView
        android:id="@+id/tab_layout"
        android:fadingEdgeLength="20dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        app:layout_constraintEnd_toStartOf="@+id/tv_filter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="v_filter,tv_filter,iv_filter"/>
    <View
        android:id="@+id/v_filter"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_filter"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_50"
        android:gravity="center_vertical"
        android:id="@+id/tv_filter"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:text="@string/filter"
        android:paddingStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_filter"
        app:layout_constraintStart_toEndOf="@+id/tab_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_filter"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_filter_gery"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_filter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_filter"
        app:layout_constraintTop_toTopOf="@+id/tv_filter"
        app:lottie_fileName="v_filter_unselected.json"/>
</androidx.constraintlayout.widget.ConstraintLayout>
