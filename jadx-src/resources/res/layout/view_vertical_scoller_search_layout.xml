<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <ImageView
        android:id="@+id/iv_logo"
        android:tag="layout/view_vertical_scoller_search_layout_0"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:paddingEnd="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_search"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_search"
        android:tag="layout/view_vertical_scoller_search_layout_1"
        android:background="@drawable/bg_hall_search_bar_v3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_vip_entry"
        app:layout_constraintStart_toEndOf="@+id/iv_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp">
        <ImageView
            android:id="@+id/iv_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_search_gery_big"/>
        <FrameLayout
            android:id="@+id/fl_search_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="16sp"
                android:textColorHint="@color/color_ffffff_alpha_60"
                android:ellipsize="end"
                android:id="@+id/tv_hint"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_page_input_default"
                android:maxLines="1"/>
            <com.newleaf.app.android.victor.view.VerticalRollingView
                android:id="@+id/tv_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:vrTextColor="@color/color_ffffff_alpha_60"
                app:vrTextSize="16sp"/>
        </FrameLayout>
        <View
            android:id="@+id/v_line"
            android:background="@color/color_ffffff_alpha_20"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"/>
        <ImageView
            android:id="@+id/iv_filter"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:src="@drawable/icon_discover_filter"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_vip_entry"
        android:tag="layout/view_vertical_scoller_search_layout_2"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_right_up_vip_entry"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll_search"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:gravity="center_vertical"
        android:id="@+id/tv_vip_discount"
        android:tag="layout/view_vertical_scoller_search_layout_3"
        android:background="@drawable/bg_button_brand_normal_r4"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:includeFontPadding="false"
        android:paddingHorizontal="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toLeftOf="@+id/iv_vip_entry"
        app:layout_constraintRight_toRightOf="@+id/iv_vip_entry"
        style="@style/caption_medium"/>
</merge>
