<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mylist_guide"
    android:tag="layout/view_history_guide_layout_0"
    android:background="@color/color_000000_alpha_70"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/status_bar_space"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.legacy.widget.Space
        android:id="@+id/space_ripple"
        android:layout_width="1dp"
        android:layout_height="120dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="82dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_space"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/svg_ripple"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:layout_constraintBottom_toBottomOf="@+id/space_ripple"
        app:layout_constraintStart_toStartOf="@+id/space_ripple"
        app:layout_constraintTop_toTopOf="@+id/space_ripple"
        app:lottie_autoPlay="true"
        app:lottie_fileName="mylist_ripple.json"
        app:lottie_loop="true"/>
    <ImageView
        android:id="@+id/iv_collect"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icon_item_video_collect_empty"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/space_ripple"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/space_ripple"/>
    <ImageView
        android:id="@+id/iv_line"
        android:layout_width="41dp"
        android:layout_height="8dp"
        android:src="@drawable/bg_history_guide_line"
        android:layout_marginEnd="64dp"
        app:layout_constraintBottom_toBottomOf="@+id/space_ripple"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/space_ripple"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_000000"
        android:gravity="center_vertical"
        android:id="@+id/guide_pop"
        android:background="@drawable/bg_ffffff_corner_6"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/history_collect_guide_des"
        android:paddingHorizontal="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_line"
        app:layout_constraintEnd_toStartOf="@+id/iv_line"
        app:layout_constraintTop_toTopOf="@+id/iv_line"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/tv_ok"
        android:background="@drawable/bg_ffffff_border_000000_alpha_90_corner_6"
        android:layout_width="84dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="@string/ok"
        app:layout_constraintEnd_toEndOf="@+id/guide_pop"
        app:layout_constraintTop_toBottomOf="@+id/guide_pop"/>
</androidx.constraintlayout.widget.ConstraintLayout>
