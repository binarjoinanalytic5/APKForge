<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_title"
        android:tag="layout/player_control_view_land_0"
        android:background="@drawable/bg_000000alpha60_to_000000alpha0_270"
        android:paddingLeft="60dp"
        android:paddingRight="60dp"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:paddingHorizontal="60dp">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/icon_back_white"
            android:scaleType="centerCrop"
            android:contentDescription="@string/description_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:id="@+id/tv_episode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_back"
            app:layout_constraintStart_toEndOf="@+id/iv_back"
            app:layout_constraintTop_toTopOf="@+id/iv_back"
            app:layout_constraintWidth_max="360dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/texticon_primary"
            android:id="@+id/tv_play_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            app:layout_constraintBottom_toBottomOf="@+id/iv_speed_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_speed_icon"/>
        <ImageView
            android:id="@+id/iv_speed_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="25dp"
            android:src="@drawable/land_icon_speed"
            android:contentDescription="@string/speed"
            app:layout_constraintEnd_toStartOf="@+id/tv_play_speed"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/ll_bottom"
        android:tag="layout/player_control_view_land_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rl_player_control"
            android:background="@drawable/bg_000000alpha0_to_000000alpha60"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_play_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="00:00"
                app:layout_constraintEnd_toStartOf="@+id/tv_play_time_unit"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_play_time_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                app:layout_constraintEnd_toStartOf="@+id/tv_total_time"
                app:layout_constraintTop_toTopOf="@+id/tv_play_time"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/texticon_tertiary"
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:layout_marginEnd="60dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_play_time"/>
            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:maxHeight="2dp"
                android:progressDrawable="@drawable/seekbar_bg"
                android:thumb="@drawable/seekbar_thumb"
                android:contentDescription="@string/description_episode_progress_bar"
                android:layoutDirection="ltr"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="55dp"
                android:splitTrack="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_play_time"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="60dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/seek_bar">
                <ImageView
                    android:id="@+id/iv_collect"
                    android:background="@drawable/icon_item_video_collect_none"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="@color/texticon_primary"
                    android:gravity="center"
                    android:id="@+id/tv_collect_num"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="2dp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="2sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"/>
                <ImageView
                    android:id="@+id/iv_like"
                    android:background="@drawable/item_video_like_none_land"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="@color/texticon_primary"
                    android:gravity="center"
                    android:id="@+id/tv_like_num"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="2dp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="2sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_catalog"
                android:background="@drawable/bg_ffffff_alpha_10_corner4"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="160dp"
                android:layout_height="32dp"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="60dp"
                android:paddingHorizontal="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/seek_bar">
                <ImageView
                    android:id="@+id/img_catalog"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/icon_item_video_catalogue"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/texticon_primary"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_catalog_name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:lineSpacingMultiplier="0.88"
                    android:layout_marginHorizontal="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/img_arrow"
                    app:layout_constraintStart_toEndOf="@+id/img_catalog"/>
                <ImageView
                    android:id="@+id/img_arrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/icon_player_open_catalog"
                    android:contentDescription="@string/description_expand"
                    android:rotation="180"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:id="@+id/ll_play_thumbnail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/texticon_primary"
                android:gravity="center"
                android:id="@+id/tv_seek_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="108dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:lineSpacingMultiplier="0.88"/>
            <com.newleaf.app.android.victor.view.RoundImageView
                android:id="@+id/iv_play_thumbnail"
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:layout_above="@+id/tv_seek_time"
                android:layout_centerHorizontal="true"
                app:radius="8dp"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_play_status"
            android:padding="5dp"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/icon_pause2"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</merge>
