<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/dialog_reward_guide_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.newleaf.app.android.victor.dialog.RewardGuideView
        android:id="@+id/custom_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/lottie_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="1px"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="start|top"
        android:id="@+id/lottie_view2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="1px"/>
    <FrameLayout
        android:id="@+id/cl_tips"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="start|top"
            android:id="@+id/tv_tips_layout"
            android:background="@drawable/bg_popup_purple_r8"
            android:padding="12dp"
            android:layout_width="256dp"
            android:layout_height="90dp">
            <TextView
                android:textColor="@color/texticon_primary"
                android:gravity="start|top"
                android:id="@+id/tv_tips_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/vip_reward_guide_tips"
                style="@style/body_bold"/>
            <TextView
                android:textColor="@color/texticon_black_normal"
                android:gravity="center"
                android:layout_gravity="end|bottom"
                android:id="@+id/tv_count_down"
                android:background="@drawable/bg_button_white_fixed_normal_r4"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:paddingHorizontal="16dp"
                style="@style/footnote_medium"/>
        </FrameLayout>
        <View
            android:layout_gravity="start|top"
            android:id="@+id/arrow_view"
            android:background="@color/popup_purple"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:rotation="45"/>
    </FrameLayout>
</FrameLayout>
