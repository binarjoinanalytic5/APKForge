<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_vip_coming_soon_layout_0"
    android:layout_width="111dp"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/texticon_secondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_online_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="107dp"/>
    <ImageView
        android:id="@+id/line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:src="@drawable/bg_item_vip_coming_soon_line"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_online_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_online_time"
        app:layout_constraintTop_toTopOf="@+id/tv_online_time"/>
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_online_time"
        app:radius="4dp"/>
    <com.newleaf.app.android.victor.view.BookMarkView
        android:id="@+id/bookMarkView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
        style="@style/v_book_mark_style"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_book_poster"
        style="@style/text_style_line_spacing_120"/>
</androidx.constraintlayout.widget.ConstraintLayout>
