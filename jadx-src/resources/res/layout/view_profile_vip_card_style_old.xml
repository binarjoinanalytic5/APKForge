<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_subscribe_vip"
        android:tag="layout/view_profile_vip_card_style_old_0"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="v_subscribe_bg,iv_vip_icon,tv_vip_text1,tv_vip_text2,cl_vip_point"/>
    <View
        android:id="@+id/v_subscribe_bg"
        android:tag="layout/view_profile_vip_card_style_old_1"
        android:background="@drawable/bg_vip_recharge_diamond_player"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_subscribe_vip_v"
        android:tag="layout/view_profile_vip_card_style_old_2"
        android:layout_width="156dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/v_subscribe_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_subscribe_bg"
        app:layout_constraintTop_toTopOf="@+id/v_subscribe_bg"/>
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/iv_vip_icon"
        android:tag="layout/view_profile_vip_card_style_old_3"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/icon_vip_activity_head"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_subscribe_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_subscribe_bg"
        app:layout_constraintTop_toTopOf="@+id/v_subscribe_bg"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ff401a06"
        android:id="@+id/tv_vip_text1"
        android:tag="layout/view_profile_vip_card_style_old_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_vip_text2"
        app:layout_constraintEnd_toStartOf="@+id/iv_vip_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/v_subscribe_bg"
        app:layout_constraintTop_toTopOf="@+id/v_subscribe_bg"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textColor="#b2401a06"
        android:ellipsize="end"
        android:id="@+id/tv_vip_text2"
        android:tag="layout/view_profile_vip_card_style_old_5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:maxLines="3"
        android:layout_marginHorizontal="16dp"
        app:autoSizeMaxTextSize="10sp"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_subscribe_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_vip_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/v_subscribe_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_vip_text1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_vip_point"
        android:tag="layout/view_profile_vip_card_style_old_6"
        android:background="#fffdecd3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:layout_constraintTop_toBottomOf="@+id/v_subscribe_bg">
        <TextView
            android:textColor="#b2401a06"
            android:ellipsize="end"
            android:id="@+id/tv_my_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_vip_points"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cl_vip_other_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/footnote_medium"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_vip_other_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_right_arrow"
            app:layout_constraintEnd_toStartOf="@+id/iv_right_arrow"
            app:layout_constraintTop_toTopOf="@+id/iv_right_arrow">
            <ImageView
                android:id="@+id/iv_diamond"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/icon_vip_point"
                android:layout_marginEnd="2dp"
                app:layout_constraintEnd_toStartOf="@+id/tv_vip_point"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="#b25f1d12"
                android:id="@+id/tv_vip_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2000"
                android:layout_marginEnd="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/footnote_medium"/>
            <View
                android:id="@+id/v_red_point"
                android:background="@drawable/shape_home_tab_red_point"
                android:visibility="gone"
                android:layout_width="8dp"
                android:layout_height="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/iv_right_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="3dp"
            android:src="@drawable/icon_vip_right_arrow"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_my_point"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_unsubscribe_vip"
        android:tag="layout/view_profile_vip_card_style_old_7"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="v_unsubscribe_bg,iv_unsubscribe_vip_v,tv_sub_title,rv_benefits_list,tv_go_vip,unsubscribe_space"/>
    <View
        android:id="@+id/v_unsubscribe_bg"
        android:tag="layout/view_profile_vip_card_style_old_8"
        android:background="@drawable/bg_vip_recharge_diamond_player"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/unsubscribe_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_unsubscribe_vip_v"
        android:tag="layout/view_profile_vip_card_style_old_9"
        android:layout_width="211dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/v_unsubscribe_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_unsubscribe_bg"
        app:layout_constraintStart_toStartOf="@+id/v_unsubscribe_bg"
        app:layout_constraintTop_toTopOf="@+id/v_unsubscribe_bg"/>
    <TextView
        android:textColor="#ff401a06"
        android:gravity="center"
        android:id="@+id/tv_sub_title"
        android:tag="layout/view_profile_vip_card_style_old_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/v_unsubscribe_bg"
        app:layout_constraintStart_toStartOf="@+id/v_unsubscribe_bg"
        app:layout_constraintTop_toTopOf="@+id/v_unsubscribe_bg"
        style="@style/body_bold"/>
    <com.newleaf.app.android.victor.view.NoTouchRecyclerView
        android:id="@+id/rv_benefits_list"
        android:tag="layout/view_profile_vip_card_style_old_11"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="@+id/v_unsubscribe_bg"
        app:layout_constraintStart_toStartOf="@+id/v_unsubscribe_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_sub_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="#fffce6c9"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_go_vip"
        android:tag="layout/view_profile_vip_card_style_old_12"
        android:background="#ff401a06"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:text="@string/profile_vip_button"
        android:maxLines="1"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="4dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="6sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="@+id/v_unsubscribe_bg"
        app:layout_constraintStart_toStartOf="@+id/v_unsubscribe_bg"
        app:layout_constraintTop_toBottomOf="@+id/rv_benefits_list"
        style="@style/body_bold"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_vip_discount"
        android:tag="layout/view_profile_vip_card_style_old_13"
        android:background="@drawable/bg_e52e2e_to_eb4c46_lbottom_t_rup_r4"
        android:paddingLeft="8dp"
        android:paddingTop="1dp"
        android:paddingRight="8dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="1dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_go_vip"
        app:layout_constraintTop_toTopOf="@+id/tv_go_vip"
        style="@style/caption_medium"/>
    <androidx.legacy.widget.Space
        android:id="@+id/unsubscribe_space"
        android:tag="layout/view_profile_vip_card_style_old_14"
        android:layout_width="0dp"
        android:layout_height="12dp"
        app:layout_constraintEnd_toEndOf="@+id/v_unsubscribe_bg"
        app:layout_constraintStart_toStartOf="@+id/v_unsubscribe_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_go_vip"/>
</merge>
