<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh_view"
    android:tag="layout/fragment_hall_discover_first_channel_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_page2"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:overScrollMode="never"/>
        <View
            android:id="@+id/title_view"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/title"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/title_view">
            <com.newleaf.app.android.victor.view.VerticalScrollSearchView
                android:id="@+id/search_view"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:contentDescription="@string/description_search_bar"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:vssAnimDuration="800"
                app:vssAnimInterval="20000"
                app:vssSearchIcon="@drawable/icon_search_gery_big_v3"
                app:vssTextColor="@color/color_ffffff_alpha_30"
                app:vssTextSize="16"/>
            <com.newleaf.app.android.victor.view.XSlidingTabLayout3
                android:id="@+id/tab_layout"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="4dp"
                android:layout_marginHorizontal="4dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/search_view"
                app:tl_indicator_color="@color/color_white"
                app:tl_indicator_corner_radius="2dp"
                app:tl_indicator_gravity="BOTTOM"
                app:tl_indicator_height="2dp"
                app:tl_indicator_width="16dp"
                app:tl_tab_padding="12dp"
                app:tl_textBold="BOTH"
                app:tl_textSelectColor="@color/texticon_primary"
                app:tl_textUnselectColor="@color/texticon_tertiary"
                app:tl_text_select_size="18sp"
                app:tl_textsize="14sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/view_top_mask"
            android:background="@drawable/hall_refresh_shade_gradient_bg"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:alpha="0"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_loading_view"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:alpha="0"
            android:elevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_view"
            app:lottie_fileName="loading_v24.json"/>
        <ViewStub
            android:id="@+id/load_fail_view_stub"
            android:layout="@layout/stub_layout_hall_discover_load_fail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
