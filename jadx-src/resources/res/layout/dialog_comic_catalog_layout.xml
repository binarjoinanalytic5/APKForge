<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_comic_catalog_layout_0"
    android:background="@drawable/bg_141414_top_corner_16"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/episode_detail"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_close"
        style="@style/title3_bold"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_close_play_catalog"
        android:contentDescription="@string/description_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_book_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="v_book_detail_entry,iv_book_poster,tv_book_title,tv_book_update_status,iv_arrow,v_line_divider"/>
    <View
        android:id="@+id/v_book_detail_entry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"/>
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="54dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/v_book_poster_image_style"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_book_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_book_update_status"
        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/headline_medium"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_book_update_status"
        android:background="@drawable/bg_ffffff_alpha_10_corner2"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_book_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_title"
        style="@style/caption_medium"/>
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_player_bottom_arrow"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"/>
    <ViewStub
        android:id="@+id/v_vip_discount_card"
        android:layout="@layout/view_vip_discount_des_layout"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_book_poster"/>
    <View
        android:id="@+id/v_line_divider"
        android:background="@color/line_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/v_vip_discount_card"/>
    <com.newleaf.app.android.victor.view.XSlidingTabLayout2
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintTop_toBottomOf="@+id/v_line_divider"
        app:tl_indicator_color="@android:color/transparent"
        app:tl_indicator_corner_radius="2dp"
        app:tl_indicator_gravity="BOTTOM"
        app:tl_indicator_height="0dp"
        app:tl_indicator_style="NORMAL"
        app:tl_indicator_width="0dp"
        app:tl_tab_padding="12dp"
        app:tl_textBold="BOTH"
        app:tl_textSelectColor="@color/texticon_primary"
        app:tl_textUnselectColor="@color/texticon_tertiary"
        app:tl_text_select_size="14sp"
        app:tl_textsize="14sp"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_chapters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:load_fail_view_bg_color="@android:color/transparent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
