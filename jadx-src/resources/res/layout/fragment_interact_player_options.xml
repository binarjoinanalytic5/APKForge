<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_interact_player_options_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/tv_tips"
        android:background="@drawable/bg_interact_player_options_chance_top"
        android:visibility="invisible"
        android:layout_width="327dp"
        android:layout_height="44dp"
        android:layout_marginTop="84dp"
        android:maxLines="2"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="1sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"/>
    <LinearLayout
        android:layout_gravity="start|bottom"
        android:orientation="horizontal"
        android:id="@+id/ll_count_down"
        android:background="@drawable/bg_e83a57_to_alpha100"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginBottom="268dp"
        android:paddingStart="0dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:layout_gravity="center"
            android:id="@+id/tv_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/interact_choce_coming_in"
            android:shadowColor="@color/color_black26"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:layout_marginStart="10dp"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/svg_count_down"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:lottie_loop="false"/>
    </LinearLayout>
</FrameLayout>
