<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_balance_panel"
    android:tag="layout/view_unlock_panel_balance_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_balance_panel_bg"
        android:background="@color/backgrounds_background_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_top_line"/>
    <View
        android:id="@+id/v_top_line"
        android:background="@color/line_outline"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:id="@+id/tv_balance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:text="@string/balance_text"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/iv_explain_bonus_icon"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/footnote_medium"/>
        <ImageView
            android:id="@+id/iv_explain_coins_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/icon_coins_16"
            app:layout_constraintBottom_toBottomOf="@+id/tv_explain_coins_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_explain_coins_text"/>
        <TextView
            android:textColor="@color/texticon_tertiary"
            android:ellipsize="end"
            android:id="@+id/tv_explain_coins_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@+id/iv_explain_coins_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_balance_label"
            app:layout_goneMarginStart="0dp"
            style="@style/footnote_regular"/>
        <TextView
            android:textColor="@color/texticon_tertiary"
            android:ellipsize="end"
            android:id="@+id/tv_explain_equal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="="
            android:maxLines="1"
            android:layout_marginStart="2dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_explain_coins_text"
            app:layout_constraintStart_toEndOf="@+id/tv_explain_coins_text"
            app:layout_constraintTop_toTopOf="@+id/tv_explain_coins_text"
            style="@style/footnote_regular"/>
        <ImageView
            android:id="@+id/iv_explain_bonus_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/icon_bonus_16"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_explain_coins_text"
            app:layout_constraintStart_toEndOf="@+id/tv_explain_equal"
            app:layout_constraintTop_toTopOf="@+id/tv_explain_coins_text"/>
        <TextView
            android:textColor="@color/texticon_tertiary"
            android:ellipsize="end"
            android:id="@+id/tv_explain_bonus_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_explain_coins_text"
            app:layout_constraintStart_toEndOf="@+id/iv_explain_bonus_icon"
            app:layout_constraintTop_toTopOf="@+id/tv_explain_coins_text"
            style="@style/footnote_regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_balance_coins_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_coins_16"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_balance_bonus_text"
        app:layout_constraintEnd_toStartOf="@+id/tv_balance_coins_text"
        app:layout_constraintTop_toTopOf="@+id/tv_balance_bonus_text"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_balance_coins_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_balance_bonus_text"
        app:layout_constraintEnd_toStartOf="@+id/iv_balance_bonus_icon"
        app:layout_constraintTop_toTopOf="@+id/tv_balance_bonus_text"
        app:layout_goneMarginEnd="16dp"
        style="@style/body_bold"/>
    <ImageView
        android:id="@+id/iv_balance_bonus_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_bonus_16"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_balance_bonus_text"
        app:layout_constraintEnd_toStartOf="@+id/tv_balance_bonus_text"
        app:layout_constraintTop_toTopOf="@+id/tv_balance_bonus_text"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_balance_bonus_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layout"
        style="@style/body_bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
