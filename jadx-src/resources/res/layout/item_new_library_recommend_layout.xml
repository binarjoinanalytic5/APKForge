<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_new_library_recommend_layout_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/c_poster"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/img_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/v_book_poster_image_style"/>
        <com.newleaf.app.android.victor.view.BookMarkView
            android:layout_gravity="start|top"
            android:id="@+id/bookMarkView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/v_book_mark_style"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/iv_collect"
            android:background="@drawable/bg_80000000_corner2"
            android:padding="2dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/icon_item_video_collect_empty"
            android:layout_marginEnd="2dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/play_count_background"
            android:layout_width="match_parent"
            style="@style/v_bg_hall_item_bottom_mask"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:layout_gravity="end|bottom"
            android:id="@+id/tv_play_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:drawablePadding="1dp"
            android:drawableStart="@drawable/icon_play_count"
            android:layout_marginEnd="4dp"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/c_poster"
        style="@style/body_medium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/color_ffffff_alpha_50"
        android:ellipsize="end"
        android:id="@+id/tv_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_book_name"
        style="@style/footnote_medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
