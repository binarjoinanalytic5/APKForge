<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="1dp"
    android:paddingHorizontal="6dp">
    <View
        android:id="@+id/img_video_collect_guide_click"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="5dp"
        android:layout_alignParentEnd="true"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/img_video_collect_guide_hand"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="-18dp"
        android:layout_alignParentEnd="true"
        app:lottie_autoPlay="true"
        app:lottie_fileName="interact_player_guidelines.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:background="@drawable/icon_guide_right_arrow_text_bg"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/for_you_guide_text3"
        android:layout_alignTop="@+id/img_video_collect_guide_click"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:layout_toStartOf="@+id/img_video_collect_guide_click"/>
</RelativeLayout>
