<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:tag="layout/player_m_view_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.newleaf.app.android.victor.view.RecyclerViewAtPlayer
        android:id="@+id/recycle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/title_space"
        layout="@layout/include_statusbar_space"/>
    <include
        android:id="@+id/include_level_tag"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:layout_below="@+id/title_space"
        layout="@layout/include_layout_level_tag"/>
    <com.newleaf.app.android.victor.view.KoLevelTagView
        android:id="@+id/view_ko_level_tag"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:layout_below="@+id/title_space"/>
    <ViewStub
        android:id="@+id/vs_ai_level_tag"
        android:layout="@layout/view_ai_level_tag_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:layout_below="@+id/title_space"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:textColor="#ffffe3bf"
        android:gravity="center"
        android:id="@+id/tv_landing_toast"
        android:background="@drawable/bg_landing_toast"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="343dp"
        android:layout_height="78dp"
        android:layout_marginTop="104dp"
        android:maxLines="2"
        android:layout_centerHorizontal="true"
        android:textAllCaps="true"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:autoSizeMaxTextSize="20sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"/>
    <com.newleaf.app.android.victor.player.dialog.PlayerMultipleControlView2
        android:id="@+id/player_control_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/view_stub_player_land_control_view"
        android:visibility="gone"
        android:layout="@layout/view_stub_player_land_control_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.newleaf.app.android.victor.view.floatview.WatchTaskFloatContainer
        android:id="@+id/view_watch_float"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:location="standard"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_pip_tips"
        android:background="@color/color_black"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <com.newleaf.app.android.victor.player.widgetView.PreviewLayout
        android:id="@+id/vs_preview"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"/>
    <com.newleaf.app.android.victor.player.view.RecommendView
        android:id="@+id/player_recommend"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_alignParentBottom="true"/>
    <com.newleaf.app.android.victor.player.view.CompletePlayRewardView
        android:id="@+id/view_complete_reward"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/vs_recommend"
        android:layout="@layout/player_recommend_float_layout"
        android:layout_width="232dp"
        android:layout_height="136dp"
        android:layout_marginBottom="66dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"/>
    <ViewStub
        android:id="@+id/vs_remind"
        android:layout="@layout/player_remind_float_layout"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_marginBottom="80dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <FrameLayout
        android:id="@+id/promotion_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="56dp"
        android:layout_alignParentBottom="true"/>
    <com.newleaf.app.android.victor.player.view.UnlockControlHelpView
        android:id="@+id/unlock_control_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/ima_container"
        android:visibility="gone"
        android:layout="@layout/player_ima_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/vs_speed_player"
        android:visibility="gone"
        android:layout="@layout/view_for_you_two_player_layout"
        android:layout_width="155dp"
        android:layout_height="40dp"/>
    <ViewStub
        android:id="@+id/view_stub_hd_overlayView"
        android:visibility="gone"
        android:layout="@layout/view_hd_over_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/view_stub_hd_experience_overlay_view_su"
        android:visibility="gone"
        android:layout="@layout/player_hd_experience_su_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
</RelativeLayout>
