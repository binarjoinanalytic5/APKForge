<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/cc_black"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/cc_rl_title"
        android:background="@color/cc_black"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageView
            android:id="@+id/cc_iv_title_left"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@mipmap/cc_header_title_back_white"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/cc_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/cc_tv_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/cc_iv_title_right"
            android:layout_toEndOf="@+id/cc_iv_title_left"/>
        <ImageView
            android:id="@+id/cc_iv_title_right"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@mipmap/cc_header_title_close_white"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/cc_white"
            android:gravity="center"
            android:id="@+id/cc_tv_countdown"
            android:background="@drawable/cc_countdown_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:minWidth="36dp"
            android:layout_centerVertical="true"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.coupon.standings.widget.AdvancedWebView
            android:id="@+id/cc_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/cc_progress_loading"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:indeterminateDrawable="@drawable/rotate_loading"
            android:indeterminateDuration="1500"/>
    </FrameLayout>
</LinearLayout>
