<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:tag="layout/player_preview_float_layout_0"
    android:background="@drawable/bg_1f1f1f_alpha90_corner4"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <View
        android:id="@+id/view_gradient_bg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_count_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/texticon_primary"
            android:gravity="center_vertical"
            android:id="@+id/tv_preview"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/preview_for"
            android:includeFontPadding="false"
            android:paddingStart="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/texticon_primary"
            android:gravity="center"
            android:id="@+id/tv_count_down_time_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_preview"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/texticon_primary"
            android:gravity="center_vertical"
            android:id="@+id/tv_splite"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_count_down_time_minute"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/texticon_primary"
            android:gravity="center"
            android:id="@+id/tv_count_down_time_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_splite"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/spline"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/preview_float_vip_icon"
        android:layout_centerVertical="true"
        android:contentDescription="@string/vip_text"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cl_count_down"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fff2ca91"
        android:gravity="center"
        android:id="@+id/tv_unlock"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/unlock"
        android:maxLines="1"
        android:lines="1"
        android:includeFontPadding="false"
        android:layout_centerVertical="true"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="12dp"
        app:drawableEndCompat="@drawable/preview_icon_arr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/spline"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
