<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_content"
    android:tag="layout/fragment_hall_discover_second_channel_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null">
    <include
        android:id="@+id/space"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_statusbar_space"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_page2"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:overScrollMode="never"/>
    <FrameLayout
        android:id="@+id/fl_second_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toBottomOf="@+id/space">
        <ViewStub
            android:id="@+id/vs_second_tab"
            android:layout="@layout/view_discover_second_layout"
            android:layout_width="match_parent"
            android:layout_height="31dp"/>
        <ViewStub
            android:id="@+id/vs_filter_tab"
            android:layout="@layout/view_discover_filter_layout"
            android:layout_width="match_parent"
            android:layout_height="23dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
