<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_bind_email_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/title_view"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_back"
        android:padding="5dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/icon_back_white"
        android:layout_centerVertical="true"
        android:layout_marginStart="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_view"/>
    <ImageView
        android:id="@+id/iv_email_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2.5dp"
        android:src="@drawable/icon_email_page_element1"
        app:layout_constraintBottom_toBottomOf="@+id/s_line"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tv_bind_email_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="83dp"
        android:text="@string/bind_email_title"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_email_page_element2"
        app:layout_constraintBottom_toBottomOf="@+id/s_line"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/s_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="120.5dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_back"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_back">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_input_email_parent_view"
                android:background="@drawable/shape_white_corners_6_bg"
                android:paddingBottom="28dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="352dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_input_email_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginRight="24dp"
                    android:text="@string/bind_email_desc"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_c1c1c1"
                    android:id="@+id/et_input_email"
                    android:background="@drawable/bg_bind_email_edit_view_selector"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="36dp"
                    android:layout_marginRight="24dp"
                    android:hint="@string/bind_email_input_email_hint"
                    android:layout_marginHorizontal="24dp"
                    android:paddingHorizontal="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_input_email_desc"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/color_e83a57"
                    android:id="@+id/tv_email_error_tips"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/bind_email_input_email_error_tips"
                    android:layout_marginStart="15dp"
                    app:layout_constraintEnd_toEndOf="@+id/et_input_email"
                    app:layout_constraintStart_toStartOf="@+id/et_input_email"
                    app:layout_constraintTop_toBottomOf="@+id/et_input_email"/>
                <TextView
                    android:enabled="false"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_send_email"
                    android:background="@drawable/bg_bind_email_send_btn_selector"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="60dp"
                    android:layout_marginRight="24dp"
                    android:text="@string/bind_email_send_email_text"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/et_input_email"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_email_send_complete_parent_view"
                android:background="@drawable/shape_white_corners_6_bg"
                android:paddingBottom="28dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="352dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_email_send_complete_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginRight="24dp"
                    android:text="@string/bind_email_send_complete_desc"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_send_complete_email"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:maxLines="2"
                    android:paddingHorizontal="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_email_send_complete_desc"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_send_complete_ok"
                    android:background="@drawable/bg_e83a57_corner_6"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="48dp"
                    android:layout_marginRight="24dp"
                    android:text="@string/ok"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_send_complete_email"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/color_e83a57"
                    android:gravity="center"
                    android:id="@+id/tv_send_complete_change_email"
                    android:background="@drawable/bg_e83a57_border_corner_6"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginRight="24dp"
                    android:text="@string/bind_email_change_address_text"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_send_complete_ok"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
