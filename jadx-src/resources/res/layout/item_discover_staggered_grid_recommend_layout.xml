<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_discover_staggered_grid_recommend_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/v_discover_staggered_grid_card_view">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_book_poster"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_book_gif"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.newleaf.app.android.victor.view.BookMarkView
            android:id="@+id/bookMarkView"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
            app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
            style="@style/v_book_mark_style"/>
        <FrameLayout
            android:id="@+id/cl_continue_watch"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
            app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
            app:layout_constraintStart_toStartOf="@+id/iv_book_poster">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_ffffff_alpha_90"
                android:layout_gravity="center"
                android:id="@+id/tv_continue_watch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_grid_continue"
                android:drawablePadding="1dp"
                android:drawableStart="@drawable/icon_play_count"/>
        </FrameLayout>
        <View
            android:id="@+id/play_count_background"
            android:layout_width="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
            app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
            app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
            style="@style/v_bg_hall_item_bottom_mask_no_radius"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:id="@+id/tv_chapter_count"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:drawablePadding="1dp"
            android:drawableStart="@drawable/icon_hall_chapter"
            app:layout_constraintBottom_toBottomOf="@+id/play_count_background"
            app:layout_constraintStart_toStartOf="@+id/play_count_background"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:id="@+id/tv_play_count"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:drawablePadding="1dp"
            android:drawableStart="@drawable/icon_play_count"
            app:layout_constraintBottom_toBottomOf="@+id/play_count_background"
            app:layout_constraintEnd_toEndOf="@+id/play_count_background"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:maxLines="2"
            android:lineSpacingMultiplier="0.88"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_book_poster"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff_alpha_50"
            android:ellipsize="end"
            android:id="@+id/tv_share_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:maxLines="2"
            android:lineSpacingMultiplier="0.88"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_share_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
