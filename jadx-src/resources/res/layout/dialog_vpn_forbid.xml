<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/dialog_vpn_forbid_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center"
        android:background="@drawable/bg_ffffff_corner_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_vpn"
            android:background="@drawable/icon_vpn_forbid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff151515"
            android:gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:minHeight="50dp"
            android:layout_below="@+id/iv_vpn"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:background="@drawable/bg_e83a57_corner_5"
            android:layout_width="223dp"
            android:layout_height="44dp"
            android:layout_marginTop="34dp"
            android:layout_below="@+id/tv_content"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/rl_feedback"
            android:background="@drawable/bg_e83a57_border_corner_6"
            android:layout_width="223dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="25dp"
            android:layout_below="@+id/tv_ok"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_e83a57"
                android:id="@+id/tv_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback"
                android:drawablePadding="5dp"
                android:layout_centerInParent="true"
                android:drawableStart="@drawable/icon_question_red"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
