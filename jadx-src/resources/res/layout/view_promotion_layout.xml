<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/cl_small_level_view"
        android:tag="layout/view_promotion_layout_0"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="140dp"
        android:layout_marginStart="18dp"
        app:layoutDescription="@xml/item_video_for_you_scene"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/view_small_level_bg"
            android:layout_width="289dp"
            android:layout_height="62dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/iv_image"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_small_level_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"
            app:radius="5dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_promotion_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_promotion_action"
            app:layout_constraintStart_toEndOf="@+id/iv_image"
            app:layout_constraintTop_toTopOf="@+id/iv_image"/>
        <com.newleaf.app.android.victor.view.bannertextview.TextBannerView
            android:id="@+id/tv_promotion_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/tv_promotion_title"
            app:layout_constraintStart_toStartOf="@+id/tv_promotion_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_promotion_title"
            app:setAnimDuration="1000"
            app:setDirection="bottom_to_top"
            app:setGravity="left"
            app:setInterval="1000"
            app:setMaxLine="2"
            app:setTextColor="@color/color_e7e7e7"
            app:setTextSize="12sp"/>
        <View
            android:id="@+id/action_bg1"
            android:layout_width="85dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_small_level_bg"
            app:layout_constraintEnd_toEndOf="@+id/view_small_level_bg"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"/>
        <View
            android:id="@+id/action_bg2"
            android:layout_width="85dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_small_level_bg"
            app:layout_constraintEnd_toEndOf="@+id/view_small_level_bg"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_promotion_action"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="85dp"
            android:layout_height="34dp"
            android:text="Hol&apos;s dir"
            android:maxLines="1"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_small_level_bg"
            app:layout_constraintEnd_toEndOf="@+id/view_small_level_bg"
            app:layout_constraintTop_toTopOf="@+id/view_small_level_bg"/>
        <ImageView
            android:id="@+id/iv_promotion_pop1_close"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_promotion_close_icon_layer"
            android:contentDescription="@string/description_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.motion.widget.MotionLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/cl_large_level_view"
        android:tag="layout/view_promotion_layout_1"
        android:visibility="gone"
        android:layout_width="262dp"
        android:layout_height="135dp"
        android:layout_marginStart="18dp">
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/iv_large_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:radius="6dp"/>
        <ImageView
            android:id="@+id/iv_promotion_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_promotion_close_icon_layer"
            android:contentDescription="@string/description_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
