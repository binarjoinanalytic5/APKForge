<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_like1"
        android:layout_width="18dp"
        android:layout_height="23dp"
        android:src="@drawable/icon_vote_hot_like"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textColor="#ffffe9d6"
        android:id="@+id/tv_like_num_pop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="x1"
        android:includeFontPadding="false"
        android:fontFamily="@font/noto_sans_3"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_like1"
        app:layout_constraintStart_toEndOf="@+id/iv_like1"
        app:layout_constraintTop_toTopOf="@+id/iv_like1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
