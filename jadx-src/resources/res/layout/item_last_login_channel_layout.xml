<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_last_login_channel_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="#ffff5757"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@+id/v_login_channel"
        app:layout_constraintTop_toTopOf="@+id/tv_pop_text"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_white"
        android:gravity="center_vertical"
        android:id="@+id/tv_pop_text"
        android:paddingTop="1dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="29dp"
        app:layout_constraintEnd_toEndOf="@+id/v_login_channel"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:gravity="center_vertical"
        android:id="@+id/v_login_channel"
        android:background="@drawable/bg_3e67b5_corner_4"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pop_text"/>
    <ImageView
        android:id="@+id/iv_reward_coin"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/icon_login_coin"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pop_text"
        app:layout_constraintEnd_toEndOf="@+id/v_login_channel"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icon_facebook_white"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_login_channel"
        app:layout_constraintStart_toStartOf="@+id/v_login_channel"
        app:layout_constraintTop_toTopOf="@+id/v_login_channel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_login_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:text="@string/sign_in_with_facebook"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="0.5sp"
        android:autoSizeMinTextSize="10sp"
        android:layout_marginHorizontal="48dp"
        android:autoSizeMaxTextSize="16sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_login_channel"
        app:layout_constraintEnd_toEndOf="@+id/v_login_channel"
        app:layout_constraintStart_toStartOf="@+id/v_login_channel"
        app:layout_constraintTop_toTopOf="@+id/v_login_channel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
