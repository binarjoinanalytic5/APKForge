<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/iv_big_image"
        android:layout_width="40dp"
        android:layout_height="54dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="8dp"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textAppearance="@style/v_notification_title"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textAppearance="@style/v_notification_info"
            android:textColor="@color/color_99000000_to_99ffffff"
            android:ellipsize="end"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:layout_width="40dp"
        android:layout_height="32dp"
        android:src="@drawable/icon_notification_small_right_live"
        android:scaleType="fitCenter"
        android:layout_marginStart="16dp"/>
</LinearLayout>
