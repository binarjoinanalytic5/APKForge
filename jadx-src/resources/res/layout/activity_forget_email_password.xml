<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/activity_forget_email_password_0"
    android:background="@color/profile_common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/space"
        layout="@layout/include_statusbar_space"/>
    <View
        android:id="@+id/bg_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_exit"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/icon_return"
        android:contentDescription="@string/description_back"
        android:layout_marginStart="6dp"
        android:paddingVertical="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"/>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_exit">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="32sp"
                android:textColor="@color/color_ffffff_alpha_90"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/reset_password"
                android:maxLines="1"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffffff_alpha_70"
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:text="@string/reset_password_sutitle"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffffff_alpha_90"
                android:id="@+id/tv_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="16dp"
                android:text="@string/email_text"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="14sp"
                android:textColor="@color/color_ffffff_alpha_90"
                android:textColorHint="@color/color_ffffff_alpha_30"
                android:id="@+id/et_input_email"
                android:background="@drawable/login_edittext_bg_selector"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="16dp"
                android:hint="@string/please_input_valid_email_address"
                android:inputType="textEmailAddress"
                android:textCursorDrawable="@drawable/search_edit_cursor"
                android:layout_marginHorizontal="16dp"
                android:paddingHorizontal="16dp"
                android:importantForAutofill="no"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_email"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_e52e2e"
                android:id="@+id/tv_email_error_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="16dp"
                android:text="@string/email_format_err"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_input_email"/>
            <TextView
                android:enabled="false"
                android:textSize="16sp"
                android:textColor="@drawable/email_code_button_text_selector"
                android:gravity="center"
                android:id="@+id/tv_next_action"
                android:background="@drawable/email_code_button_bg_selector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="59dp"
                android:layout_marginRight="16dp"
                android:text="@string/next"
                android:contentDescription="@string/next"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_input_email"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
