<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_layout_balance_and_sku_v2_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/color_white90"
            android:ellipsize="end"
            android:id="@+id/tv_tips_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/insufficient_balance_recharge_unlock"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_view_all"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/title3_bold"/>
        <ImageView
            android:id="@+id/img_icon_coins2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_coins_16"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_tips_balance"
            app:layout_constraintStart_toEndOf="@+id/tv_tips_balance"
            app:layout_constraintTop_toTopOf="@+id/tv_tips_balance"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_white90"
            android:id="@+id/tv_balance_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/img_icon_coins2"
            app:layout_constraintStart_toEndOf="@+id/img_icon_coins2"
            app:layout_constraintTop_toTopOf="@+id/img_icon_coins2"
            style="@style/title3_bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_tertiary"
            android:id="@+id/tv_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_all"
            android:includeFontPadding="false"
            android:drawableEnd="@drawable/icon_arrow_right_alpha50"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_tips_balance"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/footnote_regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sku"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@+id/cl_title"/>
    <include
        android:id="@+id/include_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_sku"
        layout="@layout/item_vip_subscribe_more_button_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
