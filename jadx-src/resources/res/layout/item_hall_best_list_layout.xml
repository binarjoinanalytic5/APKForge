<?xml version="1.0" encoding="utf-8"?>
<com.newleaf.app.android.victor.view.roundview.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginHorizontal="16dp"
    app:rRadius="4dp">
    <View
        android:id="@+id/v_bg"
        android:background="@color/color_141414"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toStartOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"/>
    <ImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="102dp"
        android:layout_height="136dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/v_book_poster_image_style"/>
    <com.newleaf.app.android.victor.view.BookMarkView
        android:id="@+id/bookMarkView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
        style="@style/v_book_mark_style"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:gravity="center_vertical"
        android:id="@+id/tv_play_count"
        android:background="@drawable/bg_000000_alpha65_corner2"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginBottom="4dp"
        android:drawablePadding="1dp"
        android:layout_marginEnd="4dp"
        android:elevation="0.5dp"
        android:paddingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"/>
    <ImageView
        android:id="@+id/iv_quotation_mark"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/icon_hall_quotation_mark"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:ellipsize="end"
        android:id="@+id/tv_book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintStart_toStartOf="@+id/v_bg"
        app:layout_constraintTop_toTopOf="@+id/v_bg"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:id="@+id/tv_mark1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_special_desc"
        app:layout_constraintEnd_toStartOf="@+id/tv_special_desc"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/v_bg"
        app:layout_constraintTop_toTopOf="@+id/tv_special_desc"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:ellipsize="end"
        android:id="@+id/tv_special_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/ll_tag"
        app:layout_constraintEnd_toStartOf="@+id/tv_mark2"
        app:layout_constraintStart_toEndOf="@+id/tv_mark1"
        app:layout_goneMarginBottom="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:id="@+id/tv_mark2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_special_desc"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintStart_toEndOf="@+id/tv_special_desc"
        app:layout_constraintTop_toTopOf="@+id/tv_special_desc"/>
    <com.newleaf.app.android.victor.view.ItemFilterTagLayout
        android:orientation="horizontal"
        android:id="@+id/ll_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintStart_toStartOf="@+id/v_bg">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_ffffff_alpha_70"
            android:ellipsize="end"
            android:id="@+id/tv_tag1"
            android:background="@drawable/bg_white15_r4"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_ffffff_alpha_70"
            android:ellipsize="end"
            android:id="@+id/tv_tag2"
            android:background="@drawable/bg_white15_r4"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"/>
    </com.newleaf.app.android.victor.view.ItemFilterTagLayout>
</com.newleaf.app.android.victor.view.roundview.RoundConstraintLayout>
