<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/player_recommend_view_0"
    android:background="@drawable/bg_00000000_ff000000"
    android:layout_width="match_parent"
    android:layout_height="250dp">
    <ImageView
        android:id="@+id/iv_arrow_left"
        android:background="@drawable/bg_recommend_dir"
        android:layout_width="23dp"
        android:layout_height="50dp"
        android:layout_marginTop="112dp"
        android:src="@drawable/icon_arrow_left"
        android:scaleType="center"
        android:contentDescription="@string/description_previous"
        android:layout_marginStart="8dp"/>
    <ImageView
        android:id="@+id/iv_arrow_right"
        android:background="@drawable/bg_recommend_dir"
        android:layout_width="23dp"
        android:layout_height="50dp"
        android:layout_marginTop="112dp"
        android:src="@drawable/icon_arrow_right"
        android:scaleType="center"
        android:contentDescription="@string/next"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recommend"
        android:layout_width="match_parent"
        android:layout_height="169dp"
        android:layout_marginTop="52dp"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="38dp"/>
    <ImageView
        android:id="@+id/iv_close"
        android:background="@drawable/icon_close_2"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="53dp"
        android:contentDescription="@string/description_close"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
