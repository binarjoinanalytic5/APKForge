<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_video_card_common_0"
    android:background="@color/backgrounds_background_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/include_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_btn_bg"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:scaleType="fitXY"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/include_bottom"
        app:layout_constraintEnd_toEndOf="@+id/img_view"
        app:layout_constraintStart_toStartOf="@+id/img_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/tv_btn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/include_bottom"
        app:layout_constraintEnd_toEndOf="@+id/img_view"
        app:layout_constraintStart_toStartOf="@+id/img_view"
        style="@style/body_bold"/>
    <FrameLayout
        android:id="@+id/load_layout"
        android:background="@color/backgrounds_background_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/load_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:lottie_autoPlay="false"
            app:lottie_fileName="novel_loading_night.json"
            app:lottie_loop="true"/>
    </FrameLayout>
    <include
        android:id="@+id/include_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/include_layout_video_card_bottom_view"/>
    <include
        android:id="@+id/title_bar"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_title_transparent_background_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
