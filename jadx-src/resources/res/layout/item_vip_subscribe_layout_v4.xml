<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/item_vip_subscribe_layout_v4_0"
    android:layout_width="146dp"
    android:layout_height="112dp">
    <ImageView
        android:id="@+id/img_bg_icon"
        android:visibility="gone"
        android:layout_width="163dp"
        android:layout_height="113dp"
        android:src="@drawable/icon_vip_v_mark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="#e5fee0b8"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="12dp"
        app:autoSizeMaxTextSize="@dimen/fontSize_7"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body_regular"/>
    <com.newleaf.app.android.victor.view.ObliqueLineTextView
        android:textColor="#80fee0b8"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_underline_price"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-3dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        app:autoSizeMaxTextSize="@dimen/fontSize_10"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@+id/tv_vip_price"
        app:layout_constraintStart_toStartOf="parent"
        app:lineColor="#80fee0b8"
        app:lineStyle="styleHorizontalCenter"
        app:lineWidth="1dp"
        style="@style/footnote_regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="#fffee0b8"
        android:id="@+id/tv_vip_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="11dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        app:autoSizeMaxTextSize="@dimen/fontSize_2"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeStepGranularity="1px"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/title2_bold"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_mark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.newleaf.app.android.victor.view.CountDownText
            android:textSize="10sp"
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_count_down_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            app:autoSizeMaxTextSize="10sp"
            app:autoSizeMinTextSize="4sp"
            app:autoSizeStepGranularity="0.1sp"
            app:autoSizeTextType="uniform"/>
        <View
            android:id="@+id/v_dividing_line"
            android:background="@color/line_outline"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/texticon_primary"
            android:gravity="center_vertical"
            android:id="@+id/tv_text_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
