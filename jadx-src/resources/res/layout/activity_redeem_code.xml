<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_redeem_code_0"
    android:background="@color/profile_common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/ll_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_title_bar"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/v_bg"
                android:background="@drawable/bg_222222_alpha_90_corner_6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="20dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/space"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_redemption_icon"
                android:layout_width="259dp"
                android:layout_height="153dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/icon_redemption_code"
                app:layout_constraintEnd_toEndOf="@+id/v_bg"
                app:layout_constraintStart_toStartOf="@+id/v_bg"
                app:layout_constraintTop_toTopOf="@+id/v_bg"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/tv_code_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="28dp"
                android:layout_marginBottom="5dp"
                android:text="@string/exchange_code_des"
                android:layout_marginHorizontal="28dp"
                app:layout_constraintEnd_toEndOf="@+id/v_bg"
                app:layout_constraintStart_toStartOf="@+id/v_bg"
                app:layout_constraintTop_toBottomOf="@+id/iv_redemption_icon"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/color_222222"
                android:textColorHint="@color/color_222222_alpha_20"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/et_exchange"
                android:background="@drawable/bg_ffffff_corner_6"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="28dp"
                android:hint="@string/enter_code_hint"
                android:singleLine="true"
                android:maxLength="6"
                android:layout_marginHorizontal="28dp"
                android:paddingHorizontal="10dp"
                app:layout_constraintEnd_toEndOf="@+id/v_bg"
                app:layout_constraintStart_toStartOf="@+id/v_bg"
                app:layout_constraintTop_toBottomOf="@+id/tv_code_title"/>
            <TextView
                android:enabled="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_ffffff_alpha_30"
                android:gravity="center"
                android:id="@+id/tv_exchange"
                android:background="@drawable/bg_ffffff_alpha_10_corner6"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="28dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="28dp"
                android:text="@string/ok"
                android:layout_marginHorizontal="28dp"
                app:layout_constraintEnd_toEndOf="@+id/v_bg"
                app:layout_constraintStart_toStartOf="@+id/v_bg"
                app:layout_constraintTop_toBottomOf="@+id/et_exchange"/>
            <androidx.legacy.widget.Space
                android:id="@+id/space"
                android:layout_width="0dp"
                android:layout_height="24dp"
                app:layout_constraintEnd_toEndOf="@+id/v_bg"
                app:layout_constraintStart_toStartOf="@+id/v_bg"
                app:layout_constraintTop_toBottomOf="@+id/tv_exchange"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_ffffff_alpha_90"
                android:id="@+id/tv_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="20dp"
                android:text="@string/tips"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_bg"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_ffffff_alpha_70"
                android:id="@+id/tv_tips_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="20dp"
                android:text="@string/exchange_code_tips_content"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
            <androidx.legacy.widget.Space
                android:layout_width="match_parent"
                android:layout_height="30dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_tips_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
