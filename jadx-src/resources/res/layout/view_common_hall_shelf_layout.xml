<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff_alpha_90"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_shelf_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/iv_quesion"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_ececec_alpha50"
        android:id="@+id/tv_shelf_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="7dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_shelf_name"/>
    <ImageView
        android:id="@+id/iv_quesion"
        android:background="@drawable/icon_question"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/description_rule"
        app:layout_constraintBottom_toBottomOf="@+id/tv_shelf_name"
        app:layout_constraintEnd_toStartOf="@+id/fl_see_all"
        app:layout_constraintStart_toEndOf="@+id/tv_shelf_name"
        app:layout_constraintTop_toTopOf="@+id/tv_shelf_name"/>
    <FrameLayout
        android:id="@+id/fl_see_all"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingHorizontal="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_shelf_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_shelf_name">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_right_arrow48"
            android:contentDescription="@string/description_see_all"/>
    </FrameLayout>
    <com.newleaf.app.android.victor.view.RecyclerViewAtViewPager2
        android:id="@+id/rlv_list"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:layout_marginStart="16dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toBottomOf="@+id/tv_shelf_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
