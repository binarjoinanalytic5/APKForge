<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="#ffffd4a2"
        android:gravity="center"
        android:id="@+id/tv_coins"
        android:tag="layout/view_vip_reward_bubble_layout_0"
        android:background="@drawable/bg_vip_reward_bubble"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:text="@string/vip_bubble_claim"
        android:drawableLeft="@drawable/icon_vip_point"
        android:drawablePadding="2dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        style="@style/body_bold"/>
    <View
        android:id="@+id/view_arrow"
        android:tag="layout/view_vip_reward_bubble_layout_1"
        android:background="@drawable/icon_vip_reward_bubble_down_arrow"
        android:layout_width="8dp"
        android:layout_height="4dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_coins"
        app:layout_constraintStart_toStartOf="@+id/tv_coins"
        app:layout_constraintTop_toBottomOf="@+id/tv_coins"/>
</merge>
