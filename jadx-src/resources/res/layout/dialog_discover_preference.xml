<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:tag="layout/dialog_discover_preference_0"
    android:background="@drawable/bg_backgrounds_background_2_top_r16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_top_mask"
        android:layout_width="0dp"
        android:layout_height="200dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.newleaf.app.android.victor.view.AutoSizeWrapContentTextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        app:awcMaxTextSize="16sp"
        app:awcMinTextSize="12sp"
        app:awcStepGranularity="0.5sp"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/title3_bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:src="@drawable/icon_white_circle_close_24"
        android:scaleType="fitCenter"
        android:contentDescription="@string/description_close"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_header_divider"
        android:background="@color/line_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.newleaf.app.android.victor.view.MaxHeightRecyclerView
        android:id="@+id/rv_preference"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/footer_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_header_divider"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/footer_container"
        android:background="@color/backgrounds_background_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_preference">
        <View
            android:id="@+id/v_footer_divider"
            android:background="@color/line_outline"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:enabled="false"
            android:textColor="@color/preference_save_button_text_selector"
            android:gravity="center"
            android:id="@+id/tv_save"
            android:background="@drawable/email_code_button_bg_selector"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/preference_save"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            style="@style/body_bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
