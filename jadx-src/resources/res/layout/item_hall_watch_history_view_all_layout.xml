<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/cl_root"
    android:background="@drawable/bg_ffffff_alpha_10_corner4"
    android:layout_width="80dp"
    android:layout_height="88dp">
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:text="@string/view_all"
        android:lineSpacingMultiplier="0.88"
        android:layout_marginHorizontal="8dp"
        style="@style/footnote_regular"/>
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="13dp"
        android:layout_height="12dp"
        android:layout_marginTop="9dp"
        android:src="@drawable/icon_alpha_right_arrow"/>
</LinearLayout>
