<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_content_parent"
    android:tag="layout/view_play_watch_task_float_test3_layout_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.view.AnimatablePillProgressView
        android:id="@+id/pb_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff_alpha_90"
        android:gravity="center_horizontal"
        android:id="@+id/tv_reward_coins"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+15"
        android:maxLines="1"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="7sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/pb_progress"
        app:layout_constraintLeft_toLeftOf="@+id/pb_progress"
        app:layout_constraintRight_toRightOf="@+id/pb_progress"
        app:layout_constraintTop_toTopOf="@+id/pb_progress"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_claim"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/claim"
        android:maxLines="1"
        android:alpha="0"
        android:layout_marginStart="15dp"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="0.1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@+id/pb_progress"
        app:layout_constraintLeft_toLeftOf="@+id/pb_progress"
        app:layout_constraintRight_toLeftOf="@+id/tv_reward_coins"
        app:layout_constraintTop_toTopOf="@+id/pb_progress"
        style="@style/footnote_medium"/>
    <ImageView
        android:id="@+id/img_coins"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/icon_reward_floating_coins"
        app:layout_constraintBottom_toBottomOf="@+id/pb_progress"
        app:layout_constraintLeft_toLeftOf="@+id/pb_progress"
        app:layout_constraintRight_toRightOf="@+id/pb_progress"
        app:layout_constraintTop_toTopOf="@+id/pb_progress"/>
    <TextView
        android:textColor="#ff531f13"
        android:gravity="center"
        android:id="@+id/btn_claim"
        android:background="@drawable/bg_float_claim"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="24dp"
        android:layout_marginTop="-14dp"
        android:text="@string/claim"
        app:layout_constraintLeft_toLeftOf="@+id/pb_progress"
        app:layout_constraintRight_toRightOf="@+id/pb_progress"
        app:layout_constraintTop_toBottomOf="@+id/pb_progress"
        style="@style/caption_medium"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/btn_coins"
        android:visibility="gone"
        android:layout_width="35dp"
        android:layout_height="16dp"
        android:layout_marginTop="-7dp"
        android:text="@string/coins"
        app:layout_constraintLeft_toLeftOf="@+id/pb_progress"
        app:layout_constraintRight_toRightOf="@+id/pb_progress"
        app:layout_constraintTop_toBottomOf="@+id/pb_progress"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reward_animation_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/pb_progress"
        app:layout_constraintLeft_toLeftOf="@+id/pb_progress"
        app:layout_constraintRight_toRightOf="@+id/pb_progress"
        app:layout_constraintTop_toTopOf="@+id/pb_progress">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/reward_animation"
            android:layout_width="67dp"
            android:layout_height="67dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="false"
            app:lottie_fileName="floating_reward_animation.json"
            app:lottie_loop="false"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
