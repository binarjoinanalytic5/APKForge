<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_layout_unlock_panel_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_white90"
        android:id="@+id/tv_tips_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/balance_text_"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_icon_coins2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_coins_16"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_tips_balance"
        app:layout_constraintStart_toEndOf="@+id/tv_tips_balance"
        app:layout_constraintTop_toTopOf="@+id/tv_tips_balance"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_white90"
        android:id="@+id/tv_balance_coins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon_coins2"
        app:layout_constraintStart_toEndOf="@+id/img_icon_coins2"
        app:layout_constraintTop_toTopOf="@+id/img_icon_coins2"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_unlock"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips_balance"
        app:layout_goneMarginTop="0dp"/>
    <CheckBox
        android:textSize="12sp"
        android:textColor="@color/color_ffffff_alpha_50"
        android:id="@+id/checkbox"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:checked="false"
        android:button="@null"
        android:text="@string/auto_unlock"
        android:includeFontPadding="false"
        android:drawablePadding="4dp"
        android:lineSpacingMultiplier="0.95"
        android:drawableStart="@drawable/checkbox_selector2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_unlock"/>
</androidx.constraintlayout.widget.ConstraintLayout>
