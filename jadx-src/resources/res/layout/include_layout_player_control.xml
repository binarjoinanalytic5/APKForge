<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/include_layout_player_control_0"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/layout_details"
        android:background="@drawable/bg_000000alpha0_to_000000alpha70"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:paddingStart="16dp"
        android:paddingEnd="96dp"
        android:paddingVertical="16dp">
        <View
            android:id="@+id/view_ad_measurement"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_details"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_details"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_detaile_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="0dp">
            <com.newleaf.app.android.victor.view.BookMarkView
                android:textSize="12sp"
                android:id="@+id/book_mark_view"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:lineSpacingMultiplier="0.88"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                app:bmv_radius="4dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginTop="12dp"
                style="@style/v_book_mark_style"/>
            <com.newleaf.app.android.victor.view.RoundImageView
                android:id="@+id/img_details_poster"
                android:visibility="gone"
                android:layout_width="33dp"
                android:layout_height="44dp"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/book_mark_view"
                app:layout_goneMarginTop="0dp"
                style="@style/v_book_poster_image_style"/>
            <FrameLayout
                android:id="@+id/fl_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/img_details_poster"
                app:layout_constraintTop_toBottomOf="@+id/book_mark_view"
                app:layout_goneMarginStart="0dp"
                app:layout_goneMarginTop="0dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/color_white90"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:drawablePadding="4dp"
                    android:lineSpacingMultiplier="0.88"
                    android:drawableEnd="@drawable/icon_player_bottom_arrow"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_landing_toast"
                android:background="@drawable/bg_search_best_theme_shape"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@+id/fl_title"
                app:layout_constraintStart_toStartOf="parent">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_hot"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="@color/texticon_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_landing_rank"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="4dp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeStepGranularity="0.5sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>
            <com.newleaf.app.android.victor.view.ItemFilterTagLayout
                android:orientation="horizontal"
                android:id="@+id/ll_tag"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/img_details_poster"
                app:layout_constraintTop_toBottomOf="@+id/book_mark_view"
                app:layout_goneMarginStart="0dp"
                app:layout_goneMarginTop="24dp">
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_tag1"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    style="@style/text_style_player_item_tag"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_tag2"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    style="@style/text_style_player_item_tag"/>
            </com.newleaf.app.android.victor.view.ItemFilterTagLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.newleaf.app.android.victor.view.ExpandTextView
            android:textSize="14sp"
            android:textColor="@color/color_white70"
            android:ellipsize="end"
            android:id="@+id/tv_detaile_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.88"
            app:btnName="@string/more"
            app:canCloseExpend="false"
            app:canCollapsedClickable="false"
            app:collapsedMaxLine="2"
            app:expendMaxLine="3"
            app:layout_constraintBottom_toTopOf="@+id/tv_watch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_goneMarginBottom="0dp"
            app:moreColor="@color/color_white90"
            app:showMore="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:gravity="center"
            android:id="@+id/tv_watch"
            android:background="@drawable/bg_ffffff_alpha_15_corner4"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/vs_hd_experience"
            android:background="@drawable/bg_4d000000_alpha90_corner4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginBottom="12dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/ll_details"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/orange_orange_1"
                android:gravity="center"
                android:id="@+id/tv_1080"
                android:background="@drawable/bg_f2ca91_corner4"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:text="1080P"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                style="@style/footnote_medium"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_primary"
                android:gravity="center"
                android:id="@+id/tv_hd_experience"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:text="@string/free_trial"
                android:layout_marginStart="8dp"
                style="@style/footnote_regular"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_right"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_arrow_right"
                android:adjustViewBounds="true"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_play_status"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/icon_pause2"
        android:contentDescription="@string/description_episode_status_pause"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/layout_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:layout_marginEnd="10dp">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_vote"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/text_vote"
            app:lottie_autoPlay="false"
            app:lottie_fileName="video_vote_entrance.json"
            app:lottie_loop="false"/>
        <TextView
            android:id="@+id/tv_vote_num"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/text_style_player_control"/>
        <ImageView
            android:id="@+id/iv_collect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/icon_item_video_collect_none_40"
            android:contentDescription="@string/collect"/>
        <TextView
            android:id="@+id/tv_collect_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/text_style_player_control"/>
        <ImageView
            android:id="@+id/iv_like"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/icon_item_video_like_none"/>
        <TextView
            android:id="@+id/tv_like_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/text_style_player_control"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <ImageView
                android:id="@+id/iv_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_item_video_more"
                android:contentDescription="@string/more"/>
            <View
                android:id="@+id/red_dot"
                android:background="@drawable/red_dot_shape"
                android:visibility="invisible"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignTop="@+id/iv_more"
                android:layout_alignEnd="@+id/iv_more"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/tv_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/more"
            style="@style/text_style_player_control"/>
    </LinearLayout>
</FrameLayout>
