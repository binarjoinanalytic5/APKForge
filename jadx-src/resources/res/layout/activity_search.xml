<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_search_0"
    android:background="@color/profile_common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/space"
        layout="@layout/include_statusbar_space"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_title_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_back"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_return"
            android:contentDescription="@string/description_delete_search_bar"
            android:paddingStart="18dp"
            android:paddingEnd="10dp"
            android:paddingVertical="12dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_search"
            android:background="@drawable/bg_search_no_input_shape"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp">
            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_search_text_left_gray"
                android:layout_marginStart="12dp"/>
            <EditText
                android:textColor="@color/texticon_primary"
                android:textColorHint="@color/texticon_quaternary"
                android:gravity="start|center_vertical"
                android:id="@+id/et_search"
                android:tag="binding_1"
                android:background="@color/transparent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/search_page_input_default"
                android:maxLength="100"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/search_edit_cursor"
                android:layout_marginStart="4dp"
                android:importantForAutofill="no"
                style="@style/headline_regular"/>
            <ImageView
                android:id="@+id/img_search_close"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/icon_close_play_catalog"
                android:contentDescription="@string/description_delete_search_bar"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smart_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_title_search">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rc_list"
            android:paddingBottom="18dp"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:tag="binding_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:elevation="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_title_search"
        app:load_fail_view_bg_color="@color/black"/>
</androidx.constraintlayout.widget.ConstraintLayout>
