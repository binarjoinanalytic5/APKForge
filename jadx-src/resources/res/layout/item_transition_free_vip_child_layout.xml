<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/item_transition_free_vip_child_layout_0"
    android:background="@drawable/bg_292929_corner_4"
    android:layout_width="match_parent"
    android:layout_height="76dp">
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/ll_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/white"
            android:ellipsize="end"
            android:layout_gravity="end"
            android:id="@+id/tv_vip_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="84dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:autoSizeMaxTextSize="@dimen/fontSize_7"
            app:autoSizeMinTextSize="5sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            style="@style/body_medium"/>
        <com.newleaf.app.android.victor.view.ObliqueLineTextView
            android:textColor="@color/color_white70"
            android:ellipsize="end"
            android:layout_gravity="end"
            android:id="@+id/tv_underline_price"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:lineColor="@color/color_white70"
            app:lineStyle="styleHorizontalCenter"
            app:lineWidth="1dp"
            style="@style/caption_regular"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/ll_price"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/body_bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/color_white70"
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll_price"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/caption_regular"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_mark"
        android:background="@drawable/bg_transition_free_vip_mark"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/color_white90"
            android:gravity="center_vertical"
            android:id="@+id/tv_text_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            style="@style/caption_medium"/>
        <View
            android:id="@+id/v_dividing_line"
            android:background="@color/texticon_quaternary"
            android:layout_width="1dp"
            android:layout_height="8dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginHorizontal="4dp"/>
        <com.newleaf.app.android.victor.view.CountDownText
            android:textColor="@color/color_white90"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_count_down_mark"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            style="@style/caption_medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
