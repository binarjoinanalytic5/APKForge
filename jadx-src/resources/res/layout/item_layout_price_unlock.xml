<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_layout_price_unlock_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_tips_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/price"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_icon_coins2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_coins_16"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_tips_price"
        app:layout_constraintStart_toEndOf="@+id/tv_tips_price"
        app:layout_constraintTop_toTopOf="@+id/tv_tips_price"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_price_coins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon_coins2"
        app:layout_constraintStart_toEndOf="@+id/img_icon_coins2"
        app:layout_constraintTop_toTopOf="@+id/img_icon_coins2"/>
    <include
        android:id="@+id/unlock_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips_price"
        layout="@layout/item_unlock_button_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
