<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:tag="layout/dialog_subscribe_interest_transfer_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_dialog_background_3_corner16"
        android:clipChildren="false"
        android:layout_width="315dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/texticon_primary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/v_user_bg"
            android:background="@drawable/bg_subscribe_interest_transfer_card"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginLeft="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="56dp"
            android:elevation="4dp"
            android:layout_marginHorizontal="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.newleaf.app.android.victor.view.UserAvatarView
            android:id="@+id/iv_user_head"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_user_bg"
            app:layout_constraintStart_toStartOf="@+id/v_user_bg"
            app:layout_constraintTop_toTopOf="@+id/v_user_bg"
            app:uaAvatarHeight="32dp"
            app:uaAvatarWidth="32dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_white"
            android:id="@+id/tv_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:elevation="4dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_user_vip"
            app:layout_constraintEnd_toEndOf="@+id/v_user_bg"
            app:layout_constraintStart_toEndOf="@+id/iv_user_head"
            app:layout_constraintTop_toTopOf="@+id/v_user_bg"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_ffffff_alpha_50"
            android:id="@+id/tv_user_vip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/vip_member"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_user_bg"
            app:layout_constraintEnd_toEndOf="@+id/v_user_bg"
            app:layout_constraintStart_toEndOf="@+id/iv_user_head"
            app:layout_constraintTop_toBottomOf="@+id/tv_user_name"/>
        <View
            android:id="@+id/v_user2_bg"
            android:background="@drawable/bg_subscribe_interest_transfer_card2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="76dp"
            android:layout_marginTop="-8dp"
            android:layout_marginRight="76dp"
            android:layout_marginHorizontal="76dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_user_bg"/>
        <com.newleaf.app.android.victor.view.UserAvatarView
            android:id="@+id/iv_user2_head"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_user2_bg"
            app:layout_constraintStart_toStartOf="@+id/v_user2_bg"
            app:layout_constraintTop_toTopOf="@+id/v_user2_bg"
            app:uaAvatarHeight="28dp"
            app:uaAvatarWidth="28dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff_alpha_70"
            android:id="@+id/tv_user2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_user2_bg"
            app:layout_constraintEnd_toEndOf="@+id/v_user2_bg"
            app:layout_constraintStart_toEndOf="@+id/iv_user2_head"
            app:layout_constraintTop_toTopOf="@+id/v_user2_bg"/>
        <ImageView
            android:layout_width="36dp"
            android:layout_height="72dp"
            android:layout_marginTop="11dp"
            android:src="@drawable/icon_vip_interest_transfer_arrow"
            app:layout_constraintStart_toEndOf="@+id/v_user_bg"
            app:layout_constraintTop_toTopOf="@+id/v_user_bg"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/texticon_fixed_primary"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_left"
            android:background="@drawable/bg_ffffff_alpha_10_corner4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/benefit_migration_button_no"
            android:singleLine="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_right"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_user2_bg"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/texticon_fixed_primary"
            android:gravity="center"
            android:id="@+id/tv_right"
            android:background="@drawable/bg_e52e2e_corner_4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/benefit_migration_button_yes"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_left"
            app:layout_constraintTop_toTopOf="@+id/tv_left"/>
        <Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_right"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
