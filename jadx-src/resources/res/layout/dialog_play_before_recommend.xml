<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_play_before_recommend_0"
    android:background="@drawable/bg_141414_top_corner_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="238dp">
    <View
        android:id="@+id/touch_bar"
        android:background="@drawable/bg_4dffffff_corner12"
        android:layout_width="64dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/recommend_for_you"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/touch_bar"
        app:layout_goneMarginTop="16dp"/>
    <ImageView
        android:id="@+id/close"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/icon_close_gray_bg"
        android:contentDescription="@string/description_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/recommend_layout"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <com.newleaf.app.android.victor.view.RoundImageView
            android:id="@+id/iv_book_poster"
            android:layout_width="111dp"
            android:layout_height="148dp"
            android:src="@drawable/icon_poster_default_big"
            style="@style/v_book_poster_image_style"/>
        <com.newleaf.app.android.victor.view.BookMarkView
            android:id="@+id/bookMarkView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/iv_book_poster"
            android:layout_alignStart="@+id/iv_book_poster"
            style="@style/v_book_mark_style"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/texticon_primary"
            android:id="@+id/tv_hot"
            android:background="@drawable/bg_black50_corner_2"
            android:paddingLeft="2dp"
            android:paddingTop="1dp"
            android:paddingRight="2dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:drawablePadding="2dp"
            android:layout_alignBottom="@+id/iv_book_poster"
            android:drawableStart="@drawable/icon_hall_hot"
            android:layout_alignEnd="@+id/iv_book_poster"
            android:paddingHorizontal="2dp"
            android:paddingVertical="1dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:id="@+id/tv_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/iv_book_poster"/>
        <com.newleaf.app.android.victor.view.ExpandableFlowLayout
            android:id="@+id/tag_layout"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/tv_book_title"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/iv_book_poster"
            app:childSpacing="4dp"
            app:childSpacingForLastRow="align"
            app:hGravity="left"
            app:maxRows="1"
            app:supportExpand="false"/>
        <RelativeLayout
            android:id="@+id/rl_play"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_alignBottom="@+id/iv_book_poster"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/iv_book_poster">
            <ProgressBar
                android:id="@+id/pb_progress"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:progressDrawable="@drawable/pb_4dffffff_e52e2e"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/play"
                android:drawablePadding="6dp"
                android:layout_centerInParent="true"
                app:drawableStartCompat="@drawable/icon_play_16"/>
        </RelativeLayout>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tag_recommend_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recommend_layout">
        <com.newleaf.app.android.victor.view.HorizontalScrollTabView
            android:id="@+id/tab_layout"
            android:fadingEdgeLength="20dp"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:requiresFadingEdge="horizontal"
            android:nestedScrollingEnabled="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_page2"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:minHeight="100dp"
            android:contentDescription="@null"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
