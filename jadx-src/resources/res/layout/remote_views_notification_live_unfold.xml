<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_big_image"
        android:layout_width="88dp"
        android:layout_height="118dp"
        android:scaleType="fitCenter"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="118dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp">
        <TextView
            android:textAppearance="@style/v_notification_title"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textAppearance="@style/v_notification_info"
            android:textSize="14sp"
            android:textColor="@color/color_99000000_to_99ffffff"
            android:ellipsize="end"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:background="@drawable/bg_remote_views_live_button"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/icon_notification_live_button"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textColor="@color/color_white"
                    android:ellipsize="end"
                    android:id="@+id/tv_btn1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_watch"
                    android:maxLines="1"
                    android:layout_marginStart="6dp"
                    style="@style/body_medium"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
