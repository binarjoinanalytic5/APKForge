<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_web_pay"
    android:tag="layout/dialog_pay_item_layout_0"
    android:background="@drawable/bg_background3_corner4"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_pay_name"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_marginTop="20dp"
        android:text="@string/web_purchase"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body_medium"/>
    <ImageView
        android:id="@+id/iv_pay_method"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_name"/>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_marginTop="3dp"
        android:text="@string/web_purchase"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/iv_pay_method"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_name"
        style="@style/footnote_regular"/>
    <ImageView
        android:id="@+id/iv_arror"
        android:background="@drawable/icon_arrow_right_alpha50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:id="@+id/tv_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_arror"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/title3_bold"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_bonus"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_arror"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_bonus_coin"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_coins_24"
            android:scaleType="centerInside"/>
        <TextView
            android:textColor="@color/texticon_primary"
            android:id="@+id/tv_bonus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            style="@style/body_bold"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_count_down_mark"
        android:background="@drawable/bg_item_sku_mark_2r_left"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:paddingHorizontal="8dp"
        app:autoSizeMaxTextSize="10sp"
        app:autoSizeMinTextSize="4sp"
        app:autoSizeStepGranularity="0.1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/caption_medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
