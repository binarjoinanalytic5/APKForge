<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_novel_control_panel_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_statusbar_space"/>
    <include
        android:id="@+id/include_level_tag"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        app:layout_constraintTop_toBottomOf="@+id/title_space"
        layout="@layout/include_layout_level_tag"/>
    <include
        android:id="@+id/title_bar"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/include_novel_title_bar"/>
    <ViewStub
        android:id="@+id/view_stub_guide"
        android:layout="@layout/view_book_read_guide"
        android:layout_width="140dp"
        android:layout_height="128dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom_setting"
        android:background="@color/backgrounds_background_2"
        android:paddingBottom="12dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:background="@color/line_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_secondary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_chapter_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintEnd_toStartOf="@+id/iv_next_chapter"
                app:layout_constraintStart_toEndOf="@+id/iv_last_chapter"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/footnote_regular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_tertiary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_chapter_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="8dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintEnd_toStartOf="@+id/iv_next_chapter"
                app:layout_constraintStart_toEndOf="@+id/iv_last_chapter"
                app:layout_constraintTop_toBottomOf="@+id/tv_chapter_name"
                app:layout_goneMarginTop="5dp"
                style="@style/caption_regular"/>
            <ImageView
                android:id="@+id/iv_last_chapter"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/comic_icon_last_chapter"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_next_chapter"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/comic_icon_next_chapter"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/fl_catalog"
            android:background="@drawable/bg_button_secondary_normal_r4"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_progress">
            <ImageView
                android:id="@+id/iv_catalog"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/comic_icon_catalog"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/fl_collection"
            android:background="@drawable/bg_button_secondary_normal_r4"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toStartOf="@+id/fl_like"
            app:layout_constraintStart_toEndOf="@+id/fl_catalog"
            app:layout_constraintTop_toTopOf="@+id/fl_catalog">
            <ImageView
                android:id="@+id/iv_collect"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/read_icon_collection_none"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_collect_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                style="@style/caption_medium"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/fl_like"
            android:background="@drawable/bg_button_secondary_normal_r4"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toStartOf="@+id/fl_share"
            app:layout_constraintStart_toEndOf="@+id/fl_collection"
            app:layout_constraintTop_toTopOf="@+id/fl_collection">
            <ImageView
                android:id="@+id/iv_like"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/read_icon_like_none"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_like_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                style="@style/caption_medium"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/fl_share"
            android:background="@drawable/bg_button_secondary_normal_r4"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="2dp"
            app:layout_constraintEnd_toStartOf="@+id/fl_setting"
            app:layout_constraintStart_toEndOf="@+id/fl_like"
            app:layout_constraintTop_toTopOf="@+id/fl_like">
            <ImageView
                android:id="@+id/iv_share"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/read_icon_share"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/texticon_primary"
                android:id="@+id/tv_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/description_episode_share"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                app:autoSizeMaxTextSize="@dimen/fontSize_12"
                app:autoSizeMinTextSize="5sp"
                app:autoSizeStepGranularity="1px"
                app:autoSizeTextType="uniform"
                style="@style/caption_medium"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/fl_setting"
            android:background="@drawable/bg_button_secondary_normal_r4"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/fl_share"
            app:layout_constraintTop_toTopOf="@+id/fl_share">
            <ImageView
                android:id="@+id/iv_setting"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_setting_white"/>
        </FrameLayout>
        <View
            android:id="@+id/bottom_view"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            app:layout_constraintTop_toBottomOf="@+id/fl_catalog"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
