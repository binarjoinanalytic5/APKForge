<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_hall_grid_type_layout_new_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="match_parent"
        android:layout_height="144dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/v_book_poster_image_style"/>
    <ViewStub
        android:id="@+id/vs_grid_series_cover_view"
        android:visibility="gone"
        android:layout="@layout/view_stub_grid_series_combine_cover"
        android:inflatedId="@+id/grid_series_cover_view"
        android:layout_width="0dp"
        android:layout_height="144dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"/>
    <com.newleaf.app.android.victor.view.BookMarkView
        android:id="@+id/bookMarkView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
        style="@style/v_book_mark_style"/>
    <View
        android:id="@+id/play_count_background"
        android:background="@drawable/bg_item_grid_type_layout_bottom_mask"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_white90"
        android:ellipsize="end"
        android:id="@+id/tv_other"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/play_count_background"
        app:layout_constraintEnd_toStartOf="@+id/tv_play_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/play_count_background"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:id="@+id/tv_play_count"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:includeFontPadding="false"
        android:drawableStart="@drawable/icon_play_count"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_count_background"
        app:layout_constraintEnd_toEndOf="@+id/play_count_background"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/cl_play_count_view"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="play_count_background,tv_other,tv_play_count"/>
    <FrameLayout
        android:id="@+id/cl_continue_watch"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toEndOf="@+id/iv_book_poster"
        app:layout_constraintStart_toStartOf="@+id/iv_book_poster">
        <TextView
            android:textSize="10sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:layout_gravity="center"
            android:id="@+id/tv_continue_watch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_grid_continue"
            android:includeFontPadding="false"
            android:drawablePadding="1dp"
            android:drawableStart="@drawable/icon_play_count"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fl_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="54dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_book_poster">
        <TextView
            android:textColor="@color/texticon_primary"
            android:ellipsize="end"
            android:id="@+id/tv_book_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/body_medium"/>
        <TextView
            android:textColor="@color/texticon_tertiary"
            android:ellipsize="end"
            android:id="@+id/tv_tag"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_book_name"
            style="@style/footnote_regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
