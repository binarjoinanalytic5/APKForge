<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/activity_landing_page_layout_0"
    android:background="@color/color_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@drawable/bg_00000000_90_ff000000"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="56dp"/>
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="54dp"
        android:src="@drawable/icon_close_24"
        android:contentDescription="@string/description_close"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/color_white90"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_toStartOf="@+id/iv_back"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_white90"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_below="@+id/tv_title"
        android:layout_marginStart="16dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycle_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="11dp"
        android:layout_marginRight="11dp"
        android:layout_below="@+id/tv_desc"
        android:translationZ="-5dp"
        android:layout_marginHorizontal="11dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/view_bg"
            android:background="#ff130000"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"/>
        <View
            android:background="@drawable/bg_130000_b3130000"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_above="@+id/view_bg"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_white90"
            android:gravity="center"
            android:id="@+id/tv_choose"
            android:background="@drawable/bg_ff3d5d_corner_6"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/help_me_choose"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="16dp"/>
    </RelativeLayout>
</RelativeLayout>
