<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_playing_detail_des_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.view.RoundImageView
        android:id="@+id/iv_book_poster"
        android:layout_width="60dp"
        android:layout_height="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="4dp"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="4sp"
        android:autoSizeMaxTextSize="20sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_series_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_book_poster"
        app:layout_constraintTop_toTopOf="@+id/iv_book_poster"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/title1_bold"/>
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_series_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_book_poster"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_book_poster"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/footnote_regular"/>
    <FrameLayout
        android:id="@+id/fr_hot"
        android:background="@drawable/bg_1affffff_corner4"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_book_poster">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_hot"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_ffffff_alpha_90"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_hot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="0dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="20dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/icon_arrow_right_alpha50"/>
    </FrameLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff_alpha_90"
        android:gravity="center_vertical"
        android:id="@+id/tv_des_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/introduction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fr_hot"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc_tags"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_des_title"/>
    <com.newleaf.app.android.victor.view.ExpandTextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_70"
        android:id="@+id/tv_des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:btnName="@string/more"
        app:canCloseExpend="true"
        app:canCollapsedClickable="true"
        app:collapsedMaxLine="3"
        app:expendMaxLine="1000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rc_tags"
        app:moreColor="#e6ffffff"
        app:showMore="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_90"
        android:id="@+id/tv_collapse"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/collapse"
        app:layout_constraintEnd_toEndOf="@+id/tv_des"
        app:layout_constraintTop_toBottomOf="@+id/tv_des"/>
    <com.newleaf.app.android.victor.view.KoLevelTagView
        android:id="@+id/view_ko_level_tag"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_collapse"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc_casts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_ko_level_tag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
