<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_delete_account_vip_0"
    android:background="@drawable/bg_delete_account_vip"
    android:layout_width="match_parent"
    android:layout_height="134dp">
    <ImageView
        android:id="@+id/iv_diamond"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/icon_dark_gold_diamond"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_vip_type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_vip_type"/>
    <TextView
        android:textColor="#fffff5da"
        android:ellipsize="end"
        android:id="@+id/tv_vip_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_valid_time"
        app:layout_constraintEnd_toStartOf="@+id/iv_tv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_diamond"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/body_bold"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#fffae7bf"
        android:id="@+id/tv_valid_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/v_vip_valid_title_none"
        app:layout_constraintBottom_toTopOf="@+id/tv_vip_time"
        app:layout_constraintEnd_toEndOf="@+id/tv_vip_time"
        app:layout_constraintStart_toStartOf="@+id/tv_vip_time"
        app:layout_constraintTop_toBottomOf="@+id/tv_vip_type"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#fffae7bf"
        android:id="@+id/tv_vip_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_tv"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_valid_time"/>
    <ImageView
        android:id="@+id/iv_tv"
        android:layout_width="88dp"
        android:layout_height="80dp"
        android:src="@drawable/icon_dark_gold_tv"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
