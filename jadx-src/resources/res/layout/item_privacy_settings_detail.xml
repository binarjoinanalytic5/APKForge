<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_privacy_settings_detail_0"
    android:background="@drawable/bg_backgrounds_background_2_r4"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginHorizontal="16dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_primary"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/switch_auto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/body_regular"/>
    <com.newleaf.app.android.victor.view.SwitchButton
        android:id="@+id/switch_auto"
        android:layout_width="36dp"
        android:layout_height="20dp"
        app:check_color="@color/button_brand_normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:switchColor="@color/texticon_fixed_primary"
        app:uncheck_color="#3dffffff"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/texticon_tertiary"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.5dp"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/footnote_regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
