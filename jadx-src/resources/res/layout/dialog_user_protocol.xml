<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:tag="layout/dialog_user_protocol_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:background="@drawable/bg_common_dialog"
        android:paddingBottom="18dp"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/img_top_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/bg_dialog_top_corner6"
            android:scaleType="fitStart"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="50dp"
            android:layout_marginRight="18dp"
            android:text="@string/user_protocol"
            android:maxLines="2"
            android:layout_marginHorizontal="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.newleaf.app.android.victor.view.MaxDialogHeightNestedScrollView
            android:scrollbarThumbVertical="@drawable/novel_scroll_bar_thumb"
            android:id="@+id/ns_content"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="18.5dp"
            android:overScrollMode="never"
            android:layout_marginHorizontal="18.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffffff_alpha_50"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"/>
        </com.newleaf.app.android.victor.view.MaxDialogHeightNestedScrollView>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/tv_agree_btn"
            android:background="@drawable/bg_ffffff_alpha20_border_corner4"
            android:layout_width="196dp"
            android:layout_height="38dp"
            android:layout_marginTop="13dp"
            android:text="@string/agree"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ns_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_ffffff_alpha_50"
            android:id="@+id/tv_read_it_later"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/read_it_later"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_agree_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/icon_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_user_protocol"
        android:elevation="0.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
