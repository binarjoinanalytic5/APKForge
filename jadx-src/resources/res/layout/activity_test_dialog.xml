<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_test_dialog_0"
    android:background="@color/profile_common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title"
        layout="@layout/include_title_bar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/rg_image_process_quality"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <RadioGroup
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/rg_image_process_quality"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <RadioButton
            android:textSize="12sp"
            android:textColor="@color/texticon_primary"
            android:id="@+id/rb_image_process_quality_80"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:checked="true"
            android:text="封面图80%质量压缩"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <RadioButton
            android:textSize="12sp"
            android:textColor="@color/texticon_primary"
            android:id="@+id/rb_image_process_quality_90"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="90%质量压缩"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <RadioButton
            android:textSize="12sp"
            android:textColor="@color/texticon_primary"
            android:id="@+id/rb_image_process_quality_original"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="原图不压缩质量"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
    </RadioGroup>
    <Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fc_web_checkin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
