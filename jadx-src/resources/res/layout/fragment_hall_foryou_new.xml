<?xml version="1.0" encoding="utf-8"?>
<com.newleaf.app.android.victor.view.refresh.VictorRefreshLayoutV3 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh_view"
    android:tag="layout/fragment_hall_foryou_new_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/space"
            layout="@layout/include_statusbar_space"/>
        <View
            android:id="@+id/title_view"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/smart_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.newleaf.app.android.victor.hall.foryou.view.RecyclerViewAtForYou
                android:id="@+id/rv_list"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>
        <ImageView
            android:id="@+id/img_bg"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:src="@drawable/shade_bg"
            android:scaleType="fitXY"
            android:elevation="0.5dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_top_mask"
            android:background="@drawable/hall_refresh_shade_gradient_bg"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:alpha="0"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_loading_view"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:alpha="0"
            android:elevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_view"
            app:lottie_fileName="loading_v24.json"/>
        <ViewStub
            android:id="@+id/view_stub_collect_guide"
            android:visibility="gone"
            android:layout="@layout/view_stub_item_video_collect_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="350dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.newleaf.app.android.victor.view.floatview.WatchTaskFloatContainer
            android:id="@+id/view_watch_float"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:location="foryou"/>
        <com.newleaf.app.android.victor.view.LoadFailView
            android:id="@+id/load_fail_view"
            android:background="@color/color_black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="0.5dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.newleaf.app.android.victor.view.refresh.VictorRefreshLayoutV3>
