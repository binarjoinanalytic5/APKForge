<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_app_channel_layout_0"
    android:background="@color/profile_common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_head_view"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_head_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_head_gradient"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/view_gradient_mask"
        android:background="@drawable/mask_gradient_app_channel_shape"
        android:layout_width="match_parent"
        android:layout_height="228dp"
        android:layout_marginBottom="55dp"
        app:layout_constraintBottom_toBottomOf="@+id/cl_head_view"/>
    <View
        android:id="@+id/view_black_mask"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_gradient_mask"/>
    <com.newleaf.app.android.victor.view.ObservableScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="30dp">
            <View
                android:id="@+id/view_space"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="263dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_app_logo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_space"/>
            <TextView
                android:textSize="21sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:id="@+id/tv_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@+id/iv_app_logo"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center"
                android:id="@+id/tv_open_now"
                android:background="@drawable/bg_app_task_download_button_selector"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="33dp"
                android:layout_marginTop="25dp"
                android:layout_marginRight="33dp"
                android:text="@string/app_open_now"
                android:layout_marginHorizontal="33dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_app_name"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_reward_view"
                android:background="@drawable/bg_gradient_363636_222222_angle90_shape"
                android:paddingBottom="17dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="25dp"
                android:layout_marginRight="18dp"
                android:layout_marginHorizontal="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_app_name">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_reward_view_title"
                    android:background="@drawable/bg_top_corners_6_solid_222222_shape"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="19sp"
                        android:textColor="@color/color_white80"
                        android:id="@+id/tv_rewards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/app_rewards"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/iv_bonus_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_new_coin_24"
                        android:layout_marginStart="12dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_rewards"
                        app:layout_constraintStart_toEndOf="@+id/tv_rewards"
                        app:layout_constraintTop_toTopOf="@+id/tv_rewards"/>
                    <TextView
                        android:textSize="19sp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_total_bonus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_rewards"
                        app:layout_constraintStart_toEndOf="@+id/iv_bonus_icon"/>
                    <ImageView
                        android:id="@+id/iv_bonus_question"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_question_white"
                        android:contentDescription="@string/description_rule"
                        android:layout_marginStart="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_rewards"
                        app:layout_constraintStart_toEndOf="@+id/tv_total_bonus"
                        app:layout_constraintTop_toTopOf="@+id/tv_rewards"/>
                    <Space
                        android:id="@+id/question_guide_line"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        app:layout_constraintTop_toBottomOf="@+id/iv_bonus_question"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageView
                    android:id="@+id/iv_task_download"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="66dp"
                    android:src="@drawable/icon_app_task_download"
                    app:layout_constraintEnd_toEndOf="@+id/tv_download_text"
                    app:layout_constraintStart_toStartOf="@+id/tv_download_text"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_ffffff_alpha_92"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_download_text"
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/download_app_from_reelshort"
                    android:maxLines="2"
                    android:layout_marginStart="15dp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_read_text"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_task_download"/>
                <ImageView
                    android:id="@+id/iv_task_read"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/icon_app_task_read"
                    app:layout_constraintEnd_toEndOf="@+id/tv_read_text"
                    app:layout_constraintStart_toStartOf="@+id/tv_read_text"
                    app:layout_constraintTop_toTopOf="@+id/iv_task_download"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_ffffff_alpha_92"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_read_text"
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="2"
                    app:layout_constraintEnd_toStartOf="@+id/tv_claim_text"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tv_download_text"
                    app:layout_constraintTop_toBottomOf="@+id/iv_task_read"/>
                <ImageView
                    android:id="@+id/iv_task_claim"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/icon_app_task_claim"
                    app:layout_constraintEnd_toEndOf="@+id/tv_claim_text"
                    app:layout_constraintStart_toStartOf="@+id/tv_claim_text"
                    app:layout_constraintTop_toTopOf="@+id/iv_task_read"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/color_ffffff_alpha_92"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/tv_claim_text"
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/claim_the_bonus"
                    android:maxLines="2"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tv_read_text"
                    app:layout_constraintTop_toBottomOf="@+id/iv_task_claim"/>
                <View
                    android:background="@color/color_white20"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_task_download"
                    app:layout_constraintEnd_toStartOf="@+id/iv_task_read"
                    app:layout_constraintStart_toEndOf="@+id/iv_task_download"
                    app:layout_constraintTop_toTopOf="@+id/iv_task_download"/>
                <View
                    android:background="@color/color_white20"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_task_download"
                    app:layout_constraintEnd_toStartOf="@+id/iv_task_claim"
                    app:layout_constraintStart_toEndOf="@+id/iv_task_read"
                    app:layout_constraintTop_toTopOf="@+id/iv_task_download"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_claim_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginHorizontal="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_download_text"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_white"
                    android:gravity="center"
                    android:id="@+id/tv_task_action"
                    android:background="@drawable/bg_app_task_download_button_selector"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginHorizontal="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/rv_claim_calendar"/>
                <ProgressBar
                    android:id="@+id/pb_claim_loading"
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:indeterminateTint="@color/white"
                    android:indeterminateTintMode="src_atop"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_task_action"
                    app:layout_constraintEnd_toEndOf="@+id/tv_task_action"
                    app:layout_constraintStart_toStartOf="@+id/tv_task_action"
                    app:layout_constraintTop_toTopOf="@+id/tv_task_action"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="cl_reward_view,tv_open_now"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:id="@+id/tv_app_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="25dp"
                android:layout_marginRight="18dp"
                android:layout_marginHorizontal="18dp"
                app:layout_constraintTop_toBottomOf="@+id/barrier"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_app_desc_img"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginStart="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_app_desc"/>
            <TextView
                android:textSize="19sp"
                android:textColor="@color/color_e7e7e7_alpha92"
                android:ellipsize="end"
                android:id="@+id/tv_more_mobile_game"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/more_apps_and_game"
                android:maxLines="1"
                android:layout_marginStart="18dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_app_desc_img"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_more_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_more_mobile_game"/>
            <TextView
                android:textSize="19sp"
                android:textColor="@color/color_e7e7e7_alpha92"
                android:ellipsize="end"
                android:id="@+id/tv_more_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/app_more_detail"
                android:maxLines="1"
                android:layout_marginStart="18dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_more_game"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:gravity="center_vertical"
                android:id="@+id/tv_category_name"
                android:layout_width="wrap_content"
                android:layout_height="43dp"
                android:layout_marginTop="7dp"
                android:text="@string/app_category"
                android:layout_marginStart="18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_more_detail"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:id="@+id/tv_category_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_category_name"
                app:layout_constraintEnd_toEndOf="parent"/>
            <View
                android:background="@color/color_ffffff_alpha_8"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_category_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:gravity="center_vertical"
                android:id="@+id/tv_rating_name"
                android:layout_width="wrap_content"
                android:layout_height="43dp"
                android:text="@string/app_age_rating"
                app:layout_constraintStart_toStartOf="@+id/tv_category_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_category_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:id="@+id/tv_rating_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_rating_name"
                app:layout_constraintEnd_toEndOf="@+id/tv_category_value"/>
            <View
                android:background="@color/color_ffffff_alpha_8"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_rating_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:gravity="center_vertical"
                android:id="@+id/tv_languages_name"
                android:layout_width="wrap_content"
                android:layout_height="43dp"
                android:text="@string/app_languages"
                app:layout_constraintStart_toStartOf="@+id/tv_category_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_rating_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:id="@+id/tv_languages_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_languages_name"
                app:layout_constraintEnd_toEndOf="@+id/tv_category_value"/>
            <View
                android:background="@color/color_ffffff_alpha_8"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_languages_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:gravity="center_vertical"
                android:id="@+id/tv_size_name"
                android:layout_width="wrap_content"
                android:layout_height="43dp"
                android:text="@string/app_size"
                app:layout_constraintStart_toStartOf="@+id/tv_category_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_languages_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:id="@+id/tv_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_size_name"
                app:layout_constraintEnd_toEndOf="@+id/tv_category_value"/>
            <View
                android:background="@color/color_ffffff_alpha_8"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_size_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:gravity="center_vertical"
                android:id="@+id/tv_internet_name"
                android:layout_width="wrap_content"
                android:layout_height="43dp"
                android:text="@string/app_requires_internet"
                app:layout_constraintStart_toStartOf="@+id/tv_category_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_size_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:id="@+id/tv_internet_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_internet_name"
                app:layout_constraintEnd_toEndOf="@+id/tv_category_value"/>
            <View
                android:background="@color/color_ffffff_alpha_8"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_internet_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:gravity="center_vertical"
                android:id="@+id/tv_seller_name"
                android:layout_width="wrap_content"
                android:layout_height="43dp"
                android:text="@string/app_developer"
                app:layout_constraintStart_toStartOf="@+id/tv_category_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_internet_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffeff6_alpha70"
                android:id="@+id/tv_seller_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_seller_name"
                app:layout_constraintEnd_toEndOf="@+id/tv_category_value"/>
            <View
                android:background="@color/color_ffffff_alpha_8"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_seller_name"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.newleaf.app.android.victor.view.ObservableScrollView>
    <com.newleaf.app.android.victor.view.LoadFailView
        android:id="@+id/load_fail_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:load_fail_view_bg_color="@color/black"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_title_view"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/space"
            layout="@layout/include_statusbar_space"/>
        <View
            android:id="@+id/title_space"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_back"
            app:layout_constraintTop_toTopOf="@+id/space"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_back"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_return"
            android:contentDescription="@string/description_close"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.newleaf.app.android.victor.appchannel.AppDescImageDetailView
        android:id="@+id/detail_image_desc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
