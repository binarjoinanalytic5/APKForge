<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_white"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_tips"
        android:background="@drawable/bg_dailog_wait_free_rulse"
        android:padding="10dp"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_arrow"/>
    <ImageView
        android:id="@+id/img_arrow"
        android:layout_width="13dp"
        android:layout_height="7dp"
        android:src="@drawable/icon_dialog_wait_free_arrow"
        android:rotation="180"
        app:layout_constraintEnd_toEndOf="@+id/tv_tips"
        app:layout_constraintStart_toStartOf="@+id/tv_tips"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
