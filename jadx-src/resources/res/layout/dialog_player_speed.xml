<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_player_speed_0"
    android:background="@drawable/bg_141414_top_corner_16"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/speed"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/fl_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/icon_close_more"
        android:contentDescription="@string/description_close"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_bg"
        android:background="@drawable/bg_292929_corner_8"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_close"/>
    <com.newleaf.app.android.victor.player.view.SpeedRateView
        android:id="@+id/speed_rate"
        android:layout_width="wrap_content"
        android:layout_height="110dp"
        android:contentDescription="@string/speed"
        app:circleRadius="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_bg"
        app:lineColor="#ff7f7f7f"
        app:standerSize="16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
