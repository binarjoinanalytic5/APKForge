<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_content"
    android:tag="layout/dialog_pay_retention_layout_0"
    android:background="@drawable/bg_backgrounds_background_3_corner8"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textColor="@color/color_f7d8ac"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/title2_bold"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_offer_container"
        android:background="@drawable/bg_pay_retention_offer_card"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_offer_item_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_offer_icon_1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitCenter"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/color_f7d8ac"
                android:gravity="center"
                android:id="@+id/tv_offer_value_1"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                style="@style/title2_bold"/>
            <TextView
                android:textColor="@color/color_b3f7d8ac"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_offer_desc_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                style="@style/footnote_regular"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/color_f7d8ac"
            android:gravity="center"
            android:id="@+id/tv_offer_plus"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            style="@style/mediumtitle_bold"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_offer_item_2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/iv_offer_icon_2"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitCenter"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/color_f7d8ac"
                android:gravity="center"
                android:id="@+id/tv_offer_value_2"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                style="@style/title2_bold"/>
            <TextView
                android:textColor="@color/color_b3f7d8ac"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_offer_desc_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                style="@style/footnote_regular"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ll_fallback"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:layout_marginTop="24dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_fallback_card_bottom"
            android:background="@drawable/bg_pay_retention_offer_card"
            android:padding="16dp"
            android:layout_width="275dp"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp">
            <ImageView
                android:id="@+id/iv_fallback_avatar_bottom"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <TextView
                android:textColor="@color/color_b3f7d8ac"
                android:ellipsize="end"
                android:id="@+id/tv_fallback_bottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                style="@style/body_regular"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_fallback_card_middle"
            android:background="@drawable/bg_pay_retention_offer_card"
            android:padding="16dp"
            android:layout_width="275dp"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp">
            <ImageView
                android:id="@+id/iv_fallback_avatar_middle"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <TextView
                android:textColor="@color/color_b3f7d8ac"
                android:ellipsize="end"
                android:id="@+id/tv_fallback_middle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                style="@style/body_regular"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_fallback_card_top"
            android:background="@drawable/bg_pay_retention_offer_card"
            android:padding="16dp"
            android:layout_width="275dp"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp">
            <ImageView
                android:id="@+id/iv_fallback_avatar_top"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <TextView
                android:textColor="@color/color_b3f7d8ac"
                android:ellipsize="end"
                android:id="@+id/tv_fallback_top"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                style="@style/body_regular"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_fallback_card_incoming"
            android:background="@drawable/bg_pay_retention_offer_card"
            android:padding="16dp"
            android:layout_width="275dp"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp">
            <ImageView
                android:id="@+id/iv_fallback_avatar_incoming"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <TextView
                android:textColor="@color/color_b3f7d8ac"
                android:ellipsize="end"
                android:id="@+id/tv_fallback_incoming"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                style="@style/body_regular"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textColor="@color/texticon_fixed_primary"
        android:gravity="center"
        android:id="@+id/tv_continue"
        android:background="@drawable/bg_button_brand_normal_r4"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="@string/pay_retention_continue_pay"
        style="@style/body_bold"/>
    <TextView
        android:textColor="@color/texticon_primary"
        android:gravity="center"
        android:id="@+id/tv_exit"
        android:background="@drawable/bg_button_secondary_normal_r4"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/pay_retention_exit"
        style="@style/body_bold"/>
</LinearLayout>
