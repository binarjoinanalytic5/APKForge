<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_view_all"
    android:tag="layout/item_same_cast_view_all_0"
    android:background="@drawable/bg_ffffff_alpha_10_corner4"
    android:layout_width="80dp"
    android:layout_height="148dp">
    <TextView
        android:textColor="@color/texticon_tertiary"
        android:gravity="center"
        android:id="@+id/tv_view_all"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:text="@string/view_all"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/iv_view_all"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/footnote_regular"/>
    <ImageView
        android:id="@+id/iv_view_all"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/icon_right_direction"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_view_all"/>
</androidx.constraintlayout.widget.ConstraintLayout>
