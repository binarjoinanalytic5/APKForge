<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_common_coupons_layout_0"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_sub_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="360dp"
        app:layout_constraintWidth_min="300dp">
        <View
            android:background="@drawable/common_coupon_dialog_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/cl_sub_view"
            app:layout_constraintEnd_toEndOf="@+id/cl_content1"
            app:layout_constraintStart_toStartOf="@+id/cl_content1"
            app:layout_constraintTop_toTopOf="@+id/cl_content1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_content1"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/color_white"
                android:gravity="center_horizontal"
                android:id="@+id/tv_earned_coupons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:text="@string/text_earned_num_coupon"
                android:lineSpacingExtra="1dp"
                android:lineSpacingMultiplier="0.8"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:background="@color/color_ffffff_alpha_20"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="32dp"
                android:layout_marginHorizontal="32dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_earned_coupons"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_white90"
                android:gravity="center_horizontal"
                android:id="@+id/tv_coupons_use_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="27dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="27dp"
                android:layout_marginHorizontal="27dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_earned_coupons"/>
            <com.newleaf.app.android.victor.view.RoundImageView
                android:id="@+id/iv_episode_cover"
                android:layout_width="149dp"
                android:layout_height="198dp"
                android:layout_marginTop="20dp"
                android:scaleType="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_coupons_use_desc"/>
            <View
                android:id="@+id/view_border_color"
                android:background="@drawable/icon_coupon_border_img"
                android:layout_width="173dp"
                android:layout_height="223dp"
                android:layout_marginTop="-10dp"
                android:layout_marginStart="-12dp"
                app:layout_constraintStart_toStartOf="@+id/iv_episode_cover"
                app:layout_constraintTop_toTopOf="@+id/iv_episode_cover"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/black"
                android:gravity="center_horizontal"
                android:id="@+id/tv_coupons_use_time"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="30dp"
                android:text="@string/subscribe_obtain_coupon_use_time"
                android:layout_marginHorizontal="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_episode_cover"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_content2"
            android:layout_width="0dp"
            android:layout_height="81dp"
            app:layout_constraintEnd_toEndOf="@+id/cl_content1"
            app:layout_constraintStart_toStartOf="@+id/cl_content1"
            app:layout_constraintTop_toBottomOf="@+id/cl_content1">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_claim_coupon"
                android:background="@drawable/bg_e83a57_corner_5"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="35dp"
                android:layout_marginRight="35dp"
                android:text="@string/text_claim_coupon_tomorrow"
                android:layout_marginHorizontal="35dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/svga_fireworks"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginLeft="-20dp"
        android:layout_marginRight="-20dp"
        android:src="@drawable/bg2_trailer_subscribe_obtain_coupon"
        android:layout_marginHorizontal="-20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_loop="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:src="@drawable/icon_dialog_close_32"
        android:contentDescription="@string/description_close"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="@+id/cl_sub_view"
        app:layout_constraintStart_toStartOf="@+id/cl_sub_view"
        app:layout_constraintTop_toBottomOf="@+id/cl_sub_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
