<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_layout_balance_and_sku_style3_0"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.newleaf.app.android.victor.player.newunlock.SkuListViewStyle3
        android:id="@+id/iap_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.newleaf.app.android.victor.view.roundview.RoundConstraintLayout
        android:id="@+id/cl_view_all"
        android:background="@drawable/bg_paywall_style3_more_plan"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iap_view"
        app:rRadius="4dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/texticon_tertiary"
            android:id="@+id/tv_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/img_view_all_arrow"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/footnote_regular"/>
        <ImageView
            android:id="@+id/img_view_all_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_arrow_right_alph50"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_view_all"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_view_all"
            app:layout_constraintTop_toTopOf="@+id/tv_view_all"/>
    </com.newleaf.app.android.victor.view.roundview.RoundConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
