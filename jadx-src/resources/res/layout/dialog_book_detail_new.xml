<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cl_main"
    android:tag="layout/dialog_book_detail_new_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_coin_package_discount"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_coin_package_discount"
        android:layout_marginStart="18dp"
        android:elevation="5dp"
        app:layout_constraintStart_toStartOf="@+id/ll_main"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_main"
        android:background="@drawable/bg_book_detail_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:src="@drawable/icon_close_black"
            android:contentDescription="@string/description_close"
            android:layout_marginEnd="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/line1"
            android:background="@drawable/bottom_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.newleaf.app.android.victor.view.MaxHeightNestedScrollView
            android:id="@+id/ll_scroll"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:elevation="0.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_close">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/scroll_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.newleaf.app.android.victor.view.RoundImageView
                        android:id="@+id/img_poster"
                        android:layout_width="90dp"
                        android:layout_height="120dp"
                        android:layout_marginStart="18dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:radius="6dp"/>
                    <TextView
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_white"
                        android:ellipsize="end"
                        android:id="@+id/tv_book_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="18dp"
                        android:elevation="0.5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/img_poster"
                        app:layout_constraintTop_toTopOf="@+id/img_poster"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/color_ffffff_alpha_50"
                        android:ellipsize="end"
                        android:id="@+id/tv_tag"
                        android:background="#33ffffff"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_theme"
                        app:layout_constraintStart_toStartOf="@+id/tv_book_name"
                        app:layout_constraintTop_toTopOf="@+id/tv_theme"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_ffffff_alpha_50"
                        android:ellipsize="end"
                        android:id="@+id/tv_theme"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        app:layout_constraintEnd_toEndOf="@+id/tv_book_name"
                        app:layout_constraintStart_toEndOf="@+id/tv_tag"
                        app:layout_constraintTop_toBottomOf="@+id/tv_book_name"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_white"
                        android:ellipsize="end"
                        android:id="@+id/tv_book_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:elevation="0.5dp"
                        app:layout_constraintStart_toStartOf="@+id/tv_book_name"
                        app:layout_constraintTop_toBottomOf="@+id/tv_theme"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_ffffff_alpha_50"
                        android:ellipsize="end"
                        android:id="@+id/tv_chapter_num"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_marginStart="2dp"
                        android:elevation="0.5dp"
                        app:layout_constraintEnd_toEndOf="@+id/tv_book_name"
                        app:layout_constraintStart_toEndOf="@+id/tv_book_status"
                        app:layout_constraintTop_toTopOf="@+id/tv_book_status"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_trailer_online_state"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        app:layout_constraintEnd_toEndOf="@+id/tv_book_name"
                        app:layout_constraintStart_toStartOf="@+id/tv_book_name"
                        app:layout_constraintTop_toBottomOf="@+id/tv_theme">
                        <View
                            android:background="@drawable/icon_coming_soon_bg"
                            android:layout_width="91dp"
                            android:layout_height="18dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#ffbdbdbd"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_trailer_coming_soon"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:text="@string/book_detail_coming_soon"
                            android:includeFontPadding="false"
                            android:paddingStart="2dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/color_white"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_trailer_online_time"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:includeFontPadding="false"
                            android:paddingStart="4dp"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tv_trailer_coming_soon"
                            app:layout_constraintStart_toEndOf="@+id/tv_trailer_coming_soon"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_play"
                        android:background="@drawable/bg_e83a57_corner_6"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="18dp"
                        android:elevation="0.5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/img_poster"
                        app:layout_constraintTop_toBottomOf="@+id/img_poster">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/icon_book_detail_play"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_white"
                            android:id="@+id/tv_play"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/play"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_trailer_reminder"
                        android:layout_width="88dp"
                        android:layout_height="62dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginStart="18dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ll_play">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/img_reminder"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/icon_book_detail_notification"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/color_ffffff_alpha_50"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/tv_reminder_text"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/remind_me"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_my_list"
                        android:layout_width="88dp"
                        android:layout_height="62dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginStart="22dp"
                        app:layout_constraintStart_toEndOf="@+id/ll_trailer_reminder"
                        app:layout_constraintTop_toBottomOf="@+id/ll_play">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/img_collect"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/icon_item_video_collect_empty"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/color_ffffff_alpha_50"
                            android:layout_gravity="center_horizontal"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/table_library"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_share"
                        android:layout_width="88dp"
                        android:layout_height="62dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginStart="22dp"
                        app:layout_constraintStart_toEndOf="@+id/ll_my_list"
                        app:layout_constraintTop_toBottomOf="@+id/ll_play">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/img_share"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/icon_video_share_black"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/color_ffffff_alpha_50"
                            android:layout_gravity="center_horizontal"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/description_episode_share"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <FrameLayout
                    android:id="@+id/view_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.newleaf.app.android.victor.view.ExpandTextView
                            android:textSize="13sp"
                            android:textColor="@color/color_ffffff_alpha_50"
                            android:id="@+id/tv_des"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp"
                            android:layout_marginBottom="18dp"
                            android:layout_marginHorizontal="18dp"
                            app:canCloseExpend="true"
                            app:canCollapsedClickable="true"
                            app:collapsedMaxLine="5"
                            app:expendMaxLine="1000"
                            app:moreColor="#b3ffffff"
                            app:showMore="true"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/color_e7e7e7"
                            android:id="@+id/tv_actor_text"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/book_detail_actor"
                            android:layout_marginStart="18dp"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_actor_list"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="145dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginStart="18dp"/>
                        <com.newleaf.app.android.victor.view.KoLevelTagView
                            android:id="@+id/view_ko_level_tag"
                            android:paddingBottom="20dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </com.newleaf.app.android.victor.view.MaxHeightNestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
