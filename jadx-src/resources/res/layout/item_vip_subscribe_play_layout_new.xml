<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/item_vip_subscribe_play_layout_new_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_vip"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/img_bg_icon"
            android:layout_width="172dp"
            android:layout_height="94dp"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:layout_toStartOf="@+id/fl_vip_btn">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ff401a06"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.95"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10sp"
                android:textColor="#b2401a06"
                android:ellipsize="end"
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="3"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.95"
                app:autoSizeMaxTextSize="10sp"
                app:autoSizeMinTextSize="5sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:id="@+id/fl_vip_btn"
            android:layout_width="84dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true">
            <com.newleaf.app.android.victor.view.PriceAnimTextView
                android:textColor="#ff401a06"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_vip_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:lineSpacingMultiplier="0.95"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="0.1dp"
                app:autoSizeTextType="uniform"
                app:priceAniDuration="1000"
                style="@style/title3_bold"/>
            <com.newleaf.app.android.victor.view.ObliqueLineTextView
                android:textSize="10sp"
                android:textColor="#b2401a06"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_underline_price"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:autoSizeMaxTextSize="10sp"
                app:autoSizeMinTextSize="5sp"
                app:autoSizeStepGranularity="0.1sp"
                app:autoSizeTextType="uniform"
                app:lineColor="#b2401a06"
                app:lineStyle="styleHorizontalCenter"
                app:lineWidth="1dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_mark"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="8dp">
            <com.newleaf.app.android.victor.view.CountDownText
                android:textSize="10sp"
                android:textColor="@color/color_ffffff_alpha_90"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_count_down_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.95"
                app:autoSizeMaxTextSize="10sp"
                app:autoSizeMinTextSize="4sp"
                app:autoSizeStepGranularity="0.1sp"
                app:autoSizeTextType="uniform"/>
            <View
                android:id="@+id/v_dividing_line"
                android:background="#fffceaea"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:alpha="0.3"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/color_ffffff_alpha_90"
                android:gravity="center_vertical"
                android:id="@+id/tv_text_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.95"/>
        </LinearLayout>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_benefits"
        android:background="@drawable/bg_vip_expire_time_card_style1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        app:layout_constraintTop_toBottomOf="@+id/rl_vip">
        <com.newleaf.app.android.victor.view.NoTouchRecyclerView
            android:id="@+id/rv_benefits_list"
            android:paddingTop="8dp"
            android:paddingBottom="3dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/view_shimmer"
        android:background="@drawable/img_vip_shimmer"
        android:visibility="gone"
        android:layout_width="236dp"
        android:layout_height="88dp"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
