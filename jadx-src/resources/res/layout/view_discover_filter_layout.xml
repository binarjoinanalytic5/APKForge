<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/view_discover_filter_layout_0"
    android:layout_width="match_parent"
    android:layout_height="23dp">
    <View
        android:id="@+id/v_filter"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="@+id/iv_filter"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/v_sort"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_sort"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_50"
        android:id="@+id/tv_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filter"
        android:paddingStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_filter"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_filter_gery"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_filter"
        app:layout_constraintStart_toEndOf="@+id/tv_filter"
        app:layout_constraintTop_toTopOf="@+id/tv_filter"
        app:lottie_fileName="v_filter_unselected.json"/>
    <View
        android:background="@color/color_ffffff_alpha_15"
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sort"
        app:layout_constraintEnd_toStartOf="@+id/tv_sort"
        app:layout_constraintTop_toTopOf="@+id/tv_sort"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_alpha_50"
        android:id="@+id/tv_sort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sort"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_sort"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_sort"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_sort_grey"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sort"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_sort"
        app:lottie_fileName="v_sort_lottie.json"/>
</androidx.constraintlayout.widget.ConstraintLayout>
