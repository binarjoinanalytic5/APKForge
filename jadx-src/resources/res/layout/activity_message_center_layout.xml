<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_message_center_layout_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/space"
        layout="@layout/include_statusbar_space"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_back"
        android:padding="10dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_back_white"
        android:layout_centerVertical="true"
        android:contentDescription="@string/description_back"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/tab_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tab_layout"/>
    <com.newleaf.app.android.victor.view.XSlidingTabLayout2
        android:id="@+id/tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space"
        app:tl_indicator_color="@color/color_ffffff_alpha_90"
        app:tl_indicator_corner_radius="2dp"
        app:tl_indicator_gravity="BOTTOM"
        app:tl_indicator_height="2dp"
        app:tl_indicator_margin_bottom="5dp"
        app:tl_indicator_style="NORMAL"
        app:tl_indicator_width="32dp"
        app:tl_tab_padding="12sp"
        app:tl_textBold="BOTH"
        app:tl_textSelectColor="@color/texticon_primary"
        app:tl_textUnselectColor="@color/texticon_tertiary"
        app:tl_text_select_size="16sp"
        app:tl_textsize="16sp"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPage2"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
