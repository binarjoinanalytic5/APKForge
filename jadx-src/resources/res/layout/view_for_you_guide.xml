<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/img_for_you_guide2"
        android:tag="layout/view_for_you_guide_0"
        android:layout_width="133dp"
        android:layout_height="133dp"
        android:layout_marginTop="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="v_swipe_guide.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/tv_for_you_guide_text1"
        android:tag="layout/view_for_you_guide_1"
        android:background="@drawable/icon_guide_up_arrow_text_bg"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:layout_width="195dp"
        android:layout_height="wrap_content"
        android:text="@string/for_you_guide_text1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_for_you_guide2"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/guide_group1"
        android:tag="layout/view_for_you_guide_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="img_for_you_guide2,tv_for_you_guide_text1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/tv_for_you_fast_player"
        android:tag="layout/view_for_you_guide_3"
        android:background="@drawable/bg_e51f1f1f_corner4"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/for_you_fast_player_text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.newleaf.app.android.victor.view.BezierOvalView
        android:id="@+id/bezier_for_you"
        android:tag="layout/view_for_you_guide_4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="58dp"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/guide_group2"
        android:tag="layout/view_for_you_guide_5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_for_you_fast_player,bezier_for_you"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_white"
        android:gravity="center"
        android:id="@+id/tv_for_you_guide_text2"
        android:tag="layout/view_for_you_guide_6"
        android:background="@drawable/icon_guide_right_arrow_text_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="233dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="160dp"
        android:text="@string/for_you_guide_text2"
        android:includeFontPadding="false"
        android:layout_marginEnd="80dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/img_video_catalog_guide_hand"
        android:tag="layout/view_for_you_guide_7"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="-30dp"
        android:layout_marginStart="-10dp"
        app:layout_constraintStart_toEndOf="@+id/tv_for_you_guide_text2"
        app:layout_constraintTop_toTopOf="@+id/tv_for_you_guide_text2"
        app:lottie_autoPlay="true"
        app:lottie_fileName="interact_player_guidelines.json"
        app:lottie_loop="true"/>
</merge>
