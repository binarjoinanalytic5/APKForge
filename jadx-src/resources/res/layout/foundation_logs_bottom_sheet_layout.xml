<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/logs_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/logs_card_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/logs_bottom_sheet_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Theme.Design.BottomSheetDialog">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        android:id="@+id/logs_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="SDK Logs"
                        android:layout_weight="1"
                        android:fontFamily="@font/bold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16sp"
                        android:gravity="center"
                        android:id="@+id/logs_search_button"
                        android:background="@drawable/shape_button_background"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="��︎"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/logs_tag_bg"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16sp"
                        android:gravity="center"
                        android:id="@+id/logs_reload_button"
                        android:background="@drawable/shape_button_background"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="��"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/logs_tag_bg"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16sp"
                        android:gravity="center"
                        android:id="@+id/logs_presentation_mode_button"
                        android:background="@drawable/shape_button_background"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="⬇"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/logs_tag_bg"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/logs_export_button"
                        android:background="@drawable/shape_button_background"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Export"
                        android:backgroundTint="@color/logs_primary"
                        android:paddingHorizontal="16dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <FrameLayout
                    android:id="@+id/logs_search_container"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/gray_900"
                        android:textColorHint="@color/gray_500"
                        android:id="@+id/logs_search_input"
                        android:background="@drawable/shape_button_background"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="Search logs..."
                        android:inputType="text"
                        android:backgroundTint="@color/logs_search_bg"
                        android:paddingHorizontal="12dp"
                        android:importantForAutofill="no"/>
                </FrameLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13sp"
                        android:textColor="@color/gray_900"
                        android:gravity="center"
                        android:id="@+id/logs_date_from"
                        android:background="@drawable/shape_button_background"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/logs_search_bg"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="13sp"
                        android:textColor="@color/gray_900"
                        android:gravity="center"
                        android:id="@+id/logs_date_to"
                        android:background="@drawable/shape_button_background"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/logs_search_bg"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textColor="@color/gray_900"
                        android:gravity="center"
                        android:id="@+id/logs_date_clear"
                        android:background="@drawable/shape_button_background"
                        android:visibility="gone"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="✕"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/logs_tag_bg"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <HorizontalScrollView
                    android:paddingBottom="8dp"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:id="@+id/logs_filter_tags_container"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"/>
                </HorizontalScrollView>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/logs_recycler_view"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="16dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="@color/gray_500"
                    android:gravity="center"
                    android:id="@+id/logs_empty_state"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="No logs found"
                    android:layout_weight="1"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
